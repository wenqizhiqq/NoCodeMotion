    <!-- 共享转换器 -->
    <views:AxisHeaderMultiConverter x:Key="AxisHeaderMulti"/>
    <views:SimIndexConverter x:Key="SimIndexConv"/>
    <views:BoolToZhConverter x:Key="BoolToZh"/>
    <views:StringFormatConverter x:Key="StringFormat"/>
    <views:FlowStatusLabelConverter x:Key="FlowStatusLabel"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="PointCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PointRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PointHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PointCellTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PointCellTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <DataTemplate x:Key="AxisCardTemplate">
        <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="8" Width="264">
            <StackPanel>
                <!-- 头部：轴名 + 使能/回原 状态（右对齐） -->
                <Grid Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="{StaticResource PointIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                            <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                                <Binding Path="AxisName"/><Binding Source=""/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="使能 "/>
                        <Run Text="{Binding Enabled, Converter={StaticResource BoolToZh}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text="  回原 "/>
                        <Run Text="{Binding Homed, Converter={StaticResource BoolToZh}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                </Grid>

                <!-- 选择轴 + 当前位置（同行，combo 占中间）位置） -->
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="选择轴" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Run Text="位置 "/>
                        <Run Text="{Binding CurrentPosition, Mode=OneWay, StringFormat={}{0}}"/>
                    </TextBlock>
                    <ComboBox ItemsSource="{x:Static svc:Catalog.AxisNames}"
                              SelectedItem="{Binding AxisName, Mode=TwoWay}"
                              Style="{DynamicResource CellComboStyle}"/>
                </DockPanel>

                <!-- 使能 / 回原 按钮 -->
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <Button Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Index}" Style="{DynamicResource TtPillBlueBtn}" Content="使能" Margin="0,0,2,0"/>
                    <Button Command="{Binding DataContext.HomeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Index}" Style="{DynamicResource TtPillGrayBtn}" Content="回原" Margin="2,0,0,0"/>
                </UniformGrid>

                <!-- 寸动：距离输入 + −/+ 同行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="寸动" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Height="26" Width="56" Margin="0,0,4,0">
                        <TextBox Text="{Binding InchStep, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentSoftBrush}" FocusVisualStyle="{x:Null}"/>
                    </Border>
                    <Button Command="{Binding DataContext.InchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Index, Converter={StaticResource StringFormat}, ConverterParameter='{}{0},-1'}" Style="{DynamicResource TtPillOrangeBtn}" Content="−" Width="46" Margin="0,0,4,0"/>
                    <Button Command="{Binding DataContext.InchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Index, Converter={StaticResource StringFormat}, ConverterParameter='{}{0},+1'}" Style="{DynamicResource TtPillBlueBtn}" Content="+" Width="46"/>
                </StackPanel>

                <!-- JOG：速度输入 + −/+ 同行（按住连续运动，松开停止） -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="JOG" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Height="26" Width="56" Margin="0,0,4,0">
                        <TextBox Text="{Binding JogStep, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentSoftBrush}" FocusVisualStyle="{x:Null}"/>
                    </Border>
                    <Button b:JogHoldBehavior.StartCommand="{Binding DataContext.JogStartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            b:JogHoldBehavior.StartParameter="{Binding Index, Converter={StaticResource StringFormat}, ConverterParameter='{}{0},-1'}"
                            b:JogHoldBehavior.StopCommand="{Binding DataContext.JogStopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Style="{DynamicResource TtPillOrangeBtn}" Content="−" Width="46" Margin="0,0,4,0" ToolTip="按住连续运动，松开停止"/>
                    <Button b:JogHoldBehavior.StartCommand="{Binding DataContext.JogStartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            b:JogHoldBehavior.StartParameter="{Binding Index, Converter={StaticResource StringFormat}, ConverterParameter='{}{0},+1'}"
                            b:JogHoldBehavior.StopCommand="{Binding DataContext.JogStopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Style="{DynamicResource TtPillBlueBtn}" Content="+" Width="46" ToolTip="按住连续运动，松开停止"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

