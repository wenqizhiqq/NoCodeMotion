<Window x:Class="NoCodeMotion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoCodeMotion"
        xmlns:views="clr-namespace:NoCodeMotion.Views"
        Title="NoCodeMotion · 无代码运动控制 · ◆温启志◆编写◇微信﹕187◆1936◇1399　※保留所有权利请勿删除◇​⁣​ "  
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        >
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Style="{StaticResource NavBarStyle}">
            <StackPanel Orientation="Horizontal" x:Name="NavPanel">
                <Button Tag="ProjectManager" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ProjectManagerIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconProjectManagerBrush}"/>
                        <TextBlock Text="项目管理" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Tag="AxisController" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ControllerIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconControllerBrush}"/>
                        <TextBlock Text="控制器" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Axis" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AxisIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconAxisBrush}"/>
                        <TextBlock Text="轴" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Io" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IoIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconIoBrush}"/>
                        <TextBlock Text="IO" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Cylinder" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CylinderIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconCylinderBrush}"/>
                        <TextBlock Text="气缸" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Point" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PointIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconPointBrush}"/>
                        <TextBlock Text="点位表" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Comm" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CommIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconCommBrush}"/>
                        <TextBlock Text="通讯" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Tray" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource TrayIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconTrayBrush}"/>
                        <TextBlock Text="料盘" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Camera" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CameraIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconCameraBrush}"/>
                        <TextBlock Text="相机" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Variable" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource VariableIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconVariableBrush}"/>
                        <TextBlock Text="变量" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Flow" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FlowIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconFlowBrush}"/>
                        <TextBlock Text="流程" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Engineer" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource EngineerIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconEngineerBrush}"/>
                        <TextBlock Text="工程师" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Operator" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource OperatorIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource NavIconOperatorBrush}"/>
                        <TextBlock Text="操作员" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="Manual" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" ToolTip="查看使用说明书">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InfoIcon}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}"/>
                        <TextBlock Text="说明书" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 页面内容区 -->
        <ContentControl Grid.Row="1" x:Name="PageHost"/>

        <!-- 底部状态栏 -->
        <views:StatusBarView Grid.Row="2"/>
 
    </Grid>
</Window>
