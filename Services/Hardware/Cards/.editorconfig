# 本目录（Services/Hardware/Cards）是从 WenQiZhiMotion / SMotorse 参考实现
# 移植进来的运动控制卡层。2026-11 已按本项目要求完成底层改造：
#   · 6 个接口 → 6 个抽象基类（Abstraction/），26 个卡族全部改为继承 + override；
#   · 公共成员统一 PascalCase、修正 Vitual/Offine/InPut/OutPut 等拼写；
#   · 参数、私有字段、局部变量按下述命名规则统一。
# Native/ 与各卡族 *SDK.cs 中的 P/Invoke 声明保持原样（EntryPoint 不能改）。
#
# 本文件只作用于 Services/Hardware/Cards/ 及其子目录（不设 root）。
[*.cs]

# ── 命名规范 ──
dotnet_naming_rule.parameters_camel.symbols = parameters
dotnet_naming_rule.parameters_camel.style = camel_case
dotnet_naming_rule.parameters_camel.severity = warning

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_rule.locals_camel.severity = warning

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.locals.applicable_kinds = local

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# ── 厂商代码遗留 ──
# CS0162 检测到无法访问的代码
dotnet_diagnostic.CS0162.severity = none
# CS0219 变量已赋值但从未使用
dotnet_diagnostic.CS0219.severity = none
# CS0168 变量已声明但从未使用
dotnet_diagnostic.CS0168.severity = none
# CS0414 字段已赋值但从未使用
dotnet_diagnostic.CS0414.severity = none
# CS0105 using 指令重复出现
dotnet_diagnostic.CS0105.severity = none
# CS8981 类型名仅含小写 ascii（厂商底层包装类名，如 sldmv / fn）
dotnet_diagnostic.CS8981.severity = none

# ── 分析器规则 ──
# CA2200 重新引发捕获到的异常会更改堆栈信息（厂商在各卡的错误分支里普遍如此写）
dotnet_diagnostic.CA2200.severity = none
