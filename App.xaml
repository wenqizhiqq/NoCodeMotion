<Application x:Class="NoCodeMotion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoCodeMotion"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;Component/Themes/SkinDefault.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== 调色板 ===================== -->
            <!-- ===================== Apple 风调色板 ===================== -->
            <Color x:Key="CAccent">#007AFF</Color>
            <Color x:Key="CAccentDark">#0066CC</Color>
            <Color x:Key="CAccentSoft">#EAF3FF</Color>
            <Color x:Key="CHover">#F2F2F7</Color>
            <Color x:Key="CHeader">#F7F7F9</Color>
            <Color x:Key="CCanvas">#F5F5F7</Color>
            <Color x:Key="CSurface">#FFFFFF</Color>
            <Color x:Key="CLine">#E5E5EA</Color>
            <Color x:Key="CText">#1D1D1F</Color>
            <Color x:Key="CText2">#6E6E73</Color>
            <Color x:Key="CTextMuted">#8E8E93</Color>
            <Color x:Key="CSuccess">#34C759</Color>
            <Color x:Key="CDanger">#FF3B30</Color>
            <Color x:Key="CWarning">#FF9500</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CAccent}"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource CAccentDark}"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource CAccentSoft}"/>
            <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource CHover}"/>
            <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource CHeader}"/>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CCanvas}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CSurface}"/>
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource CLine}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource CText}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource CText2}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource CTextMuted}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource CSuccess}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource CDanger}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource CWarning}"/>
            <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource CAccentSoft}"/>

            <!-- 柔和阴影（中性黑、更轻，贴近 Apple） -->
            <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="0" Direction="90" Opacity="0.08" Color="#000000"/>
            <DropShadowEffect x:Key="SoftShadowSm" BlurRadius="8" ShadowDepth="0" Direction="90" Opacity="0.06" Color="#000000"/>

            <!-- ===================== 图标（24x24 矢量路径） ===================== -->
            <Geometry x:Key="AxisIcon">M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z</Geometry>
            <Geometry x:Key="IoIcon">M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0L19.2 12l-4.6-4.6L16 6l6 6-6 6-1.4-1.4z</Geometry>
            <Geometry x:Key="CylinderIcon">M4 6h16v3H4zM4 10h16v3H4zM4 14h16v3H4z</Geometry>
            <Geometry x:Key="CommIcon">M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.65-4.35-1.65-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z</Geometry>
            <Geometry x:Key="TrayIcon">M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z</Geometry>
            <Geometry x:Key="FlowIcon">M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z</Geometry>
            <Geometry x:Key="VariableIcon">M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.59 1.41.59s1.05-.23 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z</Geometry>
            <Geometry x:Key="PointIcon">M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 110 12 6 6 0 010-12zm0 4a2 2 0 100 4 2 2 0 000-4z</Geometry>

            <Geometry x:Key="ExcelIcon">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14H6v-2h4v2zm0-4H6v-2h4v2zm0-4H6V7h4v2zm8 8h-6v-2h6v2zm0-4h-6v-2h6v2zm0-4h-6V7h6v2z</Geometry>
            <Geometry x:Key="AddIcon">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</Geometry>
            <Geometry x:Key="DeleteIcon">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</Geometry>
            <Geometry x:Key="UpIcon">M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z</Geometry>
            <Geometry x:Key="DownIcon">M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z</Geometry>
            <Geometry x:Key="CopyIcon">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</Geometry>
            <Geometry x:Key="PasteIcon">M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z</Geometry>
            <Geometry x:Key="UndoIcon">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</Geometry>
            <Geometry x:Key="RedoIcon">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</Geometry>
            <Geometry x:Key="SectionIcon">M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2z</Geometry>

            <!-- ===================== 顶部导航栏 ===================== -->
            <Style x:Key="NavBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Effect" Value="{StaticResource SoftShadowSm}"/>
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 页面顶部工具栏：添加 / 删除 -->
            <Style x:Key="ToolbarStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#A9C2E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 左侧项目列表 -->
            <Style x:Key="ProjectListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="DetailPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            </Style>

            <!-- 浮起白色卡片（圆角 + 发丝线 + 柔和阴影），用于包裹表格 -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            </Style>

            <Style x:Key="FieldGrid" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="110"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- 表单分组标题（带图标） -->
            <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ===================== 通用表格工具栏按钮 ===================== -->
            <Style x:Key="TtBaseBtn" TargetType="Button">
                <Setter Property="MinWidth" Value="76"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="11,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#C8D4E2"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TtAddBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}"/>
            <Style x:Key="TtDeleteBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#D63A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TtExcelBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2F9E44"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TtWarnBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E08600"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TtGrayBtn" TargetType="Button">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="#F2F2F7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#F2F2F7"/>
                                    <Setter Property="Foreground" Value="#AEAEB2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TtCountText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="14,0,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- ===================== 通用表格外观（隐式样式，作用于所有 DataGrid） ===================== -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowHeight" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="ColumnHeaderStyle" Value="{DynamicResource GridHeaderStyle}"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
            </Style>

            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,8"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- 列表项选中高亮 -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- ============ 表格单元格内嵌 ComboBox（扁平、干净）============
             完全自定义模板：去掉 HandyControl 默认边框/箭头；平时透明，
             悬停/展开时浅强调填充，右侧一个干净的 chevron；
             下拉面板为白色圆角卡片 + 阴影 + 高亮项。 -->
        <Style x:Key="CellComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="7,0,22,0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <ContentPresenter x:Name="PART_ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Path x:Name="Arrow" Data="M0,0 L5,0 L2.5,3 Z"
                                          Fill="{StaticResource TextMutedBrush}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,8,0" Stretch="Uniform" Width="9" Height="5"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PopupAnimation="Slide"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDown" Background="White"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer Margin="3">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
