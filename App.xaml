<Application x:Class="NoCodeMotion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoCodeMotion"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;Component/Themes/SkinDefault.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="#2D7FF9"/>
            <SolidColorBrush x:Key="NavActiveBrush" Color="#2D7FF9"/>
            <SolidColorBrush x:Key="LineBrush" Color="#DDE3EA"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#607080"/>

            <!-- 顶部导航栏 -->
            <Style x:Key="NavBarStyle" TargetType="Border">
                <Setter Property="Background" Value="#F4F7FB"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="76"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="#2B3A4B"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E4EDFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 页面顶部工具栏：添加 / 删除 -->
            <Style x:Key="ToolbarStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="76"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2D7FF9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1B6AE0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#A9C2E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 左侧项目列表 -->
            <Style x:Key="ProjectListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="#FBFCFE"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="DetailPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
            </Style>

            <!-- 详情表单的一行：左侧标签 + 右侧控件 -->
            <Style x:Key="FieldGrid" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="110"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#5A6B7B"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- 表单分组标题 -->
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#2D7FF9"/>
                <Setter Property="Margin" Value="0,14,0,4"/>
            </Style>

            <!-- ============== 通用表格工具栏按钮（所有表格页共用） ============== -->
            <Style x:Key="TtBaseBtn" TargetType="Button">
                <Setter Property="MinWidth" Value="64"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#3F8EF7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1B6AE0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#C8D4E2"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TtAddBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}"/>

            <Style x:Key="TtDeleteBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
                <Setter Property="Background" Value="#F66E6E"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E04D4D"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TtExcelBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
                <Setter Property="Background" Value="#4CAF50"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3D8B40"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TtCountText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="14,0,0,0"/>
                <Setter Property="Foreground" Value="#5A6B7B"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
