<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== iOS System Colors（浅色） ===== -->
    <Color x:Key="iOSBlue">#007AFF</Color>
    <Color x:Key="iOSGreen">#34C759</Color>
    <Color x:Key="iOSRed">#FF3B30</Color>
    <Color x:Key="iOSOrange">#FF9500</Color>
    <Color x:Key="iOSYellow">#FFCC00</Color>
    <Color x:Key="iOSPink">#FF2D55</Color>
    <Color x:Key="iOSPurple">#AF52DE</Color>
    <Color x:Key="iOSTeal">#5AC8FA</Color>
    <Color x:Key="iOSIndigo">#5856D6</Color>
    <Color x:Key="iOSGray">#8E8E93</Color>
    <Color x:Key="iOSGray2">#AEAEB2</Color>
    <Color x:Key="iOSGray3">#C7C7CC</Color>
    <Color x:Key="iOSGray4">#D1D1D6</Color>
    <Color x:Key="iOSGray5">#E5E5EA</Color>
    <Color x:Key="iOSGray6">#F2F2F7</Color>
    <Color x:Key="iOSLabel">#1C1C1E</Color>
    <Color x:Key="iOSSecondaryLabel">#3C3C43</Color>
    <Color x:Key="iOSTertiaryLabel">#48484A</Color>
    <Color x:Key="iOSSeparator">#C6C6C8</Color>

    <!-- ===== 语义画刷（保留既有 Key，映射为 iOS 值） ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource iOSBlue}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0062CC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource iOSGray6}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource iOSSeparator}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource iOSLabel}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource iOSGray}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource iOSGreen}" />
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#2BA24A" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource iOSRed}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDECEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource iOSRed}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E9E9EC" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource iOSGray3}" />
    <SolidColorBrush x:Key="SegTrackBrush" Color="#E9E9EB" />
    <SolidColorBrush x:Key="PreviewBgBrush" Color="#0B0B0F" />

    <!-- ===== iOS 系统颜色画刷（供图标/强调使用） ===== -->
    <SolidColorBrush x:Key="iOSBlueBrush" Color="{StaticResource iOSBlue}" />
    <SolidColorBrush x:Key="iOSGreenBrush" Color="{StaticResource iOSGreen}" />
    <SolidColorBrush x:Key="iOSRedBrush" Color="{StaticResource iOSRed}" />
    <SolidColorBrush x:Key="iOSOrangeBrush" Color="{StaticResource iOSOrange}" />
    <SolidColorBrush x:Key="iOSYellowBrush" Color="{StaticResource iOSYellow}" />
    <SolidColorBrush x:Key="iOSPinkBrush" Color="{StaticResource iOSPink}" />
    <SolidColorBrush x:Key="iOSPurpleBrush" Color="{StaticResource iOSPurple}" />
    <SolidColorBrush x:Key="iOSTealBrush" Color="{StaticResource iOSTeal}" />
    <SolidColorBrush x:Key="iOSIndigoBrush" Color="{StaticResource iOSIndigo}" />
    <SolidColorBrush x:Key="iOSGrayBrush" Color="{StaticResource iOSGray}" />

    <!-- ===== 柔和阴影（iOS 风格：极轻、无偏移） ===== -->
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.06" Color="#000000" />
    <DropShadowEffect x:Key="SoftShadowSm" BlurRadius="5" ShadowDepth="0" Opacity="0.05" Color="#000000" />
    <DropShadowEffect x:Key="PillShadow" BlurRadius="3" ShadowDepth="0" Opacity="0.16" Color="#000000" />

    <!-- ===== 全局字体 ===== -->
    <FontFamily x:Key="AppleFont">Segoe UI, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial</FontFamily>

  <!-- Copyright 温启志 ▪ 微信 18719361399 -->
</ResourceDictionary>
