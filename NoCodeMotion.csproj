<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- AvalonEdit 6.3 针对 net6.0-windows 编译，net10 引用会触发框架回退提示，属正常兼容，抑制以保持 0 警告。 -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Page Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="NModbus.Serial" Version="3.0.83" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <!-- OpenCV：复用 CvMatch 已验证的 OpenCvSharp4 4.13 + 原生运行时（从 CvMatch 目录复制，保证与原生 DLL 版本匹配） -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复制 CvMatch 目录下的 OpenCV 原生运行时到 NoCodeMotion 输出目录（OpenCvSharp4 不自带原生 DLL，由运行时包提供；此处直接复用 CvMatch 已验证版本） -->
    <None Include="..\CvMatch\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CvMatch\opencv_world480.dll" Link="opencv_world480.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CvMatch\opencv_videoio_ffmpeg4130_64.dll" Link="opencv_videoio_ffmpeg4130_64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Lua.xshd" />
  </ItemGroup>

</Project>
