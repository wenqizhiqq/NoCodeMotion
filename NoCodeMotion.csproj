<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 允许 unsafe 代码块：用于 WriteableBitmap.BackBuffer 指针绘制（料盘高性能渲染） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AvalonEdit 6.3 针对 net6.0-windows 编译，net10 引用会触发框架回退提示，属正常兼容，抑制以保持 0 警告。 -->
    <NoWarn>NU1701</NoWarn>
    <!-- .NET 10 SDK 的 WPF 临时标记编译工程（_wpftmp）会重复包含自动生成的 AssemblyInfo / 框架特性文件，
         导致 CS0579 重复特性错误。关闭主工程自动生成，由 _wpftmp 自行生成其特性（共享的 ThemeInfo 保留在 AssemblyInfo.cs 中且不冲突）。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Page Remove="artifacts\**" />
    <!-- _out 是 .gitignore 里的临时 / 发布目录（dotnet publish -o _out）。
         SDK 默认的 **/*.xaml 会把它一起当 <Page> 编译，里面的旧副本会把构建打挂，
         这里显式剔除，和上面的 artifacts 同样处理。 -->
    <Compile Remove="_out\**" />
    <EmbeddedResource Remove="_out\**" />
    <None Remove="_out\**" />
    <Page Remove="_out\**" />
    <Content Remove="_out\**" />
  </ItemGroup>

  <!-- 复用 GrayMatch 的旋转不变 NCC 匹配核心（纯算法/C#：RotatedTemplateMatcher + MatchResult + DefectResult，无 WPF/WinForms 依赖）。
       副本已打包进项目本地 Vision\GrayMatch\，由 .NET SDK 默认 Compile 自动纳入（无需显式 Include，避免 NETSDK1022 重复项），IDE 在任意工作目录均可构建。
       当 GrayMatch 主项目源文件演进时需手动同步本副本；保持作者签名。
       作者：温‌启‍志‍◆‍编⁣写‎◇‌微‎信⁠﹕⁣1‍8‍7⁣◆​1‎9‎3‌6⁣◇​1‏3‌9‌9 -->

  <!-- 原生匹配 DLL（x64）与其 OpenMP 运行时（vcomp140），已全部打包进项目本地 Native\ 目录，
       不再依赖父级 GrayMatch/CvMatch 仓库位置，IDE 在任意工作目录均可 build/run。
       GrayModelNative 由 C++ 编译，其产物 GrayModelNative.dll 已置于 Native\；
       使用 OpenMP 并行，运行时必须随附 vcomp140.dll（见下方复制项），否则 P/Invoke 加载失败。
       作者：温‌启​志‍◆⁣编‏写⁠◇⁣微‎信‏﹕‎1‎8⁣7‌◆​1⁣9⁠3‎6‎◇‎1‍3‍9⁣9 -->
  <ItemGroup>
    <None Include="Native\GrayModelNative.dll" Link="GrayModelNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\vcomp140.dll" Link="vcomp140.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- vcomp140.dll 现已随 GrayModelNative 一起置于 Native\，不再从 VS Redist 复制（见上方 None 项）。 -->

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="OcctNet.Wrapper" Version="0.1.1" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="NModbus.Serial" Version="3.0.83" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <!-- OpenCV：OpenCvSharp4 4.13 仅含托管 OpenCvSharp.dll，原生运行时（OpenCvSharpExtern/opencv_world480/ffmpeg）统一由项目本地 Native\ 目录提供，版本已对齐。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Aspose.CAD：读取二进制 DWG（AutoCAD 各版本）与 DXF 文本，提取矢量几何供 3D 仿真页以平面布局显示。
         仅迭代矢量实体（CadImage.Entities / BlockEntities），不调用 Image.Save 栅格化，故不触发"Evaluation only"水印。 -->
    <PackageReference Include="Aspose.CAD" Version="26.7.0" />
    <!-- BepuPhysics v2：纯 C# 3D 物理引擎（无原生 DLL），用于仿真工件物理化（重力/碰撞/被气缸与轴推动）。 -->
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <!-- Newtonsoft.Json：移植进来的 DMC1000S / MCN42Series / DigitalTwinCard 三个卡家族
         用 JsonConvert 做配置与状态快照的序列化，原参考实现即依赖此库。 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV 原生运行时已全部打包进项目本地 Native\ 目录（OpenCvSharpExtern + opencv_world480 + ffmpeg），不再依赖 CvMatch 仓库位置。 -->
    <None Include="Native\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\opencv_world480.dll" Link="opencv_world480.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\opencv_videoio_ffmpeg4130_64.dll" Link="opencv_videoio_ffmpeg4130_64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 雷赛（Leadshine）DMC 系列控制卡原生运行时：取自 WenQiZhiMotion 参考实现的 Loader\bin。
       全部为 x64 原生库，与 NoCodeMotion.exe(x64) 位数一致。
       LTDMC.dll 是统一驱动（Hardware/Leadshine/LtdmcNative.cs P/Invoke 的目标）；
       Dmc1000/IMC100API/ecat_motion 是各卡型的后端，插对应实物卡时由 LTDMC.dll 按需加载。
       注：DMC2210.dll 在参考实现里是 x86，与 x64 进程不兼容，DMC2210 卡型需另取 x64 版本。 -->
  <!-- 运动控制卡层（移植自 WenQiZhiMotion / SMotorse 参考实现）所需的原生运行时。
       全部为 x64，与 NoCodeMotion.exe(x64) 位数一致；各卡家族的 P/Invoke 目标见
       Services\Hardware\Cards\Native\*.cs。未随附的库（MCC.dll / Dmc2410.dll /
       SLD9014PTP.dll 缺件，DMC2210.dll 为 x86）对应的卡家族仍可编译，但插卡后无法驱动。 -->
  <ItemGroup>
    <None Include="Native\LTDMC.dll" Link="LTDMC.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\Dmc1000.dll" Link="Dmc1000.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\IMC100API.dll" Link="IMC100API.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\ecat_motion.dll" Link="ecat_motion.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\MCC1C00.dll" Link="MCC1C00.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\MCC800S.dll" Link="MCC800S.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\MCCE135.dll" Link="MCCE135.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\MCN420.dll" Link="MCN420.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\MCX08.dll" Link="MCX08.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\PCI400.dll" Link="PCI400.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\PLT.dll" Link="PLT.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\Pci9014.dll" Link="Pci9014.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\Pci9016.dll" Link="Pci9016.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\PCI1230.dll" Link="PCI1230.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\sldmv.dll" Link="sldmv.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SoftServo 卡家族依赖的厂商托管 SDK（WMX3 实时软伺服）。
       这些是托管程序集：既要 Reference 才能编译，也要随输出目录复制才能运行。 -->
  <ItemGroup>
    <None Include="Native\WMX3Api_CLRLib.dll" Link="WMX3Api_CLRLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\RtMotionApiNET.dll" Link="RtMotionApiNET.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\EcApi_CLRLib.dll" Link="EcApi_CLRLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\CoreMotionApi_CLRLib.dll" Link="CoreMotionApi_CLRLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\IOApi_CLRLib.dll" Link="IOApi_CLRLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\EventApi_CLRLib.dll" Link="EventApi_CLRLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RtMotionApiNET">
      <HintPath>Native\RtMotionApiNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WMX3Api_CLRLib">
      <HintPath>Native\WMX3Api_CLRLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EcApi_CLRLib">
      <HintPath>Native\EcApi_CLRLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CoreMotionApi_CLRLib">
      <HintPath>Native\CoreMotionApi_CLRLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IOApi_CLRLib">
      <HintPath>Native\IOApi_CLRLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EventApi_CLRLib">
      <HintPath>Native\EventApi_CLRLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 真实机台 3D 模型（WaveFront .obj，直接嵌入输出目录，运行时按路径加载） -->
  <ItemGroup>
    <Content Include="Models\**\*.obj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="build_cond11.log" />
  </ItemGroup>

  <!-- 内置示例机器人 STP（Creo BREP），随输出目录提供，操作员仿真页自动载入显示 -->
  <ItemGroup>
    <Content Include="IR-R10-140S-INT-3D-3D.stp" Link="Models\CAD\IR-R10-140S-INT-3D-3D.stp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
