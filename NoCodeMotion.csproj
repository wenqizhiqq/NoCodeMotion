<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 允许 unsafe 代码块：用于 WriteableBitmap.BackBuffer 指针绘制（料盘高性能渲染） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AvalonEdit 6.3 针对 net6.0-windows 编译，net10 引用会触发框架回退提示，属正常兼容，抑制以保持 0 警告。 -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Page Remove="artifacts\**" />
  </ItemGroup>

  <!-- 复用 GrayMatch.Wpf 的旋转不变 NCC 匹配核心（与 GrayMatch 工程共用同一份源文件，单一事实来源）。
       仅含纯算法/C# 部分（RotatedTemplateMatcher + MatchResult + DefectResult），不引入 WPF/WinForms 依赖。
       作者：温启志◆编写◇微信﹕187◆1936◇1399 -->
  <ItemGroup>
    <Compile Include="..\GrayMatch\GrayMatch\RotatedTemplateMatcher.cs" Link="Vision\GrayMatch\RotatedTemplateMatcher.cs" />
    <Compile Include="..\GrayMatch\GrayMatch\MatchResult.cs" Link="Vision\GrayMatch\MatchResult.cs" />
    <Compile Include="..\GrayMatch\GrayMatch\DefectResult.cs" Link="Vision\GrayMatch\DefectResult.cs" />
  </ItemGroup>

  <!-- 原生匹配 DLL（x64）与其 OpenMP 运行时（vcomp140）。GrayModelNative 由 C++ 编译，
       使用 OpenMP 并行，运行时必须随附 vcomp140.dll，否则 P/Invoke 加载失败。 -->
  <ItemGroup>
    <None Include="..\GrayMatch\GrayModelNative\build-ninja9\GrayModelNative.dll" Link="GrayModelNative.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyGrayMatchNativeDeps" AfterTargets="Build">
    <PropertyGroup>
      <_VsRedistRoot Condition="Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Redist\MSVC')">C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Redist\MSVC</_VsRedistRoot>
      <_VsRedistRoot Condition="'$(_VsRedistRoot)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Redist\MSVC')">C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Redist\MSVC</_VsRedistRoot>
      <_VsRedistRoot Condition="'$(_VsRedistRoot)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Redist\MSVC')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Redist\MSVC</_VsRedistRoot>
      <_VsRedistRoot Condition="'$(_VsRedistRoot)' == '' AND Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Redist\MSVC')">C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Redist\MSVC</_VsRedistRoot>
    </PropertyGroup>
    <ItemGroup>
      <_VcompDll Include="$(_VsRedistRoot)\*\x64\Microsoft.VC143.OpenMP\vcomp140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_VcompDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="OcctNet.Wrapper" Version="0.1.1" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="NModbus.Serial" Version="3.0.83" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <!-- OpenCV：复用 CvMatch 已验证的 OpenCvSharp4 4.13 + 原生运行时（从 CvMatch 目录复制，保证与原生 DLL 版本匹配） -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复制 CvMatch 目录下的 OpenCV 原生运行时到 NoCodeMotion 输出目录（OpenCvSharp4 不自带原生 DLL，由运行时包提供；此处直接复用 CvMatch 已验证版本） -->
    <None Include="..\CvMatch\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CvMatch\opencv_world480.dll" Link="opencv_world480.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CvMatch\opencv_videoio_ffmpeg4130_64.dll" Link="opencv_videoio_ffmpeg4130_64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Lua.xshd" />
  </ItemGroup>

  <!-- 真实机台 3D 模型（WaveFront .obj，直接嵌入输出目录，运行时按路径加载） -->
  <ItemGroup>
    <Content Include="Models\**\*.obj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 内置示例机器人 STP（Creo BREP），随输出目录提供，操作员仿真页自动载入显示 -->
  <ItemGroup>
    <Content Include="IR-R10-140S-INT-3D-3D.stp" Link="Models\CAD\IR-R10-140S-INT-3D-3D.stp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
