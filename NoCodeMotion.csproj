<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 允许 unsafe 代码块：用于 WriteableBitmap.BackBuffer 指针绘制（料盘高性能渲染） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AvalonEdit 6.3 针对 net6.0-windows 编译，net10 引用会触发框架回退提示，属正常兼容，抑制以保持 0 警告。 -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Page Remove="artifacts\**" />
  </ItemGroup>

  <!-- 复用 GrayMatch 的旋转不变 NCC 匹配核心（纯算法/C#：RotatedTemplateMatcher + MatchResult + DefectResult，无 WPF/WinForms 依赖）。
       副本已打包进项目本地 Vision\GrayMatch\，由 .NET SDK 默认 Compile 自动纳入（无需显式 Include，避免 NETSDK1022 重复项），IDE 在任意工作目录均可构建。
       当 GrayMatch 主项目源文件演进时需手动同步本副本；保持作者签名。
       作者：温启志◆编写◇微信﹕187◆1936◇1399 -->

  <!-- 原生匹配 DLL（x64）与其 OpenMP 运行时（vcomp140），已全部打包进项目本地 Native\ 目录，
       不再依赖父级 GrayMatch/CvMatch 仓库位置，IDE 在任意工作目录均可 build/run。
       GrayModelNative 由 C++ 编译，其产物 GrayModelNative.dll 已置于 Native\；
       使用 OpenMP 并行，运行时必须随附 vcomp140.dll（见下方复制项），否则 P/Invoke 加载失败。
       作者：温启志◆编写◇微信﹕187◆1936◇1399 -->
  <ItemGroup>
    <None Include="Native\GrayModelNative.dll" Link="GrayModelNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\vcomp140.dll" Link="vcomp140.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- vcomp140.dll 现已随 GrayModelNative 一起置于 Native\，不再从 VS Redist 复制（见上方 None 项）。 -->

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="OcctNet.Wrapper" Version="0.1.1" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="NModbus.Serial" Version="3.0.83" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <!-- OpenCV：OpenCvSharp4 4.13 仅含托管 OpenCvSharp.dll，原生运行时（OpenCvSharpExtern/opencv_world480/ffmpeg）统一由项目本地 Native\ 目录提供，版本已对齐。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV 原生运行时已全部打包进项目本地 Native\ 目录（OpenCvSharpExtern + opencv_world480 + ffmpeg），不再依赖 CvMatch 仓库位置。 -->
    <None Include="Native\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\opencv_world480.dll" Link="opencv_world480.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\opencv_videoio_ffmpeg4130_64.dll" Link="opencv_videoio_ffmpeg4130_64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Lua.xshd" />
  </ItemGroup>

  <!-- 真实机台 3D 模型（WaveFront .obj，直接嵌入输出目录，运行时按路径加载） -->
  <ItemGroup>
    <Content Include="Models\**\*.obj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 内置示例机器人 STP（Creo BREP），随输出目录提供，操作员仿真页自动载入显示 -->
  <ItemGroup>
    <Content Include="IR-R10-140S-INT-3D-3D.stp" Link="Models\CAD\IR-R10-140S-INT-3D-3D.stp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
