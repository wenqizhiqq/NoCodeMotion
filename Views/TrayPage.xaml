<UserControl x:Class="NoCodeMotion.Views.TrayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:models="clr-namespace:NoCodeMotion.Models"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:OccupiedTextConverter x:Key="OccupiedTextConverter"/>

        <!-- 二维单元格按钮（苹果风：空态浅灰、有料态浅绿+绿边，全部走调色板） -->
        <Style x:Key="TrayCellToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Row, StringFormat=R{0}}" FontSize="11"/>
                                <TextBlock Text="{Binding Col, StringFormat=C{0}}" FontSize="11"/>
                                <TextBlock Text="{Binding Occupied, Converter={StaticResource OccupiedTextConverter}}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <local:EditorPage EmptyHint="还没有料盘。做法：① 点左上角【添加】建一个料盘；② 在右边填行数、列数、间距；③ 顺序填好后，流程里就能用「取料 / 放料」按格子走。">
        <local:EditorPage.Detail>
            <DockPanel LastChildFill="True" Background="{StaticResource CanvasBrush}" Margin="14">
                <!-- 页标题 -->
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource PageHeaderPanel}">
                    <Path Style="{StaticResource PageHeaderIcon}" Data="{StaticResource TrayIcon}"/>
                    <TextBlock Style="{StaticResource PageHeaderTitle}" Text="料盘"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <!-- ============ 料盘参数 ============ -->
                        <Border Grid.Column="0" Style="{StaticResource AppleGroupCard}" Margin="0,0,12,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="料盘参数"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="名称"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="这个料盘叫什么；流程里按这个名字来取第几格"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="行数"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingRows, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="上下方向有几排格子"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="列数"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingCols, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="左右方向有几列格子"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="起始X"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingStartX, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="左下角那一格，X 轴要走到哪儿（毫米）。先把轴手动开到那一格，再照抄这个数最准"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="起始Y"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingStartY, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="左下角那一格，Y 轴要走到哪儿（毫米）"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="间距X"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingPitchX, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="往右挪一列，X 要走多少毫米（负号就是往反方向挪）"/></StackPanel>
                                    <Rectangle Style="{StaticResource AppleHairline}"/>
                                    <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="间距Y"/>
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PendingPitchY, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="往上挪一行，Y 要走多少毫米（负号就是往反方向挪）"/></StackPanel>
                                </StackPanel>

                                <!-- 底部：参数修改确认按钮区（弹窗式）：按「应用参数生成点位」才真正生成 Cells。
                                     没修改时按钮 IsEnabled=false 自动变灰。 -->
                                <Border DockPanel.Dock="Bottom" Padding="12,10,12,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="放弃修改" ToolTip="不要刚才改的参数了，回到上一次生成好的结果"
                                                Command="{Binding ResetPendingCommand}"
                                                IsEnabled="{Binding SelectedItem.HasPendingChanges}"
                                                Style="{StaticResource TtPillGrayBtn}"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="应用参数生成点位" ToolTip="按上面填的行数、列数、起点和间距，把每一格的坐标一次全算出来（改了参数必须再点一次才生效）"
                                                Command="{Binding ApplyCommand}"
                                                IsEnabled="{Binding SelectedItem.HasPendingChanges}"
                                                Style="{StaticResource TtPillBlueBtn}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- ============ 二维料盘 ============ -->
                        <Border Grid.Column="1" Style="{StaticResource AppleGroupCard}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource AppleSectionHeader}" Text="料盘长这样（点某一格，就在 有料 / 空 之间切换）"/>

                                <!-- 图例 -->
                                <StackPanel Orientation="Horizontal" Margin="12,4,12,8" DockPanel.Dock="Top">
                                    <Border Width="14" Height="14" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="有料" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Width="14" Height="14" Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="空" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- 主体：高性能单图渲染。无论多少格子都只有 1 个 Image 元素（位图整图绘制），
                                     数量多时由 ScrollViewer 出滚动条；点击按像素位置算行列切换 有料/空。 -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12" Background="Transparent">
                                    <Image Stretch="None"
                                           MouseLeftButtonDown="TrayImage_MouseLeftButtonDown"
                                           Cursor="Hand"
                                           SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                </Grid>
            </DockPanel>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
