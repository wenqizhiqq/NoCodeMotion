<UserControl x:Class="NoCodeMotion.Views.TrayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:models="clr-namespace:NoCodeMotion.Models"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:OccupiedTextConverter x:Key="OccupiedTextConverter"/>

        <!-- 二维单元格按钮（苹果风：空态浅灰、有料态浅绿+绿边，全部走调色板） -->
        <Style x:Key="TrayCellToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Row, StringFormat=R{0}}" FontSize="11"/>
                                <TextBlock Text="{Binding Col, StringFormat=C{0}}" FontSize="11"/>
                                <TextBlock Text="{Binding Occupied, Converter={StaticResource OccupiedTextConverter}}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <local:EditorPage>
        <local:EditorPage.Detail>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource CanvasBrush}">
                    <StackPanel Margin="16" MaxWidth="720">
                        <!-- ============ 料盘参数 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="料盘参数"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="名称"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="行数"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Rows, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="列数"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Cols, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="起始X"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.StartX, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="起始Y"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.StartY, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="间距X"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PitchX, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="间距Y"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.PitchY, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 二维料盘 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="二维料盘（点击单元格切换 有料/空）"/>

                                <!-- 图例 -->
                                <StackPanel Orientation="Horizontal" Margin="12,4,12,8">
                                    <Border Width="14" Height="14" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="有料" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Width="14" Height="14" Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="空" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="12,0,12,10">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="{Binding SelectedItem.Rows}" Columns="{Binding SelectedItem.Cols}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:TrayCell">
                                                <ToggleButton Style="{StaticResource TrayCellToggle}"
                                                              IsChecked="{Binding Occupied, Mode=TwoWay}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
