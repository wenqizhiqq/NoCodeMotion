<Window x:Class="NoCodeMotion.Views.FlowCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="450"
        SizeToContent="Height" MaxHeight="{Binding Source={x:Static sys:SystemParameters.WorkArea}, Path=Height}"
        Width="450" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="新建流程"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                   Foreground="#0F172A"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="名称" Width="50"
                       VerticalAlignment="Center" Foreground="#334155" FontSize="13"/>
            <TextBox x:Name="NameBox" Padding="6,4" FontSize="13"
                     BorderBrush="#E2E8F0" BorderThickness="1"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="流程角色（单选）" FontSize="13" FontWeight="SemiBold"
                   Foreground="#334155" Margin="0,0,0,8"/>

        <Border Grid.Row="3" Background="#F8FAFC" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <RadioButton x:Name="MainRadio" Content="主流程" GroupName="RoleGroup" IsChecked="True"
                             Margin="0,2,0,2" FontSize="13"/>
                <TextBlock Text="选「主流程」：操作员在「操作员」页点【启动】后，这一段会一遍接一遍一直跑，直到点【停止】。"
                           FontSize="11" Foreground="#94A3B8" Margin="22,0,0,6"/>
                <RadioButton x:Name="ResetRadio" Content="复位流程" GroupName="RoleGroup"
                             Margin="0,2,0,2" FontSize="13"/>
                <TextBlock Text="选「复位」：操作员点【复位】时跑这一段；所有复位流程都跑完了，才允许重新开始生产。"
                           FontSize="11" Foreground="#94A3B8" Margin="22,0,0,6"/>
                <RadioButton x:Name="StartupRadio" Content="开机循环" GroupName="RoleGroup"
                             Margin="0,2,0,2" FontSize="13"/>
                <TextBlock Text="选「开机循环」：软件启动、工程载入完成后自动开始循环运行，直到在操作员页点【停止】。"
                           FontSize="11" Foreground="#94A3B8" Margin="22,0,0,6" TextWrapping="Wrap"/>
                <RadioButton x:Name="ExitRadio" Content="退出前执行" GroupName="RoleGroup"
                             Margin="0,2,0,2" FontSize="13"/>
                <TextBlock Text="选「退出前执行」：关闭软件时先停掉其它流程，再单次跑完这一段（最多等 30 秒），然后保存工程并断开控制器。"
                           FontSize="11" Foreground="#94A3B8" Margin="22,0,0,2" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="选择模板（单选）" FontSize="13" FontWeight="SemiBold"
                   Foreground="#334155" Margin="0,14,0,8"/>

        <Border Grid.Row="5" Background="#F8FAFC" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
            <StackPanel x:Name="TemplatePanel"/>
        </Border>

        <TextBlock Grid.Row="6" Text="将生成的步骤" FontSize="13" FontWeight="SemiBold"
                   Foreground="#334155" Margin="0,14,0,8"/>

        <Border Grid.Row="7" Background="#F1F5F9" Padding="10" CornerRadius="6"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="12"
                           Foreground="#475569" LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Padding="14,6" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"
                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0"/>
            <Button Content="确定" Padding="14,6" Click="Ok_Click" IsDefault="True"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
