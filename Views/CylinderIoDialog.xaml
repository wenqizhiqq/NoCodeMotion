<Window x:Class="NoCodeMotion.Views.CylinderIoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- Apple 风格自定义对话框：按名称自动生成气缸 IO（2 个输入 + 2 个输出） -->
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <StackPanel MinWidth="400" MaxWidth="460">
            <!-- 标题区 -->
            <Border Padding="22,18,22,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource TableIconGeometry}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="自动生成气缸 IO" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 参数区 -->
            <Grid Margin="22,16,22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="气缸名称" VerticalAlignment="Center" Margin="0,6,10,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Text="气缸1" Style="{StaticResource AppleTextField}" Margin="0,4,14,4" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="生成几个" VerticalAlignment="Center" Margin="0,6,10,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="CountBox" Text="1" Width="64" Style="{StaticResource AppleTextField}" Margin="0,4,0,4" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,2"
                           Text="生成规则：输入「气缸1动点」「气缸1原点」，输出「气缸1输出1」「气缸1输出2」。名称末尾的数字会自动往上加（气缸1 + 生成 3 个 = 气缸1 / 气缸2 / 气缸3）；已有同名点的整组跳过。"/>
            </Grid>

            <!-- 按钮区 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource TtGrayBtn}" Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="OkButton" Content="生成" Style="{StaticResource TtBaseBtn}" Margin="8,0,0,0" Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
