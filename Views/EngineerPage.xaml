<UserControl x:Class="NoCodeMotion.Views.EngineerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1200"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- ===== 8 个轴列头模板：取本页 AxisStates[i].AxisName + 后缀（位置/速度）；空轴名回退"未选轴" ===== -->
        <DataTemplate x:Key="H0Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[0].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H0Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[0].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[1].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[1].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[2].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[2].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[3].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[3].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <!-- IO 输出开关按钮：根据 Value 显示"打开/关闭" -->
        <Style x:Key="IoOutBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
            <Setter Property="Content" Value="打开"/>
            <Setter Property="MinWidth" Value="72"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="1">
                    <Setter Property="Content" Value="关闭"/>
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 气缸伸出/缩回按钮：根据 Extended 显示"伸出/缩回" -->
        <Style x:Key="CylBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
            <Setter Property="Content" Value="伸出"/>
            <Setter Property="MinWidth" Value="84"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Extended}" Value="True">
                    <Setter Property="Content" Value="缩回"/>
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 紧凑 IO / 气缸卡片 -->
        <Style x:Key="MiniCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </UserControl.Resources>

    <!-- 自适应 2 列布局：左列为「轴控制 + 气缸控制」，右列为「IO 控制 + 点位移动」。
         整页无外部滚动条；每个卡片占满所在网格单元，内容溢出时各自内部滚动。 -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：轴控制（上） + 气缸控制（下） -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ① 轴控制 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,8,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource AxisIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="轴控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="6,12,6,0">
                        <TextBlock DockPanel.Dock="Left" Text="寸动步长" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBox DockPanel.Dock="Left" Text="{Binding InchStep, UpdateSourceTrigger=PropertyChanged}" Width="72" Style="{StaticResource PointCellTextBoxStyle}"/>
                        <TextBlock DockPanel.Dock="Left" Text="JOG 步长" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBox DockPanel.Dock="Left" Text="{Binding JogStep, UpdateSourceTrigger=PropertyChanged}" Width="72" Style="{StaticResource PointCellTextBoxStyle}"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AxisStates}" ItemTemplate="{StaticResource AxisCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                                    </DockPanel>
            </Border>

            <!-- ③ 气缸控制 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,8,8,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource CylinderIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="气缸控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Cylinders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MiniCardStyle}" Width="224" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Item.OutPoint, StringFormat=输出点：{0}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            <Button Command="{Binding DataContext.ToggleCylinderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource CylBtn}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                                    </DockPanel>
            </Border>
        </Grid>

        <!-- 右列：IO 控制（上） + 点位移动（下） -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ② IO 控制 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource IoIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="IO 控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 输入 IO -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="输入 IO（只读）" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MiniCardStyle}" Width="210" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Value}" Value="1">
                                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <TextBlock.Text><MultiBinding StringFormat="{}卡{0} 模{1} · 值{2}">
                                                                <Binding Path="CardNo"/><Binding Path="ModuleNo"/><Binding Path="Value"/>
                                                            </MultiBinding></TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 输出 IO -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="输出 IO（可切换）" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MiniCardStyle}" Width="210" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <TextBlock.Text><MultiBinding StringFormat="{}卡{0} 模{1} · 值{2}">
                                                                <Binding Path="CardNo"/><Binding Path="ModuleNo"/><Binding Path="Value"/>
                                                            </MultiBinding></TextBlock.Text>
                                                        </TextBlock>
                                                        <Button DockPanel.Dock="Right" Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource IoOutBtn}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                                    </ScrollViewer>
                                    </DockPanel>
            </Border>

            <!-- ④ 点位移动和设置（占满下方区域，点位表内部滚动、列头固定） -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,8,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource PointIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="点位移动和设置" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="选择工位" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Tables}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTable, Mode=TwoWay}" Width="200" Style="{StaticResource CellComboStyle}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentPoints.Count, StringFormat=共 {0} 个点位}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="0" SnapsToDevicePixels="True">
                        <DataGrid ItemsSource="{Binding CurrentPoints}"
                                  RowStyle="{StaticResource PointRowStyle}"
                                  CellStyle="{StaticResource PointCellStyle}"
                                  ColumnHeaderStyle="{StaticResource PointHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="CellOrRowHeader"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="30"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="点位名称" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="移动" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.MoveToPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtBaseBtn}" Content="移动" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="保存" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SaveCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtExcelBtn}" Content="保存" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
