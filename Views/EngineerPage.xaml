<UserControl x:Class="NoCodeMotion.Views.EngineerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1200"
             Background="{StaticResource CanvasBrush}">

    <UserControl.Resources>
        <!-- ===== 8 个轴列头模板：取本页 PointAxisStates[i].AxisName + 后缀（位置/速度）；空轴名回退"未选轴"。
             PointAxisStates 与顶部「轴控制」的 AxisStates 解耦，仅跟随当前工位的 PointTable.AxisNames，
             因此顶部选择轴不会影响底部点位表的列头。 -->
        <DataTemplate x:Key="H0Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[0].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H0Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[0].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[1].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[1].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[2].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[2].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Pos">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[3].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Spd">
            <TextBlock TextAlignment="Center">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.PointAxisStates[3].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <!-- IO 输出开关按钮：根据 Value 显示"打开/关闭" -->
        <Style x:Key="IoOutBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
            <Setter Property="Content" Value="打开"/>
            <Setter Property="MinWidth" Value="72"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="1">
                    <Setter Property="Content" Value="关闭"/>
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 气缸伸出/缩回按钮：根据 Extended 显示"伸出/缩回" -->
        <Style x:Key="CylBtn" TargetType="Button" BasedOn="{StaticResource TtBaseBtn}">
            <Setter Property="Content" Value="伸出"/>
            <Setter Property="MinWidth" Value="84"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Extended}" Value="True">
                    <Setter Property="Content" Value="缩回"/>
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 搜索行右侧的「取消」按钮：一键清空关键字、恢复全量显示。
             用浅灰 pill（次要操作），避免和「打开/关闭/伸出/缩回」等主操作抢视觉焦点。 -->
        <Style x:Key="SearchClearBtn" TargetType="Button" BasedOn="{StaticResource TtPillGrayBtn}">
            <Setter Property="Content" Value="取消"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- 紧凑 IO / 气缸卡片 -->
        <Style x:Key="MiniCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- 紧凑卡片列表（IO 输入 / 输出 / 气缸共用）：虚拟化 + 双向滚动条，500 项也不卡。
             说明：ItemsControl + 外层 ScrollViewer 不会虚拟化（面板拿到无限高），
             必须用 ListBox（自带 ScrollViewer + CanContentScroll），才真正回收容器。 -->
        <Style x:Key="VirtualCardListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 自适应 2 列布局：左列为「轴控制 + 气缸控制」，右列为「IO 控制 + 点位移动」。
         整页无外部滚动条；每个卡片占满所在网格单元，内容溢出时各自内部滚动。 -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左列：轴控制（上） + 气缸控制（下） -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ① 轴控制 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,8,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource AxisIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="轴控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AxisStates}" ItemTemplate="{StaticResource AxisCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock DockPanel.Dock="Bottom" FontSize="12" Margin="6,8,6,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding JogHint}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JogHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                                </DockPanel>
            </Border>

            <!-- ③ 气缸控制 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,8,8,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource CylinderIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="气缸控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 搜索：按 名称 / 设备编号 / 类型 / 输出点 / 感应点 / 备注 过滤；右侧「取消」一键清空 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource TtSearchBox}" Width="Auto" Height="28" Margin="0"
                                 Tag="搜索 名称 / 类型 / 输出点"
                                 Text="{Binding CylinderSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource TtMatchInfo}" Margin="8,0,0,0"
                                   Text="{Binding CylinderMatchInfo}"/>
                        <Button Grid.Column="2" Style="{StaticResource SearchClearBtn}"
                                Command="{Binding ClearCylinderSearchCommand}" ToolTip="取消搜索（清空关键字）"/>
                    </Grid>
                    <!-- 单行紧凑行：名称 | 类型 · 输出点 | 伸出/缩回；宽度随列宽拉伸（不再固定 224） -->
                    <ListBox ItemsSource="{Binding CylindersView}" Style="{StaticResource VirtualCardListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MiniCardStyle}" Margin="0,0,6,5" Padding="10,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text><MultiBinding StringFormat="{}类型 {0} · 输出点 {1}">
                                                <Binding Path="Item.Type"/><Binding Path="Item.OutPoint"/>
                                            </MultiBinding></TextBlock.Text>
                                        </TextBlock>
                                        <Button Grid.Column="2" Style="{StaticResource CylBtn}"
                                                Command="{Binding DataContext.ToggleCylinderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Height="26" MinWidth="56" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                                    </DockPanel>
            </Border>
        </Grid>

        <!-- 右列：IO 控制（上） + 点位移动（下） -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ② IO 控制 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource IoIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="IO 控制" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 输入 IO（只读）——独立滚动 + 虚拟化 + 搜索过滤 -->
                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Text="输入 IO（只读）" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <!-- 搜索：按 名称 / 功能 / 卡类 / 套码 / 控制器 / 卡号 / 模块 过滤；右侧「取消」一键清空 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource TtSearchBox}" Width="Auto" Height="28" Margin="0"
                                         Tag="搜索 名称 / 功能 / 卡号"
                                         Text="{Binding InputSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TtMatchInfo}" Margin="8,0,0,0"
                                           Text="{Binding InputMatchInfo}"/>
                                <Button Grid.Column="2" Style="{StaticResource SearchClearBtn}"
                                        Command="{Binding ClearInputSearchCommand}" ToolTip="取消搜索（清空关键字）"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding InputsView}" Style="{StaticResource VirtualCardListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 单行紧凑行：左侧 状态点 + 名称，右侧 卡/模/值；宽度随列宽拉伸 -->
                                        <Border Style="{StaticResource MiniCardStyle}" Margin="0,0,6,5" Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="1">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text><MultiBinding StringFormat="{}卡{0} 模{1} · 值{2}">
                                                        <Binding Path="CardNo"/><Binding Path="ModuleNo"/><Binding Path="Value"/>
                                                    </MultiBinding></TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 输出 IO（可切换）——独立滚动 + 虚拟化 + 搜索过滤 -->
                        <DockPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="输出 IO（可切换）" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <!-- 搜索：按 名称 / 功能 / 卡类 / 套码 / 控制器 / 卡号 / 模块 过滤；右侧「取消」一键清空 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource TtSearchBox}" Width="Auto" Height="28" Margin="0"
                                         Tag="搜索 名称 / 功能 / 卡号"
                                         Text="{Binding OutputSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TtMatchInfo}" Margin="8,0,0,0"
                                           Text="{Binding OutputMatchInfo}"/>
                                <Button Grid.Column="2" Style="{StaticResource SearchClearBtn}"
                                        Command="{Binding ClearOutputSearchCommand}" ToolTip="取消搜索（清空关键字）"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding OutputsView}" Style="{StaticResource VirtualCardListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 单行紧凑行：左侧 名称，中间 卡/模/值，右侧 开关按钮；宽度随列宽拉伸 -->
                                        <Border Style="{StaticResource MiniCardStyle}" Margin="0,0,6,5" Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text><MultiBinding StringFormat="{}卡{0} 模{1} · 值{2}">
                                                        <Binding Path="CardNo"/><Binding Path="ModuleNo"/><Binding Path="Value"/>
                                                    </MultiBinding></TextBlock.Text>
                                                </TextBlock>
                                                <Button Grid.Column="2" Style="{StaticResource IoOutBtn}"
                                                        Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="26" MinWidth="56" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                                    </DockPanel>
            </Border>

            <!-- ④ 点位移动和设置（占满下方区域，点位表内部滚动、列头固定） -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,8,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Path Data="{StaticResource PointIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="点位移动和设置" Style="{StaticResource SectionHeaderText}"/>
                        </StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="选择工位" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Tables}"
                                      SelectedItem="{Binding SelectedTable, Mode=TwoWay}" Width="200" Style="{StaticResource CellComboStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, FallbackValue=未命名工位}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentPoints.Count, StringFormat=共 {0} 个点位}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="0" SnapsToDevicePixels="True">
                        <DataGrid ItemsSource="{Binding CurrentPoints}"
                                  RowStyle="{StaticResource PointRowStyle}"
                                  CellStyle="{StaticResource PointCellStyle}"
                                  ColumnHeaderStyle="{StaticResource PointHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="CellOrRowHeader"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="30"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="点位名称" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Position, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Position, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Position, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Position, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="移动" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.MoveToPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtBaseBtn}" Content="移动" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="保存" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SaveCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtExcelBtn}" Content="保存" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>