<UserControl x:Class="NoCodeMotion.Views.CylinderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <local:EditorPage>
        <local:EditorPage.Detail>
            <StackPanel Margin="16" MinWidth="320">
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="输出点" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.OutPoint, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="伸出感应" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.SensorExtend, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="缩回感应" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.SensorRetract, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="动作延时(ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.DelayMs}"/>
                </DockPanel>
            </StackPanel>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
