<UserControl x:Class="NoCodeMotion.Views.AxisControllerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:svc="clr-namespace:NoCodeMotion.Services"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 本页小字说明 + 窄数字框（全局 AppStyles 无 AppleSubLabel / AppleTextFieldInline，故本地补） -->
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="MiniNumBox" TargetType="TextBox" BasedOn="{StaticResource AppleTextField}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <local:EditorPage ShowDefaultAddButton="False" EmptyHint="还没有控制器，请点击左上角的「添加控制卡」或「自动识别硬件」新增一张控制卡。">
        <local:EditorPage.LeftToolbarContent>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddCardCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="添加控制卡" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AutoDetectCommand}" Style="{StaticResource ToolButtonStyle}" ToolTip="把所有控制卡重新连一遍，并自动登记这轮检测到的硬件（换了卡、加了扩展模块之后点这个）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ControllerIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="自动识别硬件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </local:EditorPage.LeftToolbarContent>
        <local:EditorPage.Detail>
            <!-- 表单页标准做法：自身包一层 ScrollViewer 负责滚动（EditorPage 的 Detail 不给无限高上下文）。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="14,10,14,0" Padding="10,8" Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                    <DockPanel>
                        <Path Data="{StaticResource ControllerIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DetectMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左列：需要操作的部分（基本信息 / 扩展 IO / 连接） ===== -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">

                <!-- ============ 基本信息 ============ -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="基本信息"/>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="类型"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding SelectedItem.Kind}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="名称"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="品牌"/>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                      ItemsSource="{x:Static svc:Catalog.VendorNames}"
                                      SelectedItem="{Binding SelectedItem.Vendor, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="控制卡是哪个厂家出的；选错厂家会连不上"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="总线类型"/>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                      ItemsSource="{x:Static svc:Catalog.BusTypeNames}"
                                      SelectedItem="{Binding SelectedItem.BusType, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="这张卡和电脑怎么通信（插卡 / 网线 / 串口 / EtherCAT）。它还决定这张卡上的轴是什么轴类型"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="卡型号"/>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                     
                                      ItemsSource="{Binding CardTypeOptions}"
                                      SelectedItem="{Binding SelectedItem.CardType, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="这里的候选会跟着上面的「品牌 + 总线类型」自动筛选：先把品牌和接线方式选对，再来挑型号"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="卡号"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.CardNo}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="同一台电脑上这是第几张卡，从 0 开始，要和实际编号对上"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="轴数量"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.AxisCount}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="这张卡准备带几根轴。点了【连接】之后，会被卡真正报上来的数覆盖"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="连接方式"/>
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" SelectedValue="{Binding SelectedItem.Connection}" SelectedValuePath="Content">
                                <ComboBoxItem Content="PCI"/>
                                <ComboBoxItem Content="网口"/>
                                <ComboBoxItem Content="COM"/>
                                <ComboBoxItem Content="EtherCAT"/>
                            </ComboBox>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="卡和电脑怎么连：PCI = 插在电脑槽位里；网口 = 网线，还要填卡的 IP；COM = 串口线；EtherCAT = 工业以太网"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="备注"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.Description}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 扩展 IO 模块（挂在控制卡内）+ 连接 ============ -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="扩展 IO 模块"/>
                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,0,16,6" TextWrapping="Wrap"
                                   Text="先填这张卡主板自己带的 IO 点数，再往下逐个加 CAN / EtherCAT 扩展模块（选好型号后，模块自带的 IO 数和轴数会自动填进来）；加完之后「数量汇总」自动帮你算总数。"/>
                        <!-- 未选卡型号时的提示（流程：选卡型号 → 选扩展IO → 再连接） -->
                        <TextBlock Margin="16,0,16,6" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="先在上方「基本信息」里选好「卡型号」，这一栏才会让你配扩展 IO（主板 IO 数、挂哪些模块）。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanConfigureExpansion}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <!-- 未选卡型号时禁用整块扩展 IO 配置 -->
                        <StackPanel IsEnabled="{Binding CanConfigureExpansion}">
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="主板输入IO数"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.InIoCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="卡主板上接了多少个输入点（传感器那一路）"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <StackPanel><DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="主板输出IO数"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" Text="{Binding SelectedItem.OutIoCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="卡主板上接了多少个输出点（气缸阀、指示灯那一路）"/></StackPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>

                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,8,16,0" Text="已经挂上的扩展模块（型号 / 挂几个 / 每个几个输入 / 每个几个输出 / 每个带几根轴）"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.ExpansionModules}" Margin="16,4,16,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" Style="{StaticResource CellComboStyle}"
                                                          ItemsSource="{Binding DataContext.ExpansionModuleOptions, RelativeSource={RelativeSource AncestorType={x:Type local:AxisControllerPage}}}"
                                                          SelectedItem="{Binding ModuleType, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource MiniNumBox}" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource MiniNumBox}" Text="{Binding InIo, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource MiniNumBox}" Text="{Binding OutIo, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="4" Margin="4,0,0,0" Style="{StaticResource MiniNumBox}" Text="{Binding AxisCount, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="5" Style="{StaticResource TtPillRedBtn}" Margin="6,0,0,0" Content="删除"
                                                        Command="{Binding DataContext.RemoveExpansionModuleCommand, RelativeSource={RelativeSource AncestorType={x:Type local:AxisControllerPage}}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource SubLabel}" Text="模块型号"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SubLabel}" Text="数量" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource SubLabel}" Text="单入" HorizontalAlignment="Right" ToolTip="这一种模块自带几个输入点"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource SubLabel}" Text="单出" HorizontalAlignment="Right" ToolTip="这一种模块自带几个输出点"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource SubLabel}" Text="单轴" HorizontalAlignment="Right" ToolTip="这一种模块能多带几根轴"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <Button DockPanel.Dock="Left" Style="{StaticResource TtPillBlueBtn}" Content="＋ 添加扩展模块"
                                    Command="{Binding AddExpansionModuleCommand}"/>
                            <ComboBox DockPanel.Dock="Right" Width="210" Style="{StaticResource CellComboStyle}"
                                      ItemsSource="{Binding ExpansionModuleOptions}"
                                      SelectedItem="{Binding SelectedModuleType, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        </StackPanel>

                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <!-- 连接 / 获取 + 在线离线状态（真实来自底层 WenQiZhiCardBridge） -->
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="连接状态"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="10" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConnectionText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource TtPillGreenBtn}" Content="连接控制器" Margin="0,0,4,0" IsEnabled="{Binding CanConnect}" ToolTip="连上这张卡，顺便问它要真实的轴数和 IO 数（在后台连，会弹一个进度窗）" Command="{Binding ConnectControllerCommand}"/>
                                <Button Style="{StaticResource TtPillGrayBtn}" Content="断开" ToolTip="断开这张卡的连接（不影响别的卡）" Command="{Binding DisconnectCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- 连接的影响范围说明：只调数量、不改名称，免得用户以为连接会冲掉已配好的轴 / IO -->
                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,0,16,4" TextWrapping="Wrap"
                                   Text="点【连接】只会按这张卡的真实情况调整数量：多了就从末尾删掉，少了就补上默认名字。你已经改好的轴名、IO 名、功能、电平和运动参数都不会被动，别的卡上的点也不动。"/>
                        <!-- 连接进度条：点击「连接」后台执行期间显示，避免界面卡死且无反馈 -->
                <Border Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" Margin="16,4,16,6">
                    <StackPanel Orientation="Vertical">
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ConnectStatusText}" Style="{StaticResource SubLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SubLabel}" Margin="16,0,16,6" TextWrapping="Wrap" Text="{Binding ConnectMessage}"/>
                    </StackPanel>
                </Border>

                    </StackPanel>

                    <!-- ===== 右列：只读状态（连接总览 / 数量汇总 / 真实检测），无需操作 ===== -->
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <!-- ============ 底层连接总览（真实状态，来自 WenQiZhiCardBridge.ControllerStatus） ============ -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="连接总览（真机状态）"/>
                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,0,16,6" TextWrapping="Wrap"
                                   Text="下面显示每一张已经初始化过的控制卡此刻的真实就绪情况；点【连接】或【断开】之后会自动刷新。"/>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <ItemsControl ItemsSource="{Binding ConnectionStatusLines}" Margin="16,6,16,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Path DockPanel.Dock="Left" Data="{StaticResource ControllerIcon}" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatusLines.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock Style="{StaticResource SubLabel}" Text="还没有连上的控制器（在上面点【连接】之后，这里就会显示真机的真实状态）。"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ 数量汇总（自动生成） ============ -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="数量汇总（自动生成）"/>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="输入 IO 总数"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Text="{Binding TotalInIo}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="输出 IO 总数"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Text="{Binding TotalOutIo}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="轴总数"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Text="{Binding TotalAxis}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,2,16,12" TextWrapping="Wrap"
                                   Text="输入 / 输出 IO 总数 = 主板上的点数 +（每种模块的点数 × 挂了几个）；轴总数 = 卡本身的轴数 +（每种模块带的轴数 × 挂了几个）。"/>
                    </StackPanel>
                </Border>
                <!-- ============ 连接后真实检测（来自底层硬件） ============ -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="连上之后卡实际报出来的数"/>
                        <TextBlock Style="{StaticResource SubLabel}" Margin="16,0,16,6" TextWrapping="Wrap"
                                   Text="点【连接】之后从卡真正读到的轴数和 IO 数 —— 以这里为准，会盖掉上面按配置算出来的数；显示 0 = 还没连上或卡没报数。"/>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="真实轴数"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" Text="{Binding DetectedAxisCount, Mode=OneWay}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="真实输入IO"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" Text="{Binding DetectedInIo, Mode=OneWay}"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleHairline}"/>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="真实输出IO"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" Text="{Binding DetectedOutIo, Mode=OneWay}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
