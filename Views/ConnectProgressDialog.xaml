<Window x:Class="NoCodeMotion.Views.ConnectProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- 透明窗口 + 圆角 14 白卡 + 柔和阴影 = Apple 风格连接进度弹窗（与 ConfirmDialog 同款） -->
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <StackPanel MinWidth="360" MaxWidth="440">
            <!-- 标题区 -->
            <Border Padding="22,18,22,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ControllerIcon}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="正在连接控制器" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- 进度条 + 步骤文字（绑定 VM 的 ConnectStatusText / ConnectMessage） -->
            <StackPanel Margin="24,20,24,22">
                <ProgressBar IsIndeterminate="True" Height="8" Foreground="{StaticResource AccentBrush}" Background="{StaticResource HoverBrush}"/>
                <TextBlock Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22"
                           Text="{Binding ConnectStatusText}"/>
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="{Binding ConnectMessage}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
