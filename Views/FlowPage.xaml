<UserControl x:Class="NoCodeMotion.Views.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <x:Array x:Key="LogicOptions" Type="sys:String">
            <sys:String>如果</sys:String>
            <sys:String>就</sys:String>
            <sys:String>否则</sys:String>
        </x:Array>
        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>轴</sys:String>
            <sys:String>IO</sys:String>
            <sys:String>气缸</sys:String>
            <sys:String>modbus</sys:String>
        </x:Array>
        <x:Array x:Key="OperationOptions" Type="sys:String">
            <sys:String>加</sys:String>
            <sys:String>减</sys:String>
            <sys:String>乘</sys:String>
            <sys:String>除</sys:String>
            <sys:String>等于</sys:String>
            <sys:String>是否等于</sys:String>
        </x:Array>
        <local:FunctionToNamesConverter x:Key="FunctionToNamesConverter"/>
    </UserControl.Resources>

    <local:EditorPage>
        <local:EditorPage.Detail>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 步骤增删工具栏 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加步骤" Command="{Binding AddStepCommand}" Style="{StaticResource ToolButtonStyle}"/>
                    <Button Content="删除步骤" Command="{Binding DeleteStepCommand}" Style="{StaticResource ToolButtonStyle}"/>
                    <TextBlock Text="{Binding SelectedItem.Steps.Count, StringFormat=共 {0} 步}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#607080"/>
                </StackPanel>

                <!-- 步骤列表（DataGrid）。单击单元格即进入编辑并展开下拉框，无需两次点击。 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SelectedItem.Steps}"
                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderBrush="#DDE3EA" RowHeaderWidth="0"
                          PreparingCellForEdit="StepsGrid_PreparingCellForEdit"
                          PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="逻辑" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Logic}" VerticalAlignment="Center" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource LogicOptions}"
                                                 SelectedItem="{Binding Logic}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="功能" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Function}" VerticalAlignment="Center" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                                 SelectedItem="{Binding Function}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="名称" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{Binding Function, Converter={StaticResource FunctionToNamesConverter}}"
                                                 SelectedItem="{Binding Name}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="运算" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Operation}" VerticalAlignment="Center" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource OperationOptions}"
                                                 SelectedItem="{Binding Operation}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="设置值" Width="110"
                                            Binding="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="耗时(ms)" Width="90"
                                            Binding="{Binding DurationMs}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
