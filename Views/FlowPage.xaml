<UserControl x:Class="NoCodeMotion.Views.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:models="clr-namespace:NoCodeMotion.Models"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <x:Array x:Key="LogicOptions" Type="sys:String">
            <sys:String>如果</sys:String>
            <sys:String>就</sys:String>
            <sys:String>并且</sys:String>
            <sys:String>或者</sys:String>
            <sys:String>否则</sys:String>
            <sys:String>否则如果</sys:String>
            <sys:String>循环开始</sys:String>
            <sys:String>循环结束</sys:String>
            <sys:String>等待</sys:String>
            <sys:String>延时</sys:String>
            <sys:String>结束</sys:String>
            <sys:String>注释</sys:String>
        </x:Array>
        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>轴</sys:String>
            <sys:String>IO</sys:String>
            <sys:String>气缸</sys:String>
            <sys:String>点位</sys:String>
            <sys:String>modbus</sys:String>
            <sys:String>变量</sys:String>
            <sys:String>系统</sys:String>
            <sys:String>相机</sys:String>
            <sys:String>延时</sys:String>
        </x:Array>
        <x:Array x:Key="OperationOptions" Type="sys:String">
            <sys:String>修改</sys:String>
            <sys:String>加</sys:String>
            <sys:String>减</sys:String>
            <sys:String>乘</sys:String>
            <sys:String>除</sys:String>
            <sys:String>等于</sys:String>
            <sys:String>是否等于</sys:String>
            <sys:String>大于</sys:String>
            <sys:String>小于</sys:String>
            <sys:String>大于等于</sys:String>
            <sys:String>小于等于</sys:String>
            <sys:String>取反</sys:String>
            <sys:String>与</sys:String>
            <sys:String>或</sys:String>
            <sys:String>取模</sys:String>
        </x:Array>
        <x:Array x:Key="TimeoutOptions" Type="sys:String">
            <sys:String>等待1秒就统计</sys:String>
            <sys:String>等待3秒就统计</sys:String>
            <sys:String>等待5秒就统计</sys:String>
            <sys:String>空</sys:String>
            <sys:String>不停机</sys:String>
        </x:Array>
        <local:FunctionToNamesConverter x:Key="FunctionToNamesConverter"/>
        <local:FunctionToPropertiesConverter x:Key="FunctionToPropertiesConverter"/>

        <!--
            ========== 表格美化样式（与 IoPage 对齐）==========
            单元格：内边距 + 细网格线 + 透明无焦点虚框。
            行：白底 + 悬停/选中 = 浅强调；斑马纹 2 行交替（极浅 Surface）。
            表头：浅强调底 + 加粗 + 强调色 2px 下边框 + 居中。
            单元格里嵌入的 TextBox / ComboBox 全部去边框、透明、紧凑 24px。
        -->
        <Style x:Key="FlowCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlowCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- 流程页：EditorPage 宿主，顶部工具栏注入「添加运控 / 添加脚本」两个具体按钮并隐藏默认「添加」 -->
    <local:EditorPage ShowDefaultAddButton="False">
        <local:EditorPage.LeftToolbarContent>
            <StackPanel Orientation="Horizontal">
                <!-- 添加运控流程（Kind=Table） -->
                <Button Command="{Binding AddTableFlowCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="添加运控" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 添加 Lua 脚本流程（Kind=Lua，自动填默认脚本模板） -->
                <Button Command="{Binding AddScriptFlowCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="添加脚本" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 添加视觉流程（Kind=Vision）：相机 / 视觉算子 / 模板匹配 等图形节点（编辑区占位） -->
                <Button Command="{Binding AddVisionFlowCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="添加视觉" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </local:EditorPage.LeftToolbarContent>

        <local:EditorPage.Detail>
            <!-- 整体两行：标题 + 编辑器主体（主体内部按 Kind 切换表格 / Lua） -->
            <Border Background="{StaticResource CanvasBrush}">
                <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0：节标题 + 右上角当前流程类型 chip -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Style="{StaticResource SectionHeaderStyle}">
                        <Path Data="{StaticResource FlowIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="流程" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock Text="{Binding SelectedItem.Name}" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 右上角「当前类型」chip（SelectedItem.Kind：表格 / Lua 文本由 enum.ToString 直出） -->
                    <Border DockPanel.Dock="Right" Padding="10,3" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedItem.Kind}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                    </Border>
                </DockPanel>

                <!-- Row 1：编辑器主体（按 Kind 互斥可见） -->
                <Grid Grid.Row="1">

                    <!-- ============ 表格流程编辑器（Steps 表格 + 工具栏 + 执行控制栏） ============ -->
                    <Grid Visibility="{Binding IsKindTable, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 步骤表格工具栏（继承通用 TableToolbar：Excel编辑/添加/删除/上移/下移/复制/粘贴/回撤/重做）。
                             用 Grid 绑定 DataContext 到 StepPanel，使命令/计数都解析到步骤面板 VM。 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8" DataContext="{Binding StepPanel}">
                            <local:TableToolbar Count="{Binding Items.Count}" CountLabel="步"/>
                        </Grid>

                        <!-- 步骤列表（DataGrid）—— 卡片化外观 -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
                            <DataGrid ItemsSource="{Binding StepPanel.Items}"
                                      SelectedItem="{Binding StepPanel.SelectedItem, Mode=TwoWay}"
                                      RowStyle="{StaticResource FlowRowStyle}"
                                      CellStyle="{StaticResource FlowCellStyle}"
                                      ColumnHeaderStyle="{StaticResource FlowHeaderStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeight="28"
                                      FontSize="12"
                                      AlternatingRowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="逻辑" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{StaticResource LogicOptions}"
                                                          SelectedItem="{Binding Logic, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="功能" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                                          SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="名称" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- IsEditable=True：既能下拉选 Catalog 里已配置的对象名（轴/IO/气缸/通讯），
                                                     也能直接输入任意名称（模板预设值不在 Catalog 时仍可正常显示） -->
                                                <ComboBox ItemsSource="{Binding Function, Converter={StaticResource FunctionToNamesConverter}}"
                                                          Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="属性" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 属性随功能自动填充（轴→速度/位置/…、IO→输出状态/…）；
                                                     IsEditable=True 让模板预设值不在列表时也能显示 -->
                                                <ComboBox ItemsSource="{Binding Function, Converter={StaticResource FunctionToPropertiesConverter}}"
                                                          Text="{Binding Property, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="运算" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{StaticResource OperationOptions}"
                                                          SelectedItem="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="设置值" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FlowCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 专利：时序标记（相对工艺起点的触发时刻，如 T+5ms / T+0ms / 跟随） -->
                                    <DataGridTemplateColumn Header="时序标记" Width="96">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlowHeaderStyle}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding TimingMark, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FlowCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 专利：同步组（需在同一总线周期边界原子触发的多步归并为同一组，空=独立执行） -->
                                    <DataGridTemplateColumn Header="同步组" Width="96">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlowHeaderStyle}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SyncGroup, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FlowCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="超时" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{StaticResource TimeoutOptions}"
                                                          SelectedItem="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource CellComboStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="耗时(ms)" Width="90">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlowHeaderStyle}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 耗时(ms)：只读显示（执行器回填耗时，不允许编辑），统一蓝色调 -->
                                                <Border Margin="1" CornerRadius="4" Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding DurationMs}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="6,0"
                                                               Foreground="{StaticResource AccentDarkBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="实际值" Width="120">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlowHeaderStyle}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="1" CornerRadius="4" Background="{StaticResource AccentSoftBrush}">
                                                    <Grid>
                                                        <Ellipse Width="6" Height="6" Margin="6,0,0,0"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                 Fill="{StaticResource AccentBrush}"/>
                                                        <!-- 实际值：只读显示（执行器回填结果，不允许编辑），统一蓝色调 -->
                                                        <TextBlock Text="{Binding ActualValue}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="16,1,1,1"
                                                                   Padding="6,0"
                                                                   Foreground="{StaticResource AccentDarkBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 流程执行控制栏：运行 / 单步运行 / 跳到指定行 / 暂停 / 停止（固定底部） -->
                        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="运行 / 单步会按「逻辑」列跳转：如果 / 否则如果 / 否则 选择分支，循环开始 / 循环结束 重复执行；橙色行 = 当前执行行。"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="运行" Style="{StaticResource TtBaseBtn}"
                                        Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="单步运行" Style="{StaticResource TtBaseBtn}"
                                        Command="{Binding StepCommand}" IsEnabled="{Binding CanStep}" Margin="0,0,8,0"/>

                                <Button Grid.Column="2" Content="跳到选中行" Style="{StaticResource TtBaseBtn}"
                                        Command="{Binding JumpCommand}" HorizontalAlignment="Center" Margin="0,0,8,0"/>

                                <Button Grid.Column="3" Content="暂停" Style="{StaticResource TtWarnBtn}"
                                        Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Margin="0,0,8,0"/>
                                <Button Grid.Column="4" Content="停止" Style="{StaticResource TtDeleteBtn}"
                                        Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>

                                <TextBlock Grid.Column="6" Text="{Binding CurrentStepText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>

                                        <!-- ============ Lua 脚本流程编辑器（直接复用 LuaStudio 完整编辑器代码） ============ -->
                    <local:LuaEditorView LuaItem="{Binding SelectedItem}" Visibility="{Binding IsKindLua, Converter={StaticResource BoolToVis}}"/>

                    <!-- ============ 视觉流程编辑器（延迟实例化：仅当选中视觉流程才创建 VisualFlowPage，
                         避免其加载异常拖垮整页，导致表格/Lua 页也一起白屏）。
                         宿主用 ContentControl（不用 Border）：Border.Child 是 Decorator 的 CLR 属性、不是 DependencyProperty，
                         无法在 XAML 上设 Binding（会立即报 XamlParseException：不能在"Border"类型的"Child"属性上设置"Binding"）。
                         ContentControl.Content 才是 DP，可绑定。
                         关键：ContentControl【禁止 x:Name】——它位于 EditorPage.Detail（ContentControl）内容内，
                         任何命名元素都会同时注册到「EditorPage 作用域」与「ContentControl 内容作用域」两个 NameScope → MC3093。
                         改用 FlowPage 自身的 VisionContent 依赖属性 + RelativeSource 绑定承载视觉页，彻底避开 NameScope 冲突。 ============ -->
                    <ContentControl Visibility="{Binding IsKindVision, Converter={StaticResource BoolToVis}}"
                                    Content="{Binding VisionContent, RelativeSource={RelativeSource AncestorType=local:FlowPage}}"/>

                </Grid>
            </Grid>
            </Border>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
