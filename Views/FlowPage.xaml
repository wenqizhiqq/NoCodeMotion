<UserControl x:Class="NoCodeMotion.Views.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <x:Array x:Key="LogicOptions" Type="sys:String">
            <sys:String>如果</sys:String>
            <sys:String>就</sys:String>
            <sys:String>否则</sys:String>
        </x:Array>
        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>轴</sys:String>
            <sys:String>IO</sys:String>
            <sys:String>气缸</sys:String>
            <sys:String>modbus</sys:String>
        </x:Array>
        <x:Array x:Key="OperationOptions" Type="sys:String">
            <sys:String>加</sys:String>
            <sys:String>减</sys:String>
            <sys:String>乘</sys:String>
            <sys:String>除</sys:String>
            <sys:String>等于</sys:String>
            <sys:String>是否等于</sys:String>
        </x:Array>
        <x:Array x:Key="TimeoutOptions" Type="sys:String">
            <sys:String>等待3秒就统计</sys:String>
            <sys:String>空</sys:String>
            <sys:String>不停机</sys:String>
        </x:Array>
        <local:FunctionToNamesConverter x:Key="FunctionToNamesConverter"/>
        <local:FunctionToPropertiesConverter x:Key="FunctionToPropertiesConverter"/>
    </UserControl.Resources>

    <local:EditorPage>
        <local:EditorPage.Detail>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 步骤增删工具栏 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加步骤" Command="{Binding AddStepCommand}" Style="{StaticResource ToolButtonStyle}"/>
                    <Button Content="删除步骤" Command="{Binding DeleteStepCommand}" Style="{StaticResource ToolButtonStyle}"/>
                    <TextBlock Text="{Binding SelectedItem.Steps.Count, StringFormat=共 {0} 步}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#607080"/>
                </StackPanel>

                <!--
                    步骤列表（DataGrid）。
                    关键：下拉框/文本框直接内嵌在 CellTemplate 中、一直可交互，DataGrid 设为 IsReadOnly
                    不再接管单元格编辑，因此：
                      1) 点一下即展开下拉，无需两次点击；
                      2) 已展开某列下拉时，点击其它列是「同一次点击」直接切换，不再需要点两次。
                -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SelectedItem.Steps}"
                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderBrush="#DDE3EA" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="逻辑" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource LogicOptions}"
                                                 SelectedItem="{Binding Logic, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="功能" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                                 SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="名称" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{Binding Function, Converter={StaticResource FunctionToNamesConverter}}"
                                                 SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="属性" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{Binding Function, Converter={StaticResource FunctionToPropertiesConverter}}"
                                                 SelectedItem="{Binding Property, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="运算" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource OperationOptions}"
                                                 SelectedItem="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="设置值" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="超时" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ComboBox ItemsSource="{StaticResource TimeoutOptions}"
                                                 SelectedItem="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="耗时(ms)" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
