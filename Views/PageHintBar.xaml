<UserControl x:Class="NoCodeMotion.Views.PageHintBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="64" d:DesignWidth="900">

    <!-- 页面底部「操作说明 + 注意事项」栏：浅色、贴底、可换行，不随内容滚动。 -->
    <Border Background="#F1F5F9"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
            Padding="14,8">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="操作：" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#64748B" VerticalAlignment="Top" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" Text="{Binding OperationText, RelativeSource={RelativeSource AncestorType=local:PageHintBar}}"
                           TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                           Foreground="#0F172A" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="注意：" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#DC2626" VerticalAlignment="Top" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" Text="{Binding PrecautionText, RelativeSource={RelativeSource AncestorType=local:PageHintBar}}"
                           TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                           Foreground="#0F172A" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
