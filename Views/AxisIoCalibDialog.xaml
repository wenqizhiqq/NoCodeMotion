<Window x:Class="NoCodeMotion.Views.AxisIoCalibDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轴IO标定（3D 仿真）" Height="520" Width="660" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="轴IO标定（3D 仿真）" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="给每根轴指认一下：正限位、负限位、原点开关分别是哪个输入点，使能是哪个输出点；" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="标好之后点【生成3D模型】，机台行程的两端就会画出这些传感器（绿色 = 这个信号现在有效）。" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <Grid x:Name="RowsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="清除全部" Style="{StaticResource TtGrayBtn}" Width="90" Click="ClearButton_Click"/>
            <Button Content="保存" Style="{StaticResource TtBaseBtn}" Width="90" Margin="8,0,0,0" Click="SaveButton_Click"/>
            <Button Content="取消" Style="{StaticResource TtGrayBtn}" Width="90" Margin="8,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
