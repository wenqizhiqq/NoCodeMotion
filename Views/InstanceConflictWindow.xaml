<Window x:Class="NoCodeMotion.Views.InstanceConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测到软件已在运行"
        Width="440" Height="200" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="#FFF3F3F3" FontFamily="Microsoft YaHei">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" Foreground="#C0392B"
                   Text="检测到「NoCodeMotion」已在运行"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" Foreground="#333"
                   Text="同一时间只能运行一个本软件。&#10;是否关闭正在运行的其它实例并以本窗口继续？&#10;（选择「取消打开」将不会打开本软件）"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnContinue" Content="关闭其它并打开" Width="140" Height="36" Margin="0,0,12,0"
                    Click="Continue_Click" Background="#2E86DE" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="BtnCancel" Content="取消打开" Width="110" Height="36"
                    Click="Cancel_Click" Background="#E0E0E0" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
