<Window x:Class="NoCodeMotion.Views.ClosingProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在退出"
        Width="420" Height="170" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" FontFamily="Microsoft YaHei">
    <Border Margin="14" CornerRadius="20" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            Effect="{StaticResource SoftShadow}">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="正在退出，请稍候…"/>
            <ProgressBar x:Name="_bar" Grid.Row="1" Height="8" Margin="0,16,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}"
                         BorderThickness="0" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="_status" Grid.Row="2" Margin="0,12,0,0" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="正在释放资源…"/>
        </Grid>
    </Border>
</Window>
