<UserControl x:Class="NoCodeMotion.Views.PointPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:svc="clr-namespace:NoCodeMotion.Services"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- ===== 8 个轴列头模板：在 HeaderTemplate 内用 RelativeSource 找 DataGrid，
             再取 AxisStates[i].AxisName + 后缀（位置/速度）；空轴名回退"未选轴" ===== -->
        <DataTemplate x:Key="H0Pos">
            <TextBlock TextAlignment="Center" ToolTip="第 1 个所选轴的目标位置；上方选轴后此处显示轴名。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[0].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H0Spd">
            <TextBlock TextAlignment="Center" ToolTip="第 1 个所选轴的目标速度。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[0].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Pos">
            <TextBlock TextAlignment="Center" ToolTip="第 2 个所选轴的目标位置；上方选轴后此处显示轴名。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[1].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H1Spd">
            <TextBlock TextAlignment="Center" ToolTip="第 2 个所选轴的目标速度。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[1].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Pos">
            <TextBlock TextAlignment="Center" ToolTip="第 3 个所选轴的目标位置；上方选轴后此处显示轴名。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[2].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H2Spd">
            <TextBlock TextAlignment="Center" ToolTip="第 3 个所选轴的目标速度。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[2].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Pos">
            <TextBlock TextAlignment="Center" ToolTip="第 4 个所选轴的目标位置；上方选轴后此处显示轴名。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[3].AxisName"/>
                    <Binding Source="位置"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="H3Spd">
            <TextBlock TextAlignment="Center" ToolTip="第 4 个所选轴的目标速度。">
                <TextBlock.Text><MultiBinding Converter="{StaticResource AxisHeaderMulti}">
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.AxisStates[3].AxisName"/>
                    <Binding Source="速度"/></MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <!-- 编译时序结果：严重度彩色圆点 + 正文 -->
        <Style x:Key="IssueDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static svc:TimingSeverity.Warning}">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static svc:TimingSeverity.Error}">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IssueMsgStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static svc:TimingSeverity.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static svc:TimingSeverity.Error}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== 左侧：点位表（工位）列表 ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,10">
                    <TextBlock Text="点位表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="一个点位表即一个工位，各自保存 4 轴与点位数据；点条目切换。"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="8,0,8,10">
                    <Button Command="{Binding AddCommand}" Style="{StaticResource TtPillBlueBtn}" Content="新增工位"
                            ToolTip="新增一个点位表（工位），默认带 1 行点位。"/>
                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource TtPillRedBtn}" Content="删除工位"
                            ToolTip="删除当前选中的工位，删除前会弹窗确认。"/>
                </UniformGrid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Items.Count, StringFormat=共 {0} 个工位}"
                           Margin="14,8,14,12" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Style="{StaticResource ProjectListStyle}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" MinHeight="20">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Points.Count, StringFormat={}{0} 点}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== 右侧：当前工位的轴控制 + 点位列表 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 空状态：一个工位都没有时的提示 -->
            <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       Text="左侧还没有点位表。点「新增工位」创建第一个工位。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTable}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 主内容：上=轴控制区（Auto），下=点位表（* 占满、内部滚动、列头固定） -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Grid.Row="0" Margin="12,10,12,0">

                    <!-- ===== 当前工位标题与重命名 ===== -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource PointIcon}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="当前工位的 4 个轴与逐行点位数据；切换左侧工位即切换此处内容。"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <DockPanel LastChildFill="False" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="工位名称" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox DockPanel.Dock="Left" Width="200" Height="30" VerticalContentAlignment="Center"
                                     Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="修改当前工位的名称，左侧列表会同步更新。"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- ===== 轴控制 ===== -->
                    <TextBlock Text="轴控制" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                    <TextBlock Text="为 4 个槽位各选一个轴，进行使能 / 回原 / 寸动 / JOG。选择仅作用于当前工位。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding AxisStates}" ItemTemplate="{StaticResource AxisCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>


                    <!-- ===== 点位列表 ===== -->
                    <TextBlock Text="点位列表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,4"/>
                    <TextBlock Text="每行一个点位：名称 + 4 轴目标位置 + 4 轴目标速度（列头显示轴名）。行末「移动」移到该点位，「保存」存回当前位置。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- 工具栏：添加 / 删除点位（作用于当前工位） -->
                    <Border Style="{StaticResource ToolbarStyle}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddPointCommand}" Style="{StaticResource TtPillBlueBtn}" ToolTip="在当前工位下新增一行点位。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource AddIcon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <TextBlock Text="添加点位" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportDxfCommand}" Style="{StaticResource TtPillBlueBtn}" ToolTip="从 DXF 图形文件导入几何生成点位行：轴1/轴2 ← DXF X/Y，轴3/轴4 留 0，采样步长 5mm。追加到当前工位末尾。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ImportIcon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <TextBlock Text="导入DXF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeletePointCommand}" Style="{StaticResource TtPillRedBtn}" ToolTip="删除表格中选中的那一行点位。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DeleteIcon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <TextBlock Text="删除点位" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CompileCommand}" Style="{StaticResource TtPillGrayBtn}" ToolTip="编译当前工位的时序标记与同步组，检测同周期 / 分辨率 / 资源争用冲突。">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CheckIcon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <TextBlock Text="编译时序" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding CurrentPoints.Count, StringFormat=共 {0} 个点位}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 点位表：占满剩余高度，使用自身内部滚动条，列头固定不随页面滚动 -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True" Margin="12,0,12,12">
                        <DataGrid ItemsSource="{Binding CurrentPoints}"
                                  SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                  RowStyle="{StaticResource PointRowStyle}"
                                  CellStyle="{StaticResource PointCellStyle}"
                                  ColumnHeaderStyle="{StaticResource PointHeaderStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="CellOrRowHeader"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="26"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="点位名称" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 时序标记：相对工艺起点的触发时刻（T+0ms / T+5ms），对应专利「时序标记」列 -->
                                <DataGridTemplateColumn Header="时序标记" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TimingMark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}" ToolTip="相对工艺起点的触发时刻，如 T+0ms / T+5ms。"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 先排 4 个轴的目标位置 -->
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Pos}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 最后排 4 个轴的目标速度 -->
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H0Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[0].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H1Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[1].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H2Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[2].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn HeaderTemplate="{StaticResource H3Spd}" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Positions[3].Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 同步组：同组动作同一 DC 周期原子执行（GroupA…），对应专利「同步组」列 -->
                                <DataGridTemplateColumn Header="同步组" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SyncGroup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PointCellTextBoxStyle}" ToolTip="同步组标识（如 GroupA），同组动作同一时刻原子执行；留空表示独立执行。"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 行操作：移动到该点位 / 保存当前位置到此行（iOS 染色药丸） -->
                                <DataGridTemplateColumn Header="移动" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.MoveToPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtPillBlueBtn}" Content="移动" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="保存" Width="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SaveCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TtPillGreenBtn}" Content="保存" Margin="3,0" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 编译时序结果面板：点击「编译时序」后显示同周期/分辨率/资源争用冲突 -->
                <Border Grid.Row="1" Padding="12" Margin="12,0,12,12">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompiled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="编译时序结果" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CompileSummary}" FontSize="12.5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompileIssues}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding CompileIssues}" BorderThickness="0" Background="Transparent" MaxHeight="220">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCompileIssues}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Style="{StaticResource IssueDotStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PointName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource IssueMsgStyle}" Text="{Binding Message}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

            <!-- ===================== 右上角：轨迹仿真面板（始终显示） ===================== -->
            <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Width="252" Panel.ZIndex="20"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <!-- 标题栏 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                        <Path Data="{StaticResource PointIcon}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="轨迹仿真" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 控制条（始终可见） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Command="{Binding SimPlayCommand}" Style="{StaticResource TtPillBlueBtn}" Width="34" Height="34" MinWidth="0" Padding="0" ToolTip="仿真：按点位顺序演示轨迹动画">
                            <Path Data="{StaticResource PlayIcon}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </Button>
                        <Button Command="{Binding SimStopCommand}" Style="{StaticResource TtPillGrayBtn}" Width="34" Height="34" MinWidth="0" Padding="0" ToolTip="停止仿真">
                            <Path Data="{StaticResource StopIcon}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </Button>
                        <Button Command="{Binding SimResetCommand}" Style="{StaticResource TtPillGrayBtn}" Width="34" Height="34" MinWidth="0" Padding="0" ToolTip="回到起点">
                            <Path Data="{StaticResource RefreshIcon}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </Button>
                        <Button Command="{Binding SimLoopCommand}" Width="34" Height="34" MinWidth="0" Padding="0" Margin="4,0" ToolTip="循环播放">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TtPillGrayBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimLoop}" Value="True">
                                            <Setter Property="Background" Value="#E5F1FF"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource LoopIcon}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </Button>
                    </StackPanel>

                    <!-- 画布 + 速度 + 读数 -->
                    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Height="180" Margin="0,6,0,0">
                            <Viewbox Stretch="Uniform" Margin="6">
                                <Canvas Width="100" Height="100">
                                    <!-- 轨迹折线 -->
                                    <Path Data="{Binding SimTrajectory}" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                    <!-- 点位（高亮当前目标） -->
                                    <ItemsControl ItemsSource="{Binding SimPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform X="-3" Y="-3"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse Width="7" Height="7" Stroke="White" StrokeThickness="1">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                        <Setter Property="Width" Value="11"/>
                                                                        <Setter Property="Height" Value="11"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Index}" FontSize="5.5" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 运动标记 -->
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" Stroke="White" StrokeThickness="2"
                                             Canvas.Left="{Binding SimMarkerX}" Canvas.Top="{Binding SimMarkerY}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-5" Y="-5"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- 速度 -->
                    <DockPanel LastChildFill="True" Margin="0,8,0,2" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="速度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SimSpeed, StringFormat={}{0:0.00}x}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Slider Minimum="0.25" Maximum="3" TickFrequency="0.25" Value="{Binding SimSpeed}"
                                SmallChange="0.25" LargeChange="0.5" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 读数 -->
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="目标 {0}　X={1:0.##}　Y={2:0.##}">
                                <Binding Path="SimActiveIndex" Converter="{StaticResource SimIndexConv}"/>
                                <Binding Path="SimLiveX"/>
                                <Binding Path="SimLiveY"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        <local:PageHintBar Grid.Row="1" Grid.ColumnSpan="2" OperationText="上方选轴，下方表格填写各轴目标坐标与速度；「新增工位 / 删除工位」管理；可导出导入。右上角「仿真」按点位顺序动画演示运动轨迹。" PrecautionText="首点位建议留安全位；运行前空跑验证轨迹防止撞机；坐标单位与轴配置保持一致。"/>
    </Grid>
</UserControl>