<UserControl x:Class="NoCodeMotion.Views.IoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:NoCodeMotion.ViewModels"
             xmlns:model="clr-namespace:NoCodeMotion.Models"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:conv="clr-namespace:NoCodeMotion.Views"
             xmlns:svc="clr-namespace:NoCodeMotion.Services"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <x:Array x:Key="LevelOptions" Type="sys:String">
            <sys:String>取反</sys:String>
            <sys:String>原点</sys:String>
        </x:Array>

        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>动点</sys:String>
            <sys:String>原点</sys:String>
            <sys:String>光栅</sys:String>
            <sys:String>安全门</sys:String>
            <sys:String>启动按钮</sys:String>
            <sys:String>复位按钮</sys:String>
            <sys:String>停止按钮</sys:String>
            <sys:String>急停按钮</sys:String>
            <sys:String>到位点</sys:String>
        </x:Array>

        <Style x:Key="IoCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IoSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <conv:IoRuntimeStateConverter x:Key="IoRuntimeState"/>
        <conv:IoRuntimeBrushConverter x:Key="IoRuntimeBrush"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============== 输入 IO 面板 ============== -->
        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,4,0">
            <StackPanel DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                <Path Data="{StaticResource SectionIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="输入IO" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>

            <!-- 工具栏（继承通用 TableToolbar），用 Grid 绑定 DataContext 到 InputPanel，使命令解析到面板 VM -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding InputPanel}">
                <local:TableToolbar Count="{Binding Items.Count}"/>
            </Grid>

            <!-- IO 表格（白色卡片包裹） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <DataGrid x:Name="InputGrid" ItemsSource="{Binding InputPanel.Items}"
                          SelectedItem="{Binding InputPanel.SelectedItem, Mode=TwoWay}"
                          RowStyle="{StaticResource IoRowStyle}"
                          CellStyle="{StaticResource IoCellStyle}"
                          ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionMode="Single" SelectionUnit="CellOrRowHeader"
                          RowHeight="30"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTemplateColumn Header="控制器" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static svc:Catalog.ControllerNames}"
                                              SelectedItem="{Binding Controller, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTemplateColumn Header="电平" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="功能" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ============== 输出 IO 面板 ============== -->
        <DockPanel Grid.Column="1" Grid.Row="0" Margin="4,0,0,0">
            <StackPanel DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                <Path Data="{StaticResource SectionIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="输出IO" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding OutputPanel}">
                <local:TableToolbar Count="{Binding Items.Count}"/>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <DataGrid x:Name="OutputGrid" ItemsSource="{Binding OutputPanel.Items}"
                          SelectedItem="{Binding OutputPanel.SelectedItem, Mode=TwoWay}"
                          RowStyle="{StaticResource IoRowStyle}"
                          CellStyle="{StaticResource IoCellStyle}"
                          ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionMode="Single" SelectionUnit="CellOrRowHeader"
                          RowHeight="30"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTemplateColumn Header="控制器" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static svc:Catalog.ControllerNames}"
                                              SelectedItem="{Binding Controller, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80" EditingElementStyle="{StaticResource IoCellTextBoxStyle}"/>
                        <DataGridTemplateColumn Header="电平" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="功能" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50" IsReadOnly="True"/>
                        <!-- 运行时：仿真播放时按 SimRuntime 输出状态实时高亮（置位绿/复位灰） -->
                        <DataGridTemplateColumn Header="运行时" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Margin="6,3" Height="20" Width="40" HorizontalAlignment="Center"
                                            Background="{Binding Name, Converter={StaticResource IoRuntimeBrush}}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource IoRuntimeState}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
        <local:PageHintBar Grid.Row="1" Grid.ColumnSpan="2" OperationText="选择 IO 点后设置名称、方向、电平、对应轴或气缸；「添加 / 删除」管理点位；输出点可在调试页手动触发。" PrecautionText="接线前确认负载避免短路；输入滤波时间影响响应，误触发时适当加大；输出点勿带大功率直接驱动。"/>
    </Grid>
</UserControl>