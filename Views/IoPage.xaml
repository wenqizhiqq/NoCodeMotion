<UserControl x:Class="NoCodeMotion.Views.IoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:NoCodeMotion.ViewModels"
             xmlns:model="clr-namespace:NoCodeMotion.Models"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="#FFFFFF">

    <UserControl.Resources>
        <!-- 共同的下拉选项资源 -->
        <x:Array x:Key="CardTypeOptions" Type="sys:String">
            <sys:String>雷赛</sys:String>
            <sys:String>固高</sys:String>
            <sys:String>众为兴</sys:String>
            <sys:String>汇川</sys:String>
            <sys:String>正弦</sys:String>
            <sys:String>维宏</sys:String>
        </x:Array>

        <x:Array x:Key="LevelOptions" Type="sys:String">
            <sys:String>取反</sys:String>
            <sys:String>原点</sys:String>
        </x:Array>

        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>动点</sys:String>
            <sys:String>原点</sys:String>
            <sys:String>光栅</sys:String>
            <sys:String>安全门</sys:String>
            <sys:String>启动按钮</sys:String>
            <sys:String>复位按钮</sys:String>
            <sys:String>停止按钮</sys:String>
            <sys:String>急停按钮</sys:String>
            <sys:String>到位点</sys:String>
        </x:Array>

        <x:Array x:Key="IoNamePrefixOptions" Type="sys:String">
            <sys:String>感应器</sys:String>
            <sys:String>out</sys:String>
            <sys:String>按钮</sys:String>
            <sys:String>光电</sys:String>
            <sys:String>气缸</sys:String>
        </x:Array>

        <!-- 小号文本框样式 -->
        <Style x:Key="CellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 小号数字框样式 -->
        <Style x:Key="CellIntBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CellTextBoxStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- 小号下拉框样式 -->
        <Style x:Key="CellComboStyle" TargetType="hc:ComboBox">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- DataGrid 单元格样式（无 padding、无边框） -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 行样式（高亮偶数行） -->
        <Style x:Key="IoDataGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#C8F2C4"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="0">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 标题样式 -->
        <Style x:Key="IoHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EDF5"/>
            <Setter Property="Foreground" Value="#2B3A4B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- 标题样式 -->
        <Style x:Key="IoSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B3A4B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 顶部工具栏小按钮（蓝底白字） -->
        <Style x:Key="IoToolBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3F8EF7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B6AE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A9C2E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoExcelBtnStyle" TargetType="Button" BasedOn="{StaticResource IoToolBtnStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D8B40"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoDeleteBtnStyle" TargetType="Button" BasedOn="{StaticResource IoToolBtnStyle}">
            <Setter Property="Background" Value="#F66E6E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E04D4D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============== 输入 IO 面板 ============== -->
        <DockPanel Grid.Column="0" Margin="0,0,4,0">
            <TextBlock DockPanel.Dock="Top" Text="输入IO" Style="{StaticResource IoSectionTitleStyle}"/>

            <!-- 工具栏 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStyle}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Excel编辑" Style="{StaticResource IoExcelBtnStyle}"
                            Command="{Binding DataContext.ExcelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="添加" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.AddCommand}"/>
                    <Button Content="删除" Style="{StaticResource IoDeleteBtnStyle}" Command="{Binding InputPanel.DeleteCommand}"/>
                    <Button Content="上移" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.MoveUpCommand}"/>
                    <Button Content="下移" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.MoveDownCommand}"/>
                    <Button Content="复制" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.CopyCommand}"/>
                    <Button Content="粘贴" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.PasteCommand}"/>
                    <Button Content="回撤" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.UndoCommand}"/>
                    <Button Content="重做" Style="{StaticResource IoToolBtnStyle}" Command="{Binding InputPanel.RedoCommand}"/>
                    <TextBlock Text="{Binding InputPanel.Items.Count, StringFormat=共 {0} 项}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#607080"/>
                </StackPanel>
            </Border>

            <!-- IO 表格 -->
            <DataGrid ItemsSource="{Binding InputPanel.Items}"
                      SelectedItem="{Binding InputPanel.SelectedItem, Mode=TwoWay}"
                      AlternationCount="2"
                      RowStyle="{StaticResource IoDataGridRowStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderBrush="#DDE3EA"
                      BorderThickness="1"
                      Background="White"
                      IsReadOnly="True"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80"/>
                    <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60"/>
                    <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60"/>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80"/>
                    <DataGridTemplateColumn Header="电平" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="气缸" Binding="{Binding Cylinder}" Width="90"/>
                    <DataGridTemplateColumn Header="功能" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ============== 输出 IO 面板 ============== -->
        <DockPanel Grid.Column="1" Margin="4,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="输出IO" Style="{StaticResource IoSectionTitleStyle}"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStyle}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Excel编辑" Style="{StaticResource IoExcelBtnStyle}"
                            Command="{Binding DataContext.ExcelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="添加" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.AddCommand}"/>
                    <Button Content="删除" Style="{StaticResource IoDeleteBtnStyle}" Command="{Binding OutputPanel.DeleteCommand}"/>
                    <Button Content="上移" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.MoveUpCommand}"/>
                    <Button Content="下移" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.MoveDownCommand}"/>
                    <Button Content="复制" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.CopyCommand}"/>
                    <Button Content="粘贴" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.PasteCommand}"/>
                    <Button Content="回撤" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.UndoCommand}"/>
                    <Button Content="重做" Style="{StaticResource IoToolBtnStyle}" Command="{Binding OutputPanel.RedoCommand}"/>
                    <TextBlock Text="{Binding OutputPanel.Items.Count, StringFormat=共 {0} 项}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#607080"/>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding OutputPanel.Items}"
                      SelectedItem="{Binding OutputPanel.SelectedItem, Mode=TwoWay}"
                      AlternationCount="2"
                      RowStyle="{StaticResource IoDataGridRowStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderBrush="#DDE3EA"
                      BorderThickness="1"
                      Background="White"
                      IsReadOnly="True"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80"/>
                    <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60"/>
                    <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60"/>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80"/>
                    <DataGridTemplateColumn Header="电平" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="气缸" Binding="{Binding Cylinder}" Width="90"/>
                    <DataGridTemplateColumn Header="功能" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>