<UserControl x:Class="NoCodeMotion.Views.IoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <local:EditorPage>
        <local:EditorPage.Detail>
            <StackPanel Margin="16" MinWidth="320">
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="点位类型" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.IoType}" SelectedValuePath="Content">
                        <ComboBoxItem Content="输入"/>
                        <ComboBoxItem Content="输出"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="板卡号" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.CardNo}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="端口号" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.PortNo}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="当前状态" Style="{StaticResource FieldLabel}"/>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding SelectedItem.State}"/>
                </DockPanel>
            </StackPanel>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
