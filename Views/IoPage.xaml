<UserControl x:Class="NoCodeMotion.Views.IoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:NoCodeMotion.ViewModels"
             xmlns:model="clr-namespace:NoCodeMotion.Models"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <x:Array x:Key="LevelOptions" Type="sys:String">
            <sys:String>取反</sys:String>
            <sys:String>原点</sys:String>
        </x:Array>

        <x:Array x:Key="FunctionOptions" Type="sys:String">
            <sys:String>动点</sys:String>
            <sys:String>原点</sys:String>
            <sys:String>光栅</sys:String>
            <sys:String>安全门</sys:String>
            <sys:String>启动按钮</sys:String>
            <sys:String>复位按钮</sys:String>
            <sys:String>停止按钮</sys:String>
            <sys:String>急停按钮</sys:String>
            <sys:String>到位点</sys:String>
        </x:Array>

        <Style x:Key="IoCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="IoCellComboStyle" TargetType="hc:ComboBox">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="IoCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IoSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B3A4B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============== 输入 IO 面板 ============== -->
        <DockPanel Grid.Column="0" Margin="0,0,4,0">
            <StackPanel DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                <Path Data="{StaticResource SectionIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="输入IO" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>

            <!-- 工具栏（继承通用 TableToolbar），用 Grid 绑定 DataContext 到 InputPanel，使命令解析到面板 VM -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding InputPanel}">
                <local:TableToolbar Count="{Binding Items.Count}"/>
            </Grid>

            <!-- IO 表格 -->
            <DataGrid ItemsSource="{Binding InputPanel.Items}"
                      SelectedItem="{Binding InputPanel.SelectedItem, Mode=TwoWay}"
                      AlternationCount="2"
                      RowStyle="{StaticResource IoRowStyle}"
                      CellStyle="{StaticResource IoCellStyle}"
                      ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderBrush="#DDE3EA"
                      BorderThickness="1"
                      Background="White"
                      IsReadOnly="True"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80"/>
                    <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60"/>
                    <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60"/>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80"/>
                    <DataGridTemplateColumn Header="电平" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource IoCellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="功能" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource IoCellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ============== 输出 IO 面板 ============== -->
        <DockPanel Grid.Column="1" Margin="4,0,0,0">
            <StackPanel DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                <Path Data="{StaticResource SectionIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="输出IO" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding OutputPanel}">
                <local:TableToolbar Count="{Binding Items.Count}"/>
            </Grid>

            <DataGrid ItemsSource="{Binding OutputPanel.Items}"
                      SelectedItem="{Binding OutputPanel.SelectedItem, Mode=TwoWay}"
                      AlternationCount="2"
                      RowStyle="{StaticResource IoRowStyle}"
                      CellStyle="{StaticResource IoCellStyle}"
                      ColumnHeaderStyle="{StaticResource IoHeaderStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderBrush="#DDE3EA"
                      BorderThickness="1"
                      Background="White"
                      IsReadOnly="True"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="卡类" Binding="{Binding CardType}" Width="80"/>
                    <DataGridTextColumn Header="卡号" Binding="{Binding CardNo}" Width="60"/>
                    <DataGridTextColumn Header="模块" Binding="{Binding ModuleNo}" Width="60"/>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="IO名称" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="套码" Binding="{Binding SuitCode}" Width="80"/>
                    <DataGridTemplateColumn Header="电平" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource LevelOptions}"
                                             SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource IoCellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="功能" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ComboBox ItemsSource="{StaticResource FunctionOptions}"
                                             SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource IoCellComboStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>