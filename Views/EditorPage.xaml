<UserControl x:Class="NoCodeMotion.Views.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:models="clr-namespace:NoCodeMotion.Models"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 复位角色标签：紧凑橙色药丸，仅在 Role==Reset 时显示 -->
        <Style x:Key="FlowResetChipStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:FlowRole.Reset}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 流程状态芯片：右侧「运行中 / 暂停 / 断点 / 异常 / 停止 / 就绪」单字符指示。
             默认可见（Idle = 浅灰「就绪」），按 Status 切色：
             Idle=浅灰 / Running=绿 / Paused=橙 / Breakpoint=红 / Exception=深红 / Stopped=深灰。
             这样列表项右侧始终有指示，一眼能看出流程是否在运行、是否已停、是否异常。 -->
        <!--
            流程状态芯片：右侧「就绪/运行/暂停/断点/异常/停止」指示。
            关键：默认 Collapsed（不是 Visible）。非 FlowItem（轴/IO/气缸/控制器/点位/通讯/料盘/相机/变量）
            没有 Status 属性，binding 失败 → TextBlock 回退显示整个 data context 的 ToString()，
            渲染出 "NoCodeMotion.Models.AxisController" 这种 .NET 类名。
            默认 Collapsed + 仅 6 个 FlowStatus 枚举值显式展开（每个 DataTrigger 都设 Visibility=Visible），
            非 FlowItem 的 6 个 DataTrigger 都不命中 → 保持 Collapsed，干净。
        -->
        <Style x:Key="FlowStatusChipStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Idle}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Running}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#10B981"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Paused}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Breakpoint}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Exception}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:FlowStatus.Stopped}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#6B7280"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 左侧列表项模板：左侧按需并排显示「流程类型图标 + 复位药丸」，
             右侧显示「流程状态芯片」(非 FlowItem 没有 Role/Kind/Status，全部默认 Collapsed)。
             名称夹在中间。 -->
        <DataTemplate x:Key="EditorListItemTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左 1：图标 + 复位药丸 水平组合 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"
                          VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Data" Value="{StaticResource TableIconGeometry}"/>
                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FlowKind.Table}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource TableIconGeometry}"/>
                                        <Setter Property="Fill" Value="#2563EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FlowKind.Lua}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource ScriptIconGeometry}"/>
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FlowKind.Vision}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource VisionIconGeometry}"/>
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FlowKind.NodeGraph}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource NodeGraphIconGeometry}"/>
                                        <Setter Property="Fill" Value="#8E44AD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Border Margin="0,0,6,0" Style="{StaticResource FlowResetChipStyle}">
                        <TextBlock Text="复位" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 左 2：流程名称 -->
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- 右：流程状态芯片（运/暂/断/异/停） -->
                <Border Grid.Column="2" Style="{StaticResource FlowStatusChipStyle}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource FlowStatusLabel}}"
                               FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：添加 / 删除 / 重命名 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <StackPanel Orientation="Horizontal">
                <!-- 注入的额外左侧按钮（流程页用：添加运控 / 添加脚本） -->
                <ContentPresenter Content="{Binding LeftToolbarContent, RelativeSource={RelativeSource AncestorType=local:EditorPage}}"/>

                <!-- 默认「添加」按钮：宿主页设置 ShowDefaultAddButton=false 时隐藏 -->
                <Button Command="{Binding AddCommand}"
                        Visibility="{Binding ShowDefaultAddButton, RelativeSource={RelativeSource AncestorType=local:EditorPage}, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="添加" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 删除：破坏性操作，统一红色（全局约定：所有删除/清空按钮红色） -->
                <Button Command="{Binding DeleteCommand}" Style="{StaticResource TtDeleteBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource DeleteIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="删除" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenameCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RenameIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="{Binding RenameButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Items.Count, StringFormat=共 {0} 项}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 左列表 + 右详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--
                直接 StaticResource：之前用 Binding + FallbackValue 在 WPF 里遇到 "FallbackValue 的
                {StaticResource} 解析失败" 边角问题，部分页面会显示 data context ToString（类名）。
                改成直接引用后默认模板稳生效。气缸页等需要换行模板的页面，通过 LeftListItemTemplate DP
                在代码后端覆盖（见 EditorPage.xaml.cs 的 OnLeftListItemTemplateChanged 回调）。
            -->
            <ListBox x:Name="ListBox" Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Style="{StaticResource ProjectListStyle}"
                     ItemTemplate="{StaticResource EditorListItemTemplate}"/>

            <!-- 注意：不要在这里套 ScrollViewer。套了会给 Detail 无限高上下文，
                 使 FlowPage 内 Grid.Row=2 Height=* 的表格无法被约束高度、整表被撑开，
                 滚动条就会跑到列表外面（包着整页）。
                 Detail 由 Border 约束到 EditorPage 的 * 行高度；
                 表格型页（FlowPage）用自身 * 行内部滚动；
                 表单型页（Axis/Comm/Cylinder/Tray）各自包一层 ScrollViewer 负责滚动。 -->
            <Border Grid.Column="1" Style="{StaticResource DetailPanelStyle}">
                <ContentControl Content="{Binding Detail, RelativeSource={RelativeSource AncestorType=local:EditorPage}}"/>
            </Border>
        </Grid>

        <!-- 底部「操作说明 + 注意事项」栏：贴底、不随内容滚动；文案由各子页通过 HintOperation / HintPrecaution 设置。 -->
        <local:PageHintBar Grid.Row="2" Grid.ColumnSpan="2"
                           OperationText="{Binding HintOperation, RelativeSource={RelativeSource AncestorType=local:EditorPage}}"
                           PrecautionText="{Binding HintPrecaution, RelativeSource={RelativeSource AncestorType=local:EditorPage}}"/>
    </Grid>
</UserControl>
