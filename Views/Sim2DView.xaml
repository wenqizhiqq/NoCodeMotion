<UserControl x:Class="NoCodeMotion.Views.Sim2DView"
             x:Name="Root2D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:bhv="clr-namespace:NoCodeMotion.Behaviors"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="560">

    <!-- 2D 运控仿真（俯视）：画布 + 点动/回零/停止 + 倍率 + 轨迹 + IO/气缸/相机状态 -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 俯视画布 ============ -->
        <Border Grid.Row="0" Background="{StaticResource CanvasBrush}" CornerRadius="8"
                ClipToBounds="True" Margin="0,0,0,10">
            <Canvas x:Name="Cv" ClipToBounds="True">
                <Canvas x:Name="CvGrid"/>
                <!-- 自动生成的布局层：料盘阵列 / 吸嘴方阵 / 轴IO传感器 -->
                <Canvas x:Name="CvLayout"/>
                <!-- 软限位行程框 -->
                <Rectangle x:Name="RcLimit" Stroke="#94A3B8" StrokeThickness="1.2"
                           StrokeDashArray="4 3" Fill="#14000000" RadiusX="6" RadiusY="6"/>
                <!-- X 导轨（行程框底边） / Y 横梁（随 X 移动） -->
                <Rectangle x:Name="RcRailX" Fill="#94A3B8" RadiusX="3" RadiusY="3" Height="8"/>
                <Rectangle x:Name="RcBeamY" Fill="#64748B" RadiusX="3" RadiusY="3" Width="14"/>
                <!-- 轨迹线 -->
                <Polyline x:Name="PlTrace" Stroke="#2563EB" StrokeThickness="1.6" Opacity="0.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- 刀头：外圈=位置，内芯大小=Z -->
                <Ellipse x:Name="ElHead" Width="18" Height="18" Fill="#2563EB"
                         Stroke="#FFFFFF" StrokeThickness="2"/>
                <Ellipse x:Name="ElHeadCore" Width="6" Height="6" Fill="#FFFFFF"/>
                <!-- 网格步距标签 -->
                <TextBlock x:Name="TbGridStep" FontSize="10" Foreground="#94A3B8" Canvas.Left="8" Canvas.Bottom="4"/>
            </Canvas>
        </Border>

        <!-- ============ 控制区 ============ -->
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 点动十字键：按住连动，松开停止 -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="1" Content="Y＋" Style="{StaticResource TtGrayBtn}" FontSize="12" Padding="0"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="Y+"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="X－" Style="{StaticResource TtGrayBtn}" FontSize="12" Padding="0"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="X-"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="回零" Style="{StaticResource TtGrayBtn}" FontSize="12" Padding="0"
                            Click="Home_Click" ToolTip="所有轴回零（目标位置=0）"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="X＋" Style="{StaticResource TtGrayBtn}" FontSize="12" Padding="0"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="X+"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="Y－" Style="{StaticResource TtGrayBtn}" FontSize="12" Padding="0"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="Y-"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                </Grid>

                <!-- Z 轴 + 停止 -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Button Content="Z＋" Style="{StaticResource TtGrayBtn}" Width="46" Height="24" FontSize="11" Padding="0" Margin="0,0,0,4"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="Z+"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                    <Button Content="Z－" Style="{StaticResource TtGrayBtn}" Width="46" Height="24" FontSize="11" Padding="0" Margin="0,0,0,4"
                            bhv:JogHoldBehavior.StartCommand="{Binding JogStartCmd, ElementName=Root2D}"
                            bhv:JogHoldBehavior.StartParameter="Z-"
                            bhv:JogHoldBehavior.StopCommand="{Binding JogStopCmd, ElementName=Root2D}"/>
                    <Button Content="停止" Width="46" Height="24" FontSize="11" Padding="0" Cursor="Hand"
                            Background="{StaticResource DangerBrush}" Foreground="White" BorderThickness="0"
                            Click="Stop_Click" ToolTip="停止点动并冻结当前位置"/>
                </StackPanel>

                <!-- 读数 + 倍率 + 轨迹 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TbPosX" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" x:Name="TbVelX" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TbPosY" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" x:Name="TbVelY" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,6" x:Name="RowZ">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Z" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TbPosZ" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" x:Name="TbVelZ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="倍率" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="SlScale" Minimum="1" Maximum="100" Value="10" Width="110" VerticalAlignment="Center"
                                ValueChanged="SlScale_ValueChanged" ToolTip="仿真速度倍率：作用于额定速度与点动速度"/>
                        <TextBlock x:Name="TbScale" Text="10%" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,12,0" MinWidth="34"/>
                        <CheckBox x:Name="CbTrace" Content="轨迹" FontSize="11" IsChecked="True" VerticalAlignment="Center"
                                  Checked="CbTrace_Changed" Unchecked="CbTrace_Changed" Margin="0,0,6,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="生成布局" FontSize="11" Padding="8,2" MinWidth="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                                Click="BtnGenLayout_Click" ToolTip="按当前工程配置自动生成 2D 布局：料盘阵列 + 真空吸嘴组 + 轴IO限位/原点传感器（与实际轴IO联动）"/><Button Content="清轨迹" FontSize="11" Padding="8,2" MinWidth="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                Click="ClearTrace_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- IO 输出 / 气缸 / 相机状态 -->
            <ScrollViewer MaxHeight="66" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="PnChips" Orientation="Horizontal"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
