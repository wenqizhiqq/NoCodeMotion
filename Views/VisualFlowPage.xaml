<UserControl x:Class="NoCodeMotion.Views.VisualFlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- 视觉流程步骤的工具类型 -->
        <x:Array x:Key="VisualStepTypes" Type="sys:String">
            <sys:String>图像采集</sys:String>
            <sys:String>图像预处理</sys:String>
            <sys:String>模板匹配</sys:String>
            <sys:String>缺陷检测</sys:String>
            <sys:String>测量</sys:String>
            <sys:String>通讯</sys:String>
        </x:Array>

        <!-- 图像预处理操作名（ComboBox 数据源） -->
        <x:Array x:Key="PreOps" Type="sys:String">
            <sys:String>无</sys:String>
            <sys:String>灰度化</sys:String>
            <sys:String>二值化</sys:String>
            <sys:String>高斯平滑</sys:String>
            <sys:String>中值滤波</sys:String>
            <sys:String>腐蚀</sys:String>
            <sys:String>膨胀</sys:String>
            <sys:String>开运算</sys:String>
            <sys:String>闭运算</sys:String>
            <sys:String>Sobel边缘</sys:String>
            <sys:String>直方图均衡</sys:String>
            <sys:String>ROI裁剪</sys:String>
            <sys:String>图像加</sys:String>
            <sys:String>图像减</sys:String>
            <sys:String>图像与</sys:String>
            <sys:String>图像或</sys:String>
        </x:Array>

        <!-- 类型专属参数组：按 SelectedStep.StepType 显隐 -->
        <Style x:Key="VisualStepGroupCard" TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="图像采集">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="图像预处理">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="模板匹配">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="缺陷检测">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="测量">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="通讯">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 视觉流程详情：DataContext 由 FlowPage 注入为 VisualFlowDetailViewModel；
         VM.Steps / VM.Name 已绑到主选中 FlowItem 的 VisualSteps / Name，所以这里的增删直接落进主流程项。 -->
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状态条：显示主选中视觉流程的名称与步骤数 + 运行按钮 -->
        <Border Grid.Row="0" Margin="14,12,14,8" Padding="10,8"
                Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                        Style="{StaticResource ToolButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PlayIcon}" Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,5,0" VerticalAlignment="Center"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="运行视觉流程" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Path Data="{StaticResource VisionIconGeometry}" Width="14" Height="14"
                      Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="视觉流程：{0}　·　步骤 {1} 个">
                            <Binding Path="Name"/>
                            <Binding Path="Steps.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 步骤列表 + 参数面板 -->
        <Grid Grid.Row="1" Margin="14,4,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：步骤列表（增删） -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding AddStepCommand}"
                            Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="添加步骤" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteStepCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DeleteIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="删除步骤" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <ListBox ItemsSource="{Binding Steps}"
                             SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                             Style="{StaticResource ProjectListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" MinWidth="96" Margin="8,0,0,0"
                                              ItemsSource="{StaticResource VisualStepTypes}"
                                              SelectedItem="{Binding StepType, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CellComboStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 右：参数面板（按步骤类型显隐）+ 运行结果 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="400"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 通用参数（始终可见） -->
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="通用参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="步骤名"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Name, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasStep}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="启用"/>
                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedStep.Enabled, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding HasStep}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="相机编号"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.CameraId, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasStep}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 图像采集 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图像采集参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="曝光 (ms)"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.ExposureMs, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="分辨率"/>
                                <Grid DockPanel.Dock="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource AppleTextField}"
                                             Text="{Binding SelectedStep.Width, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}"
                                             Text="{Binding SelectedStep.Height, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="保存路径"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.SavePath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 图像预处理 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图像预处理参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="参数 1 / 2 用法依操作不同：二值化=阈值（0~255）；平滑/形态学=核大小（奇数，默认 3）；Sobel=忽略参数；ROI裁剪、图像加减与或使用下方专用字段。"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="操作"/>
                                <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource PreOps}"
                                          SelectedItem="{Binding SelectedStep.PreOp, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="参数 1"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreParam1, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="参数 2"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreParam2, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="ROI (x,y,w,h)"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreRoi, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="第二张图"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreImage2Path, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 模板匹配 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="模板匹配参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="模板路径"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.TemplatePath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="分数阈值"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.ScoreThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="角度范围 (°)"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.AngleRange, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 缺陷检测 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷检测参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="算法"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Algorithm, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="最小面积"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.MinArea, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="最大面积"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.MaxArea, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="阈值"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Threshold, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 测量 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="测量参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="测量模式"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.MeasureMode, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="标定系数"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Calibration, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="单位"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 通讯 -->
                    <Border Style="{StaticResource VisualStepGroupCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="通讯参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="协议"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Protocol, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="目标"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Target, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="发送内容"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Content, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- 运行结果：预览图 + 每步结果 -->
                <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource AppleGroupCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AppleSectionHeader}" Text="运行结果"/>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="8" Background="#1D1D1F">
                                <Grid>
                                    <Image Source="{Binding ResultImage}" Stretch="Uniform" Margin="6"/>
                                    <TextBlock Text="运行后在此显示结果图" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#71717A" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <ListBox Grid.Column="1" ItemsSource="{Binding Results}" Style="{StaticResource ProjectListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding StepName}" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Margin="6,0,0,0" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✗"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                    <Setter Property="Text" Value="✓"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
