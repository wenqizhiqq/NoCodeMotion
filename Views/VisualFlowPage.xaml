<UserControl x:Class="NoCodeMotion.Views.VisualFlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:beh="clr-namespace:NoCodeMotion.Behaviors"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- OpenCV 角度（逆时针）→ WPF 旋转（顺时针）取反转换器，供匹配叠加层旋转框使用 -->
        <local:AngleNegateConverter x:Key="AngleNegate"/>
        <!-- 标定方式 -->
        <x:Array x:Key="CalibModes" Type="sys:String">
            <sys:String>XY+旋转</sys:String>
            <sys:String>仅XY</sys:String>
            <sys:String>仅旋转</sys:String>
        </x:Array>

        <!-- 图像采集来源 -->
        <x:Array x:Key="SourceTypes" Type="sys:String">
            <sys:String>相机</sys:String>
            <sys:String>文件夹</sys:String>
            <sys:String>文件</sys:String>
        </x:Array>

        <!-- 模板匹配方式 -->
        <x:Array x:Key="MatchModes" Type="sys:String">
            <sys:String>灰度匹配</sys:String>
            <sys:String>轮廓匹配</sys:String>
        </x:Array>

        <!-- 缺陷检测方式 -->
        <x:Array x:Key="DetectModes" Type="sys:String">
            <sys:String>阈值面积</sys:String>
            <sys:String>边缘轮廓</sys:String>
        </x:Array>

        <!-- 字符识别语言（对应 Windows.Media.Ocr 语言包） -->
        <x:Array x:Key="OcrLanguages" Type="sys:String">
            <sys:String>自动</sys:String>
            <sys:String>中文</sys:String>
            <sys:String>英文</sys:String>
            <sys:String>日文</sys:String>
            <sys:String>韩文</sys:String>
            <sys:String>繁体中文</sys:String>
        </x:Array>

        <!-- 字符识别匹配方式 -->
        <x:Array x:Key="OcrMatchModes" Type="sys:String">
            <sys:String>包含</sys:String>
            <sys:String>等于</sys:String>
            <sys:String>正则</sys:String>
        </x:Array>

        <!-- 图像预处理操作名（ComboBox 数据源） -->
        <x:Array x:Key="PreOps" Type="sys:String">
            <sys:String>无</sys:String>
            <sys:String>变黑白图</sys:String>
            <sys:String>分成黑白两块</sys:String>
            <sys:String>抹掉细碎噪点</sys:String>
            <sys:String>去掉麻点噪点</sys:String>
            <sys:String>白色变瘦</sys:String>
            <sys:String>白色变胖</sys:String>
            <sys:String>去掉小白点</sys:String>
            <sys:String>补上小黑洞</sys:String>
            <sys:String>只留边缘线</sys:String>
            <sys:String>暗处拉亮</sys:String>
            <sys:String>只留框住的那块</sys:String>
            <sys:String>两张图相加</sys:String>
            <sys:String>两张图相减</sys:String>
            <sys:String>两张图都有的留</sys:String>
            <sys:String>两张图合起来</sys:String>
        </x:Array>

        <!-- 旧 VisualStepGroupCard 样式（含 SelectedStep.StepType DataTrigger）已废弃——
             右侧参数卡现直接绑 Visibility 到 VM 的 IsImageAcquisition/IsPreprocess/... 等显式标志，
             链式 Path 绑定的 DataTrigger 在某些情况下不刷新（用户报切换工具右侧不变），改用显式标志更可靠。 -->
    </UserControl.Resources>

    <!-- 视觉流程详情：DataContext 由 FlowPage 注入为 VisualFlowDetailViewModel；
         VM.Steps / VM.Name 已绑到主选中 FlowItem 的 VisualSteps / Name，所以这里的增删直接落进主流程项。 -->
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态条已删（用户要求删掉整行），"运行视觉流程"按钮已挪到下方"删除步骤"按钮右侧 -->

        <!-- 步骤列表 + 参数面板 -->
        <Grid Grid.Row="1" Margin="14,4,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="335"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- 左：步骤列表（增删 + 每步运行/耗时/结果） -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="AddStepBtn" Click="AddStep_Click"
                            Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0"
                            ToolTip="点一下挑要加的东西：普通拍照步骤，或直接选一个算子（按分类列出）">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="添加步骤" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteStepCommand}" Style="{StaticResource TtDeleteBtn}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DeleteIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="删除步骤" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                            Style="{StaticResource ToolButtonStyle}" Margin="8,0,0,0"
                            ToolTip="【运行一次】= 把这个视觉流程里勾了「启用」的步骤从头跑到尾（拍照 → 处理图像 → 找模板 / 找缺陷 / 测量 → 发通讯）。&#10;找模板那一步会拿你在右边框选好的样子去整张图里找：找到了画绿框，没找到画红框。">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlayIcon}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="运行一次" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoopRunCommand}" IsEnabled="{Binding CanLoopRun}"
                            Style="{StaticResource ToolButtonStyle}" Margin="6,0,0,0"
                            ToolTip="【循环运行】= 一遍接一遍一直跑，再点一次就停下来（按钮会变成「停止循环」）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Foreground="#0E7490" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LoopRunButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 列头：类型 / 耗时 / 结果 / 断点（全列固定 px，类型只读显示，类型选择移到了右侧参数区） -->
                <Grid Grid.Row="1" Margin="6,0,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="类型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="耗时" FontSize="11" Margin="0,0,4,0" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="结果" FontSize="11" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="断点" FontSize="11" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <ListBox ItemsSource="{Binding Steps}"
                             SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                             Style="{StaticResource ProjectListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StepType}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,6,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" VerticalAlignment="Center"
                                               Margin="0,0,4,0" TextAlignment="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ResultText}" VerticalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastOk}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LastOk}" Value="False">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LastResult}" Value="">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding Breakpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="点一下打上断点：跑到这一步会停住，点【运行 / 继续】再接着走"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 右：参数面板（按步骤类型显隐）+ 运行结果，参数在左、图像在右 -->
            <!-- 用 DockPanel 而非 Grid：Grid 的 * 列会被 ScrollViewer 内容 MinWidth 撑开溢出覆盖
                 相邻列；DockPanel 按声明顺序精确分配，元素不会溢出。Border Dock=Right 固定 400px
                 在右，ScrollViewer 无 Dock 走 LastChildFill 自动填满左侧剩余 -->
            <DockPanel Grid.Column="1" LastChildFill="True">
                <!-- 运行结果：预览图 + 每步结果 -->
                <!-- Border Width=740：右栏总宽 ~1061，参数 30% (~320) + 图像 70% (~740)，用户要求图像占大头 -->
                <Border DockPanel.Dock="Right" Width="740" Margin="0,0,0,0"
                        Style="{StaticResource AppleGroupCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AppleSectionHeader}" Text="运行结果"/>
                        <!-- 操作说明（用户要求）：中键拖拽平移 / 滚轮缩放 / 双击复位 / 左键拖拽框选 -->
                        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,9,14,2" FontSize="11" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="滚轮放大缩小 · 按住中间键拖动画面 · 双击回到原始大小 · 按住左键拖出一个框选区域"/>
                        <!-- 图像占满整个 740px Border；左键拖拽画框，中键拖拽平移，滚轮缩放 -->
                        <!-- ClipToBounds 必须在外层 Border 上：缩放/平移后的内容靠它裁剪，否则图会溢出到相邻列。
                             UIElement.Clip 在 RenderTransform **之前**生效，挡不住缩放后的子元素。 -->
                        <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" Background="#1D1D1F"
                                ClipToBounds="True">
                            <Grid x:Name="ImageHost" Background="Transparent" Cursor="Cross"
                                  beh:ZoomPanBehavior.IsEnabled="True"
                                  ToolTip="滚轮放大缩小　按住中间键拖动画面　双击回到原始大小　按住左键拖框选区域"
                                  MouseDown="ImageHost_MouseDown" MouseMove="ImageHost_MouseMove"
                                  MouseUp="ImageHost_MouseUp">
                                <Image x:Name="ResultImageView" Source="{Binding ResultImage}" Stretch="Uniform"/>
                                <!-- 框选覆盖层：拖拽时实时显示选区矩形 -->
                                <Canvas x:Name="RoiCanvas" IsHitTestVisible="False">
                                    <Rectangle x:Name="RoiRect" Visibility="Collapsed"
                                               Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                               Fill="#1A007AFF"/>
                                </Canvas>
                                <!-- 匹配结果叠加层（参考 GrayMatch.Wpf）：每个目标画旋转绿/红框 + 相似度/角度文字。
                                     OverlayBox 已按 Stretch=Uniform 在 code-behind 投影为屏幕坐标，子元素用
                                     Canvas.Left/Top/Width/Height 直接定位，不再依赖外层 RenderTransform，
                                     彻底避开 PropertyChanged / 布局时序 race 引起的 1-2px 偏移。 -->
                                <Canvas x:Name="MatchOverlay" IsHitTestVisible="False"
                                        Visibility="{Binding HasOverlayBoxes, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding OverlayBoxes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding ScreenLeft}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding ScreenTop}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Rectangle Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Stroke" Value="Lime"/>
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                        <Setter Property="Stroke" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="{Binding ScreenAngle}"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <!-- 相似度：顶部，紧贴框上沿外侧（Lime 绿，Pass=False 切红） -->
                                                    <Border Canvas.Left="-2" Canvas.Top="-22" Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                            IsHitTestVisible="False" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="Lime"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="相似度 "/>
                                                            <Run Text="{Binding Mode=OneWay, Path=Score, StringFormat={}{0:F3}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <!-- 角度：相似度下方一行（Yellow 黄，Pass=False 切红） -->
                                                    <Border Canvas.Left="-2" Canvas.Top="-44" Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                            IsHitTestVisible="False" HorizontalAlignment="Left">
                                                        <TextBlock FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="Yellow"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="角度 "/>
                                                            <Run Text="{Binding Mode=OneWay, Path=OriginalAngle, StringFormat={}{0:F0}}"/>
                                                            <Run Text="°"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                <!-- 字符识别结果叠加层：每行识别到的文字画绿框（不通过=红框），框上方用绿字标出识别内容。
                                     与 MatchOverlay 同思路：TextOverlayBox 已在 code-behind 按 Stretch=Uniform 投影为屏幕坐标，
                                     子元素用 Canvas.Left/Top/Width/Height 直接定位。 -->
                                <Canvas x:Name="TextOverlay" IsHitTestVisible="False"
                                        Visibility="{Binding HasTextOverlayBoxes, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding TextOverlayBoxes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding ScreenLeft}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding ScreenTop}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Rectangle Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}"
                                                               Fill="Transparent">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Stroke" Value="Lime"/>
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                        <Setter Property="Stroke" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                    <!-- 识别到的文字：紧贴框上沿外侧（绿字，Pass=False 切红） -->
                                                    <Border Canvas.Left="-2" Canvas.Top="-20" Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                            IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="Lime"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                <!-- 匹配结果覆盖层：点「开启匹配」后叠加显示相似度/精度/位置/角度；绿底通过，红底未达阈值 -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                        CornerRadius="6" Padding="10,6" IsHitTestVisible="False"
                                        Visibility="{Binding HasMatchResult, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E616A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode=OneWay, Path=MatchResult.Pass}" Value="False">
                                                    <Setter Property="Background" Value="#E6DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="匹配结果" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="相似度 "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.Similarity, StringFormat={}{0:F3}}"/>
                                            <Run Text="　精度 "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.PrecisionPercent, StringFormat={}{0:F1}}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="11">
                                            <Run Text="位置 ("/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.X}"/>
                                            <Run Text=", "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.Y}"/>
                                            <Run Text=")　角度 "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.Angle, StringFormat={}{0:F0}}"/>
                                            <Run Text="°"/>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="11">
                                            <Run Text="模板 "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.W}"/>
                                            <Run Text="×"/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.H}"/>
                                            <Run Text="　阈值 "/>
                                            <Run Text="{Binding Mode=OneWay, Path=MatchResult.Threshold, StringFormat={}{0:F2}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="运行后在此显示结果图" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#71717A" FontSize="12" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 通用参数（始终可见） -->
                        <Border Style="{StaticResource AppleGroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="通用参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="步骤名"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Name, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasStep}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <!-- 分组 → 步骤类型：先选基础步骤还是某类算子，类型列表跟着换 -->
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="分组"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{Binding GroupChoices}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                          IsEnabled="{Binding HasStep}"
                                          ToolTip="先选一组：基础步骤（拍照 / 预处理 / 匹配…），或某一类算子（找边与测量 / 几何计算…）"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="步骤类型"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{Binding StepTypeChoices}"
                                          SelectedItem="{Binding SelectedTypeName, Mode=TwoWay}"
                                          IsEnabled="{Binding HasStep}"
                                          ToolTip="这一组里可选的类型；选到算子时，下面就是它的参数"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="启用"/>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedStep.Enabled, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding HasStep}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 视觉算子（参数行由 Services/Vision/VisionOperators.cs 目录自动生成） ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding HasStep, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="算子参数"/>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="上面的「步骤类型」选的是算子时，这里就是它的参数；选的是基础步骤则没有参数。"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <TextBlock Text="{Binding OpHelp}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource AccentDarkBrush}"
                                           Visibility="{Binding HasOp, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding OpParams}"
                                              Visibility="{Binding HasOp, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                                <DockPanel Style="{StaticResource AppleRow}">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}"
                                                               Text="{Binding Name}" ToolTip="{Binding Help}"/>
                                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                                              ItemsSource="{Binding OptionList}"
                                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 图像采集 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsImageAcquisition, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图像采集参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="来源"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource SourceTypes}"
                                          SelectedItem="{Binding SelectedStep.SourceType, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}" Visibility="{Binding IsCameraSource, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Style="{StaticResource AppleRow}" Visibility="{Binding IsCameraSource, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="相机"/>
                                    <!-- 可编辑下拉：既列工程相机名（如「下视相机」），也允许直接填编号（0/1/…）。
                                         CellComboStyle 默认 IsReadOnly=True，这里显式覆盖成可输入。 -->
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          MinWidth="150"
                                          IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CameraNames}"
                                          Text="{Binding SelectedStep.CameraId, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="从「相机」页选一台，或者直接填编号（0、1、…）"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Style="{StaticResource AppleRow}" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="文件夹"/>
                                    <Button DockPanel.Dock="Right" Content="浏览" Padding="8,2" Margin="8,0,0,0"
                                        Style="{StaticResource ToolButtonStyle}"
                                        ToolTip="挑一个装着图片的文件夹，批量用里面的图"
                                        Command="{Binding BrowsePathCommand}" CommandParameter="FolderPath"/>
                                    <TextBox Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.FolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}" Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Style="{StaticResource AppleRow}" Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="文件路径"/>
                                    <Button DockPanel.Dock="Right" Content="浏览" Padding="8,2" Margin="8,0,0,0"
                                        Style="{StaticResource ToolButtonStyle}"
                                        ToolTip="挑一张图片文件"
                                        Command="{Binding BrowsePathCommand}" CommandParameter="SavePath"/>
                                    <TextBox Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.SavePath, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="曝光" Unit="ms"
                                                    Minimum="0" Maximum="1000" TickFrequency="1"
                                                    Value="{Binding SelectedStep.ExposureMs}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="宽度" Unit="px"
                                                    Minimum="64" Maximum="4096" TickFrequency="1"
                                                    Value="{Binding SelectedStep.Width}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="高度" Unit="px"
                                                    Minimum="64" Maximum="4096" TickFrequency="1"
                                                    Value="{Binding SelectedStep.Height}"/>
                            </StackPanel>
                        </Border>

                        <!-- 图像预处理 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsPreprocess, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图像预处理参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="这两个数字代表什么，看你上面选的是哪个操作：&#10;· 二值化 = 明暗的分界线（0~255）；&#10;· 平滑 / 形态学 = 影响的范围大小，要填奇数，一般用 3；&#10;· Sobel 找边缘 = 这两个不用填；&#10;· 裁剪、两张图做加减与或 = 用下面专门给它们准备的栏位。"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="操作"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource PreOps}"
                                          SelectedItem="{Binding SelectedStep.PreOp, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="参数 1"
                                                    Minimum="0" Maximum="255" TickFrequency="1"
                                                    Value="{Binding SelectedStep.PreParam1}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="参数 2" Unit="px"
                                                    Minimum="1" Maximum="31" TickFrequency="2"
                                                    Value="{Binding SelectedStep.PreParam2}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="框选区域 ROI (x,y,w,h)" ToolTip="要处理的方块区域：x,y 是左上角在图上的位置，w,h 是它的宽和高（都是像素）。也可以在右边那张图上直接按住左键拖一个框，不用手填"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreRoi, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="第二张图"/>
                                    <Button DockPanel.Dock="Right" Content="浏览" Padding="8,2" Margin="8,0,0,0"
                                        Style="{StaticResource ToolButtonStyle}"
                                        ToolTip="再挑一张图，用来和第一张做加减 / 与 / 或"
                                        Command="{Binding BrowsePathCommand}" CommandParameter="PreImage2Path"/>
                                    <TextBox Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.PreImage2Path, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 模板匹配 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsTemplateMatch, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="模板匹配参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="匹配方式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource MatchModes}"
                                          SelectedItem="{Binding SelectedStep.MatchMode, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <!-- 确定模板：把右侧已框选区域裁剪为模板图像并显示在下方预览 -->
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="模板"/>
                                    <Button DockPanel.Dock="Right" Content="确定模板" Padding="12,4" Margin="8,0,0,0"
                                            Style="{StaticResource ToolButtonStyle}"
                                            ToolTip="把右边框选出来的那块抠成一张模板图，存到 Templates 文件夹里，下面可以预览"
                                            Command="{Binding ConfirmTemplateCommand}"/>
                                </DockPanel>
                                <!-- 模板预览：优先显示已裁剪并保存的模板图（TEMPLATE 已确定时），
                                     没有确定模板但已加载源图时回退到显示源图（让用户在右侧拖 ROI 时有视觉参考）。 -->
                                <Border Margin="20,2,20,10" Height="140" CornerRadius="6" Background="#1D1D1F">
                                    <Grid>
                                        <Image Stretch="Uniform">
                                            <Image.Source>
                                                <!-- PriorityBinding：优先取 TemplatePreviewImage（已确定模板的裁剪图），
                                                     否则取 ResultImage（源图本身作为拖框视觉参考），
                                                     都没有时留空显示下方占位文本。-->
                                                <PriorityBinding>
                                                    <Binding Path="TemplatePreviewImage"/>
                                                    <Binding Path="ResultImage"/>
                                                </PriorityBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock Text="先在右边那张图上，按住左键拖出一个框，框住你要让机器认的样子" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#71717A" FontSize="11" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- 已有源图或已确定模板 → 隐藏占位文本 -->
                                                        <DataTrigger Binding="{Binding HasTemplatePreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <!-- 模板区域回显 + 清除框选（在右侧图上拖拽鼠标确定） -->
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="模板区域"/>
                                    <Button DockPanel.Dock="Right" Content="清除" Padding="8,2" Margin="8,0,0,0"
                                            Style="{StaticResource TtPillRedBtn}"
                                            ToolTip="把刚才框选的样子清掉，重新框"
                                            Command="{Binding ClearTemplateRoiCommand}"/>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               Text="{Binding SelectedStep.TemplateRoiText}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="分数阈值"
                                                    Minimum="0" Maximum="1" TickFrequency="0.01"
                                                    Value="{Binding SelectedStep.ScoreThreshold}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="角度范围" Unit="°"
                                                    Minimum="0" Maximum="360" TickFrequency="5"
                                                    Value="{Binding SelectedStep.AngleRange}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <!-- 开启匹配：用当前图 + 框选模板跑匹配，结果画到右侧图像 -->
                                <Button Command="{Binding RunMatchCommand}" IsEnabled="{Binding CanRun}"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0,8,0,2"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PlayIcon}" Width="14" Height="14" Stretch="Uniform"
                                              Margin="0,0,5,0" VerticalAlignment="Center"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="开启匹配" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 缺陷检测 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsDefect, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷检测参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="检测方式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource DetectModes}"
                                          SelectedItem="{Binding SelectedStep.DetectMode, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="算法"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Algorithm, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="最小面积" Unit="px²"
                                                    Minimum="0" Maximum="100000" TickFrequency="10"
                                                    Value="{Binding SelectedStep.MinArea}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="最大面积" Unit="px²"
                                                    Minimum="0" Maximum="1000000" TickFrequency="100"
                                                    Value="{Binding SelectedStep.MaxArea}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="阈值"
                                                    Minimum="0" Maximum="255" TickFrequency="1"
                                                    Value="{Binding SelectedStep.Threshold}"/>
                            </StackPanel>
                        </Border>

                        <!-- 测量 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsMeasure, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="测量参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="测量模式"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.MeasureMode, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="标定系数"
                                                    Minimum="0" Maximum="100" TickFrequency="0.01"
                                                    Value="{Binding SelectedStep.Calibration}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="单位"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 字符识别 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsOcr, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="字符识别参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="用 Windows 自带的文字识别读图里的字（不用联网）。在右边结果图上按住左键拖框，框出要读的位置；不框就是整张图都读。&#10;读出来的字和下面「期望文本」一模一样，这一步就算通过。&#10;要认中文，得先在这台电脑上装好中文的 OCR 语言包。"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="语言"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource OcrLanguages}"
                                          SelectedItem="{Binding SelectedStep.OcrLanguage, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="匹配方式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource OcrMatchModes}"
                                          SelectedItem="{Binding SelectedStep.OcrMatchMode, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="期望文本"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.OcrExpectedText, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="忽略大小写"/>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedStep.OcrIgnoreCase, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="识别区域"/>
                                    <Button DockPanel.Dock="Right" Content="清除" Padding="8,2" Margin="8,0,0,0"
                                            Style="{StaticResource TtPillRedBtn}"
                                            ToolTip="把框选的读字区域清掉，恢复成整张图都读"
                                            Command="{Binding ClearOcrRoiCommand}"/>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               Text="{Binding SelectedStep.OcrRoiText}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 标定（9 点 XY + 5 点旋转） -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="标定参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="标定的时候软件会自己走一遍：先把 9 个点排成 3×3 的格子，每个点拍一张图、找到标记的中心，算出「图上的 1 像素 = 机台的多少毫米」和 X / Y 的方向；做旋转标定时再按你定的步距转 5 个角度，算出旋转中心在哪。&#10;算完的结果存进工程的「标定」表，同时导出成变量（例如 标定_像素当量），之后模板匹配就能直接报出机台上的真实位置。&#10;两个要注意：标记要一直待在视野里；做旋转标定时标记不能正好压在旋转中心上，要偏出去一些，不然半径太小会算失败。"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="标定方式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          ItemsSource="{StaticResource CalibModes}"
                                          SelectedItem="{Binding SelectedStep.CalibMode, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="相机"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          MinWidth="150" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CameraNames}"
                                          Text="{Binding SelectedStep.CameraId, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="标定结果是按相机分别存的：从「相机」页选一台，或者直接填编号（0、1、…）"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="X 轴"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          MinWidth="150" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CalibAxisNames}"
                                          Text="{Binding SelectedStep.CalibXAxis, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="走 X 方向的那根轴，填「轴」页里的名字，例如 上料-轴1"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="Y 轴"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          MinWidth="150" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CalibAxisNames}"
                                          Text="{Binding SelectedStep.CalibYAxis, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="走 Y 方向的那根轴，填「轴」页里的名字"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="旋转轴"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}"
                                          MinWidth="150" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CalibAxisNames}"
                                          Text="{Binding SelectedStep.CalibRotAxis, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="做旋转标定时要转的那根轴，填「轴」页里的名字"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="9 点间距" Unit="mm"
                                                    Minimum="0.1" Maximum="500" TickFrequency="0.1"
                                                    Value="{Binding SelectedStep.CalibPitchMm}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="旋转步距" Unit="°"
                                                    Minimum="1" Maximum="90" TickFrequency="1"
                                                    Value="{Binding SelectedStep.CalibRotationStepDeg}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="旋转点数" Unit="点"
                                                    Minimum="3" Maximum="12" TickFrequency="1"
                                                    Value="{Binding SelectedStep.CalibRotationCount}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="稳定延时" Unit="ms"
                                                    Minimum="0" Maximum="5000" TickFrequency="50"
                                                    Value="{Binding SelectedStep.CalibSettleMs}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="标记阈值" Unit="0-255"
                                                    Minimum="0" Maximum="255" TickFrequency="1"
                                                    Value="{Binding SelectedStep.CalibThreshold}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="标记最小面积" Unit="px"
                                                    Minimum="1" Maximum="100000" TickFrequency="10"
                                                    Value="{Binding SelectedStep.CalibMinArea}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <local:NumericSliderRow Label="标记最大面积" Unit="px"
                                                    Minimum="1" Maximum="2000000" TickFrequency="100"
                                                    Value="{Binding SelectedStep.CalibMaxArea}"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="暗标记（亮底黑点）"/>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedStep.CalibDarkMarker, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="开始标定"/>
                                    <Button DockPanel.Dock="Right" Content="运行本步" Padding="10,3"
                                            Style="{StaticResource TtPillGreenBtn}"
                                            ToolTip="【只跑到这一步】= 让真机走 9 + 5 个点来完成标定。按之前先确认机台周围没人、没有东西挡着。"
                                            Command="{Binding RunStepCommand}"
                                            CommandParameter="{Binding SelectedStep}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="{Binding CalibCurrentText}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{Binding SelectedStep.CalibResultText}"/>
                            </StackPanel>
                        </Border>

                        <!-- 通讯 -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,12,0,0"
                            Visibility="{Binding IsComm, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="通讯参数"/>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="协议"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Protocol, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="目标"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Target, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="发送内容"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedStep.Content, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>