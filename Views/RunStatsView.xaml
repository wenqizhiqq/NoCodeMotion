<UserControl x:Class="NoCodeMotion.Views.RunStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="240" d:DesignWidth="440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="运行耗时 / OEE 统计" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TowerText}" Value="运行(绿)"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding TowerText}" Value="暂停(黄)"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding TowerText}" Value="报警(红)"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding TowerText}" Value="急停(红)"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding TowerText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="导出CSV" Style="{StaticResource TtPillBlueBtn}" MinWidth="0" Padding="10,3" Click="ExportButton_Click" ToolTip="导出 CT / 步骤耗时 / OEE 统计为 CSV，便于瓶颈分析。"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- OEE -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="可用率" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding AvailText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="性能" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding PerfText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="良率" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding QualText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="OEE" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding OeeText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="完成轮数" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding CycleText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                        <StackPanel><TextBlock Text="运行时间" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding RunText}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 各流程 CT -->
                <TextBlock Text="各流程节拍（CT）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                <ListView ItemsSource="{Binding Cycles}" BorderThickness="0" Background="Transparent" MaxHeight="150">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Flow}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Last}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Avg}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Max}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Count}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="（本轮 / 平均 / 最大 ms · 轮数）" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

                <!-- 最慢步骤 -->
                <TextBlock Text="最慢步骤 Top-N（瓶颈）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                <ListView ItemsSource="{Binding SlowSteps}" BorderThickness="0" Background="Transparent" MaxHeight="150">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="60"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Where}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Logic}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Avg}" Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Max}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="（平均 / 最大 ms · 用于定位耗时久的环节）" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
