<UserControl x:Class="NoCodeMotion.Views.LuaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:dbg="clr-namespace:NoCodeMotion.Services"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="LuaPanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 调试工具栏按钮：明显彩色底 + 白字；禁用时仅整体淡化（不换灰底），避免调试时闪烁 -->
        <Style x:Key="LuaDbgButton" TargetType="Button">
            <Setter Property="Background" Value="#7A8794"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="hover" Background="White" Opacity="0" CornerRadius="5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS 矢量图标：白色字形 + iOS 系统色底，统一替代原 emoji 字形 -->
        <Geometry x:Key="LuaPlayIcon">M8 5v14l11-7z</Geometry>
        <Geometry x:Key="LuaPauseIcon">M6 5h4v14H6zM14 5h4v14h-4z</Geometry>
        <Geometry x:Key="LuaStopIcon">M6 6h12v12H6z</Geometry>
        <Geometry x:Key="LuaStepOverIcon">M4 12h11M11 7l5 5-5 5</Geometry>
        <Geometry x:Key="LuaStepInIcon">M4 12h6M10 6l5 6-5 6</Geometry>
        <Geometry x:Key="LuaStepOutIcon">M4 12h6M10 18l5-6-5-6</Geometry>
        <Geometry x:Key="LuaBreakpointIcon">M12 2a10 10 0 100 20 10 10 0 000-20z</Geometry>
        <Geometry x:Key="LuaClearBpIcon">M12 2a10 10 0 100 20 10 10 0 000-20zM5 5l14 14</Geometry>
        <Geometry x:Key="LuaHintIcon">M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4z</Geometry>
        <Geometry x:Key="LuaExampleIcon">M6 2h8l4 4v16H6zM14 2v4h4M9 13h6M9 16h6</Geometry>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="240"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="170" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="300" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 编辑器 ============ -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="编辑器"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="输入时自动提示 · 单击变量查看取值 · 点击左侧边栏打断点"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <avalonEdit:TextEditor x:Name="Editor"
                                            FontFamily="Consolas, Cascadia Mono, Courier New"
                                            FontSize="13"
                                            ShowLineNumbers="True"
                                            LineNumbersForeground="#8E8E93"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto"
                                            Padding="4,6,0,6"
                                            Background="White"/>
                    <Popup x:Name="VarPopup" AllowsTransparency="True" StaysOpen="False"
                           Placement="Relative" PlacementTarget="{Binding ElementName=Editor}">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" MaxWidth="460">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PopupName" FontWeight="SemiBold" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                                    <Border x:Name="PopupScopeBox" Background="{StaticResource AccentSoftBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PopupScope" FontSize="10.5" Foreground="{StaticResource AccentDarkBrush}" Text="局部"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PopupValue" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="PopupType" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 右侧：智能插入（左函数 · 右名称 · 插入一行） ============ -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <DockPanel>
                    <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="智能插入"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="左选函数 · 右选名称 · 插入一行"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                </Grid.ColumnDefinitions>

                <!-- 左：函数列表 -->
                <ListBox x:Name="FuncList" Grid.Column="0" BorderThickness="0"
                         FontFamily="Microsoft YaHei UI, Consolas" FontSize="12.5"
                         DisplayMemberPath="Name"
                         SelectionChanged="FuncList_SelectionChanged"/>

                <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}"/>

                <!-- 右：所选函数需要的名称列表（或逻辑结构代码块） -->
                <ListBox x:Name="NameList" Grid.Column="2" BorderThickness="0"
                         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12.5"
                         DisplayMemberPath="Name"
                         MouseLeftButtonUp="NameList_MouseLeftButtonUp"/>
            </Grid>
        </Grid>

        <!-- ============ 输出 ============ -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="输出"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource TtGrayBtn}" Padding="6,1" Click="BtnClearOutput_Click" ToolTip="清空输出">
                            <TextBlock Text="清空" FontSize="11"/>
                        </Button>
                    </DockPanel>
                </Border>
                <ListBox x:Name="OutputList" Grid.Row="1" BorderThickness="0" FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LogEntry}">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============ 诊断 ============ -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="12,8" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="诊断" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDiagnostics" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============ 调试工具栏（底部） ============ -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#8E8E93" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtState" Margin="6,0,0,0" FontSize="12" Text="就绪" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBreakCount" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="断点 0" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#C7C7CC"/>
                    <TextBlock x:Name="TxtCaret" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="行 1，列 1" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#C7C7CC"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="Lua 5.2 (MoonSharp)" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRun" Style="{StaticResource LuaDbgButton}" Background="#34C759" Click="BtnRun_Click" ToolTip="运行 / 继续 (F5)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaPlayIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RunLabel" Text="运行" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPause" Style="{StaticResource LuaDbgButton}" Background="#FF9500" Click="BtnPause_Click" ToolTip="中断执行 (F6)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaPauseIcon}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="中断" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource LuaDbgButton}" Background="#FF3B30" Click="BtnStop_Click" ToolTip="停止 (Shift+F5)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaStopIcon}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="停止" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepOver" Style="{StaticResource LuaDbgButton}" Background="#007AFF" Click="BtnStepOver_Click" ToolTip="单步执行 (F10)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaStepOverIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="单步" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepIn" Style="{StaticResource LuaDbgButton}" Background="#007AFF" Click="BtnStepIn_Click" ToolTip="步入函数 (F11)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaStepInIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="步入" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepOut" Style="{StaticResource LuaDbgButton}" Background="#007AFF" Click="BtnStepOut_Click" ToolTip="跳出函数 (Shift+F11)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaStepOutIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="步出" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBreakpoint" Style="{StaticResource LuaDbgButton}" Background="#FF3B30" Click="BtnBreakpoint_Click" ToolTip="在光标所在行设置 / 取消断点 (F9)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaBreakpointIcon}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="断点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClearBreakpoints" Style="{StaticResource LuaDbgButton}" Background="#8E8E93" Click="BtnClearBreakpoints_Click" ToolTip="清除全部断点" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaClearBpIcon}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="清除断点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnHint" Style="{StaticResource LuaDbgButton}" Background="#5856D6" Click="BtnHint_Click" ToolTip="手动唤出智能提示 (Ctrl+Space)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaHintIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="智能提示" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExample" Style="{StaticResource LuaDbgButton}" Background="#5AC8FA" Click="BtnExample_Click" ToolTip="在编辑器中插入示例脚本" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LuaExampleIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="插入示例" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
