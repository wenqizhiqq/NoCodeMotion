<UserControl x:Class="NoCodeMotion.Views.LuaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:dbg="clr-namespace:NoCodeMotion.Services"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="LuaPanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="240"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="170" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="300" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 编辑器 ============ -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="编辑器"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="输入时自动提示 · 单击变量查看取值 · 点击左侧边栏打断点"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <avalonEdit:TextEditor x:Name="Editor"
                                            FontFamily="Consolas, Cascadia Mono, Courier New"
                                            FontSize="13"
                                            ShowLineNumbers="True"
                                            LineNumbersForeground="#9AA5B1"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto"
                                            Padding="4,6,0,6"
                                            Background="White"/>
                    <Popup x:Name="VarPopup" AllowsTransparency="True" StaysOpen="False"
                           Placement="Relative" PlacementTarget="{Binding ElementName=Editor}">
                        <Border Background="White" BorderBrush="#B9C6D6" BorderThickness="1" CornerRadius="6" Padding="12,9" MaxWidth="460">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#33445A"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PopupName" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Foreground="#1F3B63"/>
                                    <Border x:Name="PopupScopeBox" Background="#EAF1FA" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PopupScope" FontSize="10.5" Foreground="#3C6FA8" Text="局部"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PopupValue" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#A31515"/>
                                <TextBlock x:Name="PopupType" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 右侧：变量 + 调用栈 ============ -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="170" MinHeight="90"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="变量"/>
                    </Border>
                    <Border Grid.Row="1" Background="#F7FAFE" BorderBrush="#E1E9F2" BorderThickness="0,0,0,1" Padding="10,7">
                        <StackPanel>
                            <TextBlock Text="光标处变量" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtInspect" Margin="0,3,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Text="—" Foreground="#1F3B63"/>
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="VarTree" Grid.Row="2" BorderThickness="0" Padding="4">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type dbg:VarInfo}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="#376BB5"/>
                                    <TextBlock Text=" = " Foreground="#98A2AE"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#A31515"/>
                                    <TextBlock Text="{Binding TypeName}" Margin="8,0,0,0" FontSize="10.5" Foreground="#A8B2BD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="调用栈"/>
                    </Border>
                    <ListBox x:Name="CallStackList" Grid.Row="1" BorderThickness="0" FontFamily="Consolas, Cascadia Mono" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 输出 ============ -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <TextBlock Style="{StaticResource LuaPanelHeaderText}" Text="输出"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource TtGrayBtn}" Padding="6,1" Click="BtnClearOutput_Click" ToolTip="清空输出">
                            <TextBlock Text="清空" FontSize="11"/>
                        </Button>
                    </DockPanel>
                </Border>
                <ListBox x:Name="OutputList" Grid.Row="1" BorderThickness="0" FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LogEntry}">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============ 诊断 ============ -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="12,8" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="诊断" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDiagnostics" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============ 调试工具栏（底部） ============ -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}" SnapsToDevicePixels="True">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#9AA5B1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtState" Margin="6,0,0,0" FontSize="12" Text="就绪" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBreakCount" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="断点 0" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#C6CCD3"/>
                    <TextBlock x:Name="TxtCaret" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="行 1，列 1" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#C6CCD3"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="Lua 5.2 (MoonSharp)" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRun" Style="{StaticResource TtBaseBtn}" Click="BtnRun_Click" ToolTip="运行 / 继续 (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" Foreground="#2E7D32" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RunLabel" Text="运行" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPause" Style="{StaticResource TtWarnBtn}" Click="BtnPause_Click" ToolTip="中断执行 (F6)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❚❚" FontSize="10" Foreground="#B26A00" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="中断" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource TtDeleteBtn}" Click="BtnStop_Click" ToolTip="停止 (Shift+F5)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" Foreground="#C62828" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="停止" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepOver" Style="{StaticResource TtBaseBtn}" Click="BtnStepOver_Click" ToolTip="单步执行 (F10)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↷" Foreground="#0F6CBD" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="单步" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepIn" Style="{StaticResource TtBaseBtn}" Click="BtnStepIn_Click" ToolTip="步入函数 (F11)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↴" Foreground="#0F6CBD" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="步入" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStepOut" Style="{StaticResource TtBaseBtn}" Click="BtnStepOut_Click" ToolTip="跳出函数 (Shift+F11)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↰" Foreground="#0F6CBD" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="步出" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBreakpoint" Style="{StaticResource TtGrayBtn}" Click="BtnBreakpoint_Click" ToolTip="在光标所在行设置 / 取消断点 (F9)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#E51C23" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="断点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClearBreakpoints" Style="{StaticResource TtGrayBtn}" Click="BtnClearBreakpoints_Click" ToolTip="清除全部断点" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="○" Foreground="#8A939C" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="清除断点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnHint" Style="{StaticResource TtGrayBtn}" Click="BtnHint_Click" ToolTip="手动唤出智能提示 (Ctrl+Space)" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="#8E44AD" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="智能提示" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
