<Window x:Class="NoCodeMotion.Views.FlowPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoCodeMotion.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- Apple 风格自定义对话框：流程步骤预览（仿真编译后的动作序列） -->
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <StackPanel MinWidth="420" MaxWidth="620">
            <!-- 标题区 -->
            <Border Padding="22,18,22,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource PlayIcon}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="流程步骤预览" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 摘要 + 步骤列表 -->
            <StackPanel Margin="22,14,22,6">
                <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="360">
                    <ListBox x:Name="StepList" BorderThickness="0" Background="Transparent" Padding="6"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- 按钮区 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
                <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource TtBaseBtn}" Width="90" Click="CloseButton_Click" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
