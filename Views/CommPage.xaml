<UserControl x:Class="NoCodeMotion.Views.CommPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <local:EditorPage>
        <local:EditorPage.Detail>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MinWidth="320">
                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                    <Path Data="{StaticResource CommIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="通讯配置" Style="{StaticResource SectionHeaderText}"/>
                </StackPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="通讯类型" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.CommType}" SelectedValuePath="Content">
                        <ComboBoxItem Content="串口"/>
                        <ComboBoxItem Content="网口TCP"/>
                        <ComboBoxItem Content="网口UDP"/>
                        <ComboBoxItem Content="ModbusTCP"/>
                        <ComboBoxItem Content="ModbusRTU"/>
                        <ComboBoxItem Content="相机网口"/>
                        <ComboBoxItem Content="西门子S7"/>
                        <ComboBoxItem Content="三菱MC"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="端口/IP" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.PortOrIp, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="波特率/端口" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.BaudOrPort}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="数据位" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.DataBits, TargetNullValue=8}" SelectedValuePath="Content">
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="校验位" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.Parity}" SelectedValuePath="Content">
                        <ComboBoxItem Content="无"/>
                        <ComboBoxItem Content="奇校验"/>
                        <ComboBoxItem Content="偶校验"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="停止位" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.StopBits, TargetNullValue=1}" SelectedValuePath="Content">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="1.5"/>
                        <ComboBoxItem Content="2"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="超时(ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.TimeoutMs}"/>
                </DockPanel>
            </StackPanel>
            </ScrollViewer>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
