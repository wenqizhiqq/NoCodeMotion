<UserControl x:Class="NoCodeMotion.Views.CommPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <local:EditorPage>
        <local:EditorPage.Detail>
            <StackPanel Margin="16" MinWidth="320">
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="通讯类型" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding SelectedItem.CommType}" SelectedValuePath="Content">
                        <ComboBoxItem Content="串口"/>
                        <ComboBoxItem Content="网口TCP"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="端口/IP" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.PortOrIp, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="波特率/端口" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.BaudOrPort}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource FieldGrid}">
                    <TextBlock DockPanel.Dock="Left" Text="超时(ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedItem.TimeoutMs}"/>
                </DockPanel>
            </StackPanel>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
