<UserControl x:Class="NoCodeMotion.Views.CommPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="820">

    <UserControl.Resources>
        <local:CommTypeVisibilityConverter x:Key="TypeVisible"/>

    </UserControl.Resources>

    <local:EditorPage>
        <local:EditorPage.Detail>
            <Border Background="{StaticResource CanvasBrush}">
                <StackPanel Margin="14">
                    <!-- 页标题 -->
                    <StackPanel Style="{StaticResource PageHeaderPanel}">
                        <Path Style="{StaticResource PageHeaderIcon}" Data="{StaticResource CommIcon}"/>
                        <TextBlock Style="{StaticResource PageHeaderTitle}" Text="通讯"/>
                    </StackPanel>

                    <!-- 通讯类型（驱动其余参数显隐）-->
                    <Border Style="{StaticResource AppleGroupCard}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="通讯类型" Style="{StaticResource AppleSectionHeader}"/>
                            <ListBox ItemsSource="{Binding CommTypeOptions}"
                                    SelectedItem="{Binding SelectedItem.CommType}"
                                    Style="{StaticResource ApplePillList}"/>
                        </StackPanel>
                    </Border>

                    <!-- 参数芯片流（按类型动态显隐）-->
                    <WrapPanel Margin="0,0,0,4">
                        <!-- 通用 -->
                        <Border Style="{StaticResource AppleChip}">
                            <StackPanel>
                                <TextBlock Text="名称" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="这条通讯的名字；流程和脚本就是用这个名字找到这条通道的"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="串口号" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.PortOrIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="串口线在电脑上占的口，例如 COM3（插上设备后在「设备管理器」里能看到）"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='网口TCP|网口UDP|ModbusTCP|相机网口|SECS(HSMS)|西门子S7|三菱MC'}">
                            <StackPanel>
                                <TextBlock Text="端口 / IP" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.PortOrIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="要连的那台设备的 IP，例如 192.168.1.10。两台电脑要在同一个网段，ping 得通才连得上"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="波特率" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.BaudOrPort}" Style="{StaticResource AppleNumField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="串口跑多快，必须和设备那一端设得一模一样（常用 9600 或 115200）。不一样收到的全是乱码"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='网口TCP|网口UDP|ModbusTCP|相机网口|SECS(HSMS)|西门子S7|三菱MC'}">
                            <StackPanel>
                                <TextBlock Text="端口号" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.BaudOrPort}" Style="{StaticResource AppleNumField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="对方设备上开着的那个端口号，例如 Modbus 常用 502"/>
                            </StackPanel>
                        </Border>
                        <!-- ↓↓↓ 本机互联 / 接口类通道（管道、共享内存、共享文件夹、本机文件、Web）的参数 -->
                        <Border Style="{StaticResource AppleChip}" MinWidth="300"
                                Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='管道|共享内存|共享文件夹|本机文件|Web'}">
                            <StackPanel>
                                <TextBlock Text="地址（管道名 / 共享区名 / 文件夹 / 文件 / 网址，看你选的类型）" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.PortOrIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}" MinWidth="280"
                                         ToolTip="管道：两端填同一个管道名，例如 ncm1（写成 \\.\pipe\ncm1 也认）&#10;共享内存：两端填同一个共享区名，但两端的「通道名」不能一样&#10;共享文件夹：填一个根目录就行，软件自己往 out\ 写、从 in\ 读；填网络共享路径就能跨电脑&#10;本机文件：填文件完整路径（只写相对路径时，按软件运行目录去找）&#10;Web：填完整网址，例如 http://127.0.0.1:8080/api/io"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='管道'}">
                            <StackPanel>
                                <TextBlock Text="管道角色" Style="{StaticResource AppleChipLabel}"/>
                                <ListBox ItemsSource="{Binding PipeRoleOptions}" SelectedItem="{Binding SelectedItem.PipeRole}" Style="{StaticResource ApplePillList}"
                                         ToolTip="先启动的那一端选「服务端」（在本机等别人连），后连的那一端选「客户端」（主动去连）。两端选成一样肯定连不上。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='共享内存'}">
                            <StackPanel>
                                <TextBlock Text="共享区大小(KB)" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SelectedItem.ShmSizeKb}" Style="{StaticResource AppleNumField}"
                                         ToolTip="这块共享区能存多少字节（默认 64KB）。两端要填成一样；一条消息比它大就发不出去。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='本机文件'}">
                            <StackPanel>
                                <TextBlock Text="写入方式" Style="{StaticResource AppleChipLabel}"/>
                                <ListBox ItemsSource="{Binding FileWriteModeOptions}" SelectedItem="{Binding SelectedItem.FileWriteMode}" Style="{StaticResource ApplePillList}"
                                         ToolTip="「覆盖」= 每次发送把整个文件重写一遍；「追加」= 接在文件末尾继续写。接收只有在这个文件被外面的程序改动之后，才返回一次新内容。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='Web'}">
                            <StackPanel>
                                <TextBlock Text="请求方式" Style="{StaticResource AppleChipLabel}"/>
                                <ListBox ItemsSource="{Binding WebMethodOptions}" SelectedItem="{Binding SelectedItem.WebMethod}" Style="{StaticResource ApplePillList}"
                                         ToolTip="POST / PUT = 把发送框里的内容当正文发过去；GET = 不带正文（发送框里有内容时，会拼到网址后面变成 ?data=…）。【接收】固定发一次 GET，把对方回的内容显示出来。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='Web'}">
                            <StackPanel>
                                <TextBlock Text="Content-Type" Style="{StaticResource AppleChipLabel}"/>
                                <ComboBox ItemsSource="{Binding WebContentTypeOptions}" MinWidth="200" HorizontalAlignment="Left"
                                          SelectedItem="{Binding SelectedItem.WebContentType}"
                                          ToolTip="发出去的内容算哪种格式。发 JSON 选 application/json，发普通文字选 text/plain。"/>
                            </StackPanel>
                        </Border>
                        <!-- ↑↑↑ 本机互联 / 接口类通道参数 -->
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="数据位" Style="{StaticResource AppleChipLabel}"/>
                                <ComboBox ItemsSource="{Binding DataBitsOptions}" MinWidth="90" HorizontalAlignment="Left"
                                          SelectedValue="{Binding SelectedItem.DataBits, TargetNullValue=8}" SelectedValuePath="."/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="一个字节里有几位数据，一般设 8；要和对端一致"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="校验位" Style="{StaticResource AppleChipLabel}"/>
                                <ComboBox ItemsSource="{Binding ParityOptions}" MinWidth="90" HorizontalAlignment="Left"
                                          SelectedValue="{Binding SelectedItem.Parity}" SelectedValuePath="."/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="怎么检查传输出错，最常见选「无」；要和对端一致，不一致会收不到正确内容"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="停止位" Style="{StaticResource AppleChipLabel}"/>
                                <ComboBox ItemsSource="{Binding StopBitsOptions}" MinWidth="90" HorizontalAlignment="Left"
                                          SelectedValue="{Binding SelectedItem.StopBits}" SelectedValuePath="."/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="一帧结束的标志，一般 1；要和对端一致"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='串口|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="流控" Style="{StaticResource AppleChipLabel}"/>
                                <ListBox ItemsSource="{Binding FlowControlOptions}" SelectedItem="{Binding FlowControl}" Style="{StaticResource ApplePillList}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="来不及处理时让对方先别发。没接握手线就选「无」"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='ModbusTCP|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="从站地址" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding SlaveAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="这台设备在 Modbus 上的编号；一根线上挂了好几台时，每台都要不一样"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='ModbusTCP|ModbusRTU'}">
                            <StackPanel>
                                <TextBlock Text="字节序" Style="{StaticResource AppleChipLabel}"/>
                                <ListBox ItemsSource="{Binding EndianOptions}" SelectedItem="{Binding Endian}" Style="{StaticResource ApplePillList}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="设备把两个字节的前后顺序怎么排。读上来的数莫名其妙时，换一种排法试试"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='西门子S7'}">
                            <StackPanel>
                                <TextBlock Text="机架 Rack" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding Rack}" Style="{StaticResource AppleNumField}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='西门子S7'}">
                            <StackPanel>
                                <TextBlock Text="槽位 Slot" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding Slot}" Style="{StaticResource AppleNumField}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}" Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='三菱MC'}">
                            <StackPanel>
                                <TextBlock Text="网络号" Style="{StaticResource AppleChipLabel}"/>
                                <TextBox Text="{Binding NetworkNo}" Style="{StaticResource AppleNumField}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <StackPanel>
                                <TextBlock Text="超时" Style="{StaticResource AppleChipLabel}" ToolTip="等多长时间没回应就算这次失败（毫秒）。设备反应慢就把它调大一点"/>
                                <DockPanel LastChildFill="False">
                                    <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.TimeoutMs}" Style="{StaticResource AppleNumField}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <StackPanel>
                                <TextBlock Text="重试次数" Style="{StaticResource AppleChipLabel}" ToolTip="失败以后自动再试几次；填 0 = 试一次就算了"/>
                                <DockPanel LastChildFill="False">
                                    <TextBox DockPanel.Dock="Right" Text="{Binding RetryCount}" Style="{StaticResource AppleNumField}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="次" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <StackPanel>
                                <TextBlock Text="轮询间隔" Style="{StaticResource AppleChipLabel}" ToolTip="自动反复读的时候，两次之间隔多少毫秒"/>
                                <DockPanel LastChildFill="False">
                                    <TextBox DockPanel.Dock="Right" Text="{Binding PollIntervalMs}" Style="{StaticResource AppleNumField}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="自动重连" Style="{StaticResource AppleLabel}" ToolTip="断线后软件自己再连一次，不用你手动点"/>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding AutoReconnect}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="详细日志" Style="{StaticResource AppleLabel}" ToolTip="把每一次收发的内容都记进日志；排查问题时打开，平时可以关掉少刷屏"/>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding VerboseLog}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource AppleChip}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="保活心跳" Style="{StaticResource AppleLabel}" ToolTip="定时发一小段内容，防止链路被悄悄断开（有些交换机几分钟不发消息就会断）"/>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding KeepAlive}"/>
                            </DockPanel>
                        </Border>
                    </WrapPanel>

                    <!-- SECS/HSMS 参数（仅 SECS(HSMS) 类型显示）-->
                    <Border Style="{StaticResource AppleGroupCard}" Padding="12,10"
                            Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='SECS(HSMS)'}">
                        <StackPanel>
                            <TextBlock Text="SECS / HSMS 参数（半导体设备用的那套通讯）" Style="{StaticResource AppleSectionHeader}"/>
                            <WrapPanel Margin="0,0,0,4">
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="HSMS 角色" Style="{StaticResource AppleChipLabel}"/>
                                        <ListBox ItemsSource="{Binding SecsRoleOptions}" SelectedItem="{Binding SelectedItem.SecsRole}" Style="{StaticResource ApplePillList}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="DeviceID" Style="{StaticResource AppleChipLabel}"/>
                                        <TextBox Text="{Binding SelectedItem.SecsDeviceId}" Style="{StaticResource AppleNumField}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="T3 数据应答" Style="{StaticResource AppleChipLabel}"/>
                                        <DockPanel LastChildFill="False">
                                            <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.SecsT3Ms}" Style="{StaticResource AppleNumField}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="T5 重连间隔" Style="{StaticResource AppleChipLabel}"/>
                                        <DockPanel LastChildFill="False">
                                            <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.SecsT5Ms}" Style="{StaticResource AppleNumField}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="T6 控制应答" Style="{StaticResource AppleChipLabel}"/>
                                        <DockPanel LastChildFill="False">
                                            <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.SecsT6Ms}" Style="{StaticResource AppleNumField}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="T7 未选中容忍" Style="{StaticResource AppleChipLabel}"/>
                                        <DockPanel LastChildFill="False">
                                            <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.SecsT7Ms}" Style="{StaticResource AppleNumField}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="T8 字符间超时" Style="{StaticResource AppleChipLabel}"/>
                                        <DockPanel LastChildFill="False">
                                            <TextBox DockPanel.Dock="Right" Text="{Binding SelectedItem.SecsT8Ms}" Style="{StaticResource AppleNumField}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="机型 MDLN" Style="{StaticResource AppleChipLabel}"/>
                                        <TextBox Text="{Binding SelectedItem.SecsMdln, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <StackPanel>
                                        <TextBlock Text="版本 SOFTREV" Style="{StaticResource AppleChipLabel}"/>
                                        <TextBox Text="{Binding SelectedItem.SecsSoftRev, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextField}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AppleChip}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="自动应答 S1F1/F13" Style="{StaticResource AppleLabel}"/>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.SecsAutoReply}"/>
                                    </DockPanel>
                                </Border>
                            </WrapPanel>

                            <DockPanel LastChildFill="False" Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="会话状态" Style="{StaticResource AppleLabel}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SecsStateText}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="SML 预设" Style="{StaticResource AppleLabel}" Margin="0,0,10,0"/>
                                <Button DockPanel.Dock="Right" Content="载入" Style="{StaticResource AppleBtnSecondary}" Margin="8,0,0,0"
                                        Command="{Binding ApplySecsPresetCommand}"/>
                                <ComboBox ItemsSource="{Binding SecsPresets}"
                                          SelectedItem="{Binding SelectedSecsPreset, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                          Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center" Padding="6"
                                          ToolTip="这里列了常用的 SECS 报文。点【载入】填进发送框，改完再发。"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============ 仿真对端：每种通讯类型一套独立的仿真设置（参数随通讯项落盘）============ -->
                    <Border Style="{StaticResource AppleGroupCard}" Padding="12,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="仿真对端" Style="{StaticResource AppleSectionHeader}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SimStateText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SimEndpointText}" FontSize="12" TextWrapping="Wrap" Margin="12,0,12,6"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <WrapPanel Margin="12,0,12,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                                    <TextBlock Text="启用仿真" Style="{StaticResource AppleLabel}" Margin="0,0,6,0"/>
                                    <CheckBox Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.SimEnabled}"
                                              ToolTip="打开 = 这条通讯不碰真硬件，由软件自己假扮「对方」。&#10;能在本机真起一个对方的类型（管道 / 共享内存 / 共享文件夹 / 本机文件 / 网口TCP / UDP / ModbusTCP / Web / SECS）：你这一端照常走真实通道，只是对面换成了软件自带的模拟器。&#10;本机开不出另一端的类型（串口 / ModbusRTU / GPIB / 西门子S7 / 三菱MC）：改成由软件直接顶替这条通道，你发什么它立刻回什么，一个硬件都不碰。"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                                    <TextBlock Text="应答模式" Style="{StaticResource AppleLabel}" Margin="0,0,6,0"/>
                                    <ListBox ItemsSource="{Binding SimModeOptions}" SelectedItem="{Binding SelectedItem.SimMode}"
                                             Style="{StaticResource ApplePillList}"
                                             ToolTip="回显 = 你发什么它就回什么；按规则 = 照下面的规则表回；静默 = 只把收到的记下来，不回话。"/>
                                </StackPanel>
                                <Button Content="启动仿真" Style="{StaticResource AppleBtnSecondary}" Margin="0,0,6,6"
                                        Command="{Binding StartSimCommand}"
                                        ToolTip="按上面填的配置把「对方」启动起来。启动失败会在下面的记录里写清楚是为什么。"/>
                                <Button Content="停止仿真" Style="{StaticResource AppleBtnSecondary}" Margin="0,0,6,6"
                                        Command="{Binding StopSimCommand}"
                                        ToolTip="把「对方」关掉，这条通道换回连真设备。"/>
                            </WrapPanel>

                            <TextBlock Text="应答规则（一行一条，写成 条件=&gt;怎么回；条件前面加 * = 只要收到的内容里包含它就命中；条件留空 = 前面都不匹配时才用这条；应答里写 {msg} = 把收到的原文原样回给你）"
                                       Style="{StaticResource AppleLabel}" FontSize="11.5" Margin="12,0,12,2"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Margin="12,0,12,8" MinHeight="56" MaxHeight="120" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12" FontFamily="Consolas"
                                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding SelectedItem.SimRules, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="举个例子：&#10;启动=&gt;已收到　（收到「启动」就回「已收到」）&#10;*温度=&gt;25.6　（只要收到的里面带「温度」两个字，就回 25.6）&#10;=&gt;OK　（前面都对不上时，统一回 OK）"/>

                            <DockPanel Margin="12,0,12,8" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="注入给本端" Style="{StaticResource AppleBtnSecondary}" Margin="8,0,0,0"
                                        Command="{Binding InjectSimCommand}"
                                        ToolTip="点【注入】= 假装「对方」主动给你发了一条：本端下一次点【接收】拿到的就是这段内容。&#10;Modbus 从站要按 地址=值 来写：40001=123（保持寄存器）、00001=1（线圈）、30001=7（输入寄存器）。"/>
                                <TextBox Text="{Binding SimInjectText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DockPanel>

                            <DockPanel Margin="12,0,12,2" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="仿真收发记录" Style="{StaticResource AppleLabel}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource AppleBtnSecondary}"
                                        Command="{Binding ClearSimLogCommand}"/>
                            </DockPanel>
                            <ListBox Margin="12,0,12,6" Height="120" ItemsSource="{Binding SimLog}" FontSize="11.5" FontFamily="Consolas"
                                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="{Binding SimNoteText}" FontSize="11.5" TextWrapping="Wrap" Margin="12,0,12,2"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 调试操作 -->
                    <Border Style="{StaticResource AppleGroupCard}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="调试操作" Style="{StaticResource AppleSectionHeader}"/>

                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="连接状态" Style="{StaticResource AppleLabel}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding PingResult, StringFormat='延迟 {0}'}" Margin="10,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource AppleBtn}" Command="{Binding TestConnectionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SignalIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="测试连接" VerticalAlignment="Center" ToolTip="先试连一下，看通不通、顺便量一下延迟"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtn}" Command="{Binding OpenCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource LinkIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="打开连接" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtnSecondary}" Command="{Binding CloseCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource StopIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="关闭连接" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtnSecondary}" Command="{Binding RecvCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SignalIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="接收" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtnSecondary}" Command="{Binding AutoScanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SearchIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="自动扫描端口" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtnSecondary}" Command="{Binding SecsSelectCommand}"
                                        Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='SECS(HSMS)'}"
                                        ToolTip="主动发一条「建立会话」的消息，把链路握上手（选「被动」时这一步由对方做，不用点）。">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource LinkIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="建立会话" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AppleBtnSecondary}" Command="{Binding SecsLinktestCommand}"
                                        Visibility="{Binding SelectedItem.CommType, Converter={StaticResource TypeVisible}, ConverterParameter='SECS(HSMS)'}"
                                        ToolTip="发一条心跳问一句「你还在吗」，确认链路没有断。">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SignalIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="探活" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TtDeleteBtn}" Command="{Binding ClearLogCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource EraserIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="清空日志" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="命令预设" Style="{StaticResource AppleLabel}" Margin="0,0,10,0"/>
                                <Button DockPanel.Dock="Right" Content="应用预设" Style="{StaticResource AppleBtnSecondary}" Margin="8,0,0,0" Command="{Binding ApplyPresetCommand}"/>
                                <ComboBox ItemsSource="{Binding CommandPresets}"
                                          SelectedItem="{Binding SelectedPreset, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                          Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center" Padding="6"
                                          ToolTip="挑一个常用的指令模板，点【应用预设】填进发送框，改完再发。"/>
                            </DockPanel>

                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="发送" Style="{StaticResource AppleLabel}" Margin="0,0,10,0"/>
                                <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource AppleBtn}" Margin="8,0,0,0" Command="{Binding SendCommand}"/>
                                <TextBox Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="1"
                                         BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}"
                                         VerticalAlignment="Center" Padding="8,6" FontSize="13"/>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding DebugLog}" Height="110" Style="{StaticResource AppleTerminal}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
