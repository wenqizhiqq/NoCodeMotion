<UserControl x:Class="NoCodeMotion.Views.AxisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:beh="clr-namespace:NoCodeMotion.Behaviors"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <local:EditorPage EmptyHint="还没有轴，请点击左上角的「添加」按钮新增一条轴。">
        <local:EditorPage.Detail>
            <DockPanel LastChildFill="True" Background="{StaticResource CanvasBrush}">
                <!-- 页标题 -->
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource PageHeaderPanel}">
                    <Path Style="{StaticResource PageHeaderIcon}" Data="{StaticResource AxisIcon}"/>
                    <TextBlock Style="{StaticResource PageHeaderTitle}" Text="轴"/>
                </StackPanel>
                <!-- 连接后真实检测到的轴数量（来自底层硬件） -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,6" Padding="8,6" Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                    <DockPanel>
                        <Path Data="{StaticResource AxisIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                            <Run Text="已连接控制卡真实检测到的轴数量："/>
                            <Run Text="{Binding DetectedAxisCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <Run Text="（连接后自动获取，来自底层硬件；0 表示尚未连接或卡未上报）"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

            <!-- 「-」命名约定提示（与新建工程弹窗一致） -->
            <local:PageHintBar DockPanel.Dock="Bottom"
                               OperationText="命名建议写成「工位-对象」，例如 上料-轴1 / 搬运-轴2 / 下料-轴3。"
                               PrecautionText="名称里第一个「-」之前的文字会成为下拉框的分组前缀：同类名称超过 20 个时，下拉框自动折叠成「一级分类 → 右侧二级菜单」的级联。改名后请确认没有流程 / 点位仍在引用旧名。"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- 4 列紧凑容器：WrapPanel 保证每张卡只有自身内容那么高（不拉齐高度，避免大片空白） -->
                    <WrapPanel Orientation="Horizontal" Margin="12,0,12,8" ItemWidth="240">
                        <!-- ============ 基本信息 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="基本信息"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="名称"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="轴类型"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource AppleReadOnlyValue}" Text="{Binding SelectedItem.AxisType, Mode=OneWay}" ToolTip="只读：轴类型跟着所属控制器的「总线类型」走。要改请到「控制器」页改该控制器的总线类型（该卡的轴会一起换类型）。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="轴号"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.AxisNo}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="单位"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.Unit}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="mm"/>
                                        <ComboBoxItem Content="°"/>
                                        <ComboBoxItem Content="脉冲"/>
                                        <ComboBoxItem Content="um"/>
                                        <ComboBoxItem Content="自定义"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="控制器"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource AppleReadOnlyValue}" Text="{Binding SelectedItem.Controller, Mode=OneWay}" ToolTip="只读：轴的归属在「控制器」页决定 —— 连接控制器 / 生成轴点位时按本卡轴数建轴并绑定；本页新增的轴默认归到第一个控制器。"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 运动参数 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="运动参数"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="脉冲当量"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.PulsePerUnit}"
                                             ToolTip="脉冲当量：走 1 个单位要发多少个脉冲（pulse/unit），按机械实际算 = 每转脉冲数 ÷ 丝杠导程。&#10;★ 填 0 会被卡拒绝运动指令（Jog / 设零点报错误码），默认 1000（0.001 单位/脉冲）。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="起始速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.StartVel}"
                                             ToolTip="起始速度（单位/秒）：梯形曲线的起跳速度，默认 100。填 0 等于让轴从静止硬起步，步进机容易失步。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="运行速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.Speed}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="停止速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.StopVel}"
                                             ToolTip="停止速度（单位/秒）：减速段的收尾速度，默认与起始速度一致（100），厂商示例同口径。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="加速时间"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.Accel}"
                                             ToolTip="加速时间（秒）：从起始速度加速到额定速度所需的时间，不是加速度值。常用 0.1~0.5 秒。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="减速时间"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.Decel}"
                                             ToolTip="减速时间（秒）：从额定速度减速到停止所需的时间，不是减速度值。常用 0.1~0.5 秒。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="加加速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.Jerk}"
                                             ToolTip="加加速度：S 曲线的平滑量。「速度类型 = 梯形」时 0 才是准确值；要用 S 型才填大于 0。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="速度类型"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.SpeedCurve}" SelectedValuePath="Content" ToolTip="梯形（T 型）或 S 型加减速；对应卡层的速度类型参数">
                                        <ComboBoxItem Content="梯形"/>
                                        <ComboBoxItem Content="S型"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="S段"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.SPara}" ToolTip="S 段时间（单位：秒，范围 0~0.5）：仅「速度类型 = S型」时生效；梯形下保持 0。"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 回零参数 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="回零参数"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="回零方式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.HomeMode}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="原点开关+限位"/>
                                        <ComboBoxItem Content="仅正限位"/>
                                        <ComboBoxItem Content="仅负限位"/>
                                        <ComboBoxItem Content="编码器Z相"/>
                                        <ComboBoxItem Content="当前位置设零"/>
                                        <ComboBoxItem Content="负向限位回零"/>
                                        <ComboBoxItem Content="正向限位回零"/>
                                        <ComboBoxItem Content="索引回零"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="回零方向"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.HomeDir}" SelectedValuePath="Content" ToolTip="回零时先朝哪个方向找原点 / 限位">
                                        <ComboBoxItem Content="负向"/>
                                        <ComboBoxItem Content="正向"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="回零速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.HomeSpeed}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="爬行速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.CreepSpeed}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="原点偏移"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.HomeOffset}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="回零超时(ms)"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.HomeTimeoutMs}" ToolTip="0 = 不判断回零超时"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 限位与保护 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="限位与保护"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="软限位使能"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.SoftLimitEnable}" ToolTip="开启后软正 / 负限位值才会下发到卡并生效"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="软正限位"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.PosLimitPlus}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="软负限位"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.PosLimitMinus}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="限位电平"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.LimitLevel}" SelectedValuePath="Content" ToolTip="正 / 负限位信号的有效电平">
                                        <ComboBoxItem Content="低电平"/>
                                        <ComboBoxItem Content="高电平"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="到位误差"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.InPosError}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 电平与编码器 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="电平与编码器"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="使能电平"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.EnableLevel}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="高电平"/>
                                        <ComboBoxItem Content="低电平"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="方向电平"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.DirLevel}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="正向"/>
                                        <ComboBoxItem Content="负向"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="报警电平"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.AlarmLevel}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="高电平"/>
                                        <ComboBoxItem Content="低电平"/>
                                        <ComboBoxItem Content="无"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="报警使能"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.AlarmEnable}" ToolTip="开启后伺服报警信号才会被卡识别并停轴"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="原点电平"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.OriginLevel}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="低电平"/>
                                        <ComboBoxItem Content="高电平"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="原点停止模式"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.OriginStopMode}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="减速停止"/>
                                        <ComboBoxItem Content="急停"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="编码器类型"/>
                                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource CellComboStyle}" MinWidth="0" SelectedValue="{Binding SelectedItem.EncoderType}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="无"/>
                                        <ComboBoxItem Content="增量式"/>
                                        <ComboBoxItem Content="绝对式"/>
                                    </ComboBox>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="编码器分辨率"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.EncoderRes}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="编码器使能"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.EncoderEnable}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="编码器误差"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.EncoderDeviation}" ToolTip="指令位置 − 编码器位置 超过该值应报警"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="急停减速"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}" MinWidth="0" Text="{Binding SelectedItem.EStopDecel}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 轴权限 ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴权限"
                                           ToolTip="只门控「轴控制」里的手动按钮；流程 / 点位 / Lua 的运行指令不受影响。"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="允许手动操作"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.AllowManual}" ToolTip="关闭后「轴控制」里的 点动 / Jog / 停止 按钮变灰"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="允许回零"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.AllowHome}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="允许设零点"/>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedItem.AllowSetZero}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 轴状态（只读，针对左侧当前选中的轴） ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴状态"
                                           ToolTip="状态全部来自底层真实读数（位置=指令位置，编码器=反馈位置）；读不到的项显示「—」，不编造。"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="选中轴"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Monitor.Name}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="控制器"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Monitor.ControllerText}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="连接"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" Text="{Binding Monitor.StatusText}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="正极限"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.PelText}" Foreground="{Binding Monitor.PelColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="负极限"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.MelText}" Foreground="{Binding Monitor.MelColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="原点"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.OrgText}" Foreground="{Binding Monitor.OrgColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="急停"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.EmgText}" Foreground="{Binding Monitor.EmgColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="报警"
                                               ToolTip="有轴状态字的卡族：取状态字 bit0。没有状态字的卡族读不到，显示「—」，请改看下面「报警码」。"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.AlarmText}" Foreground="{Binding Monitor.AlarmColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="报警码"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center" FontFamily="Consolas"
                                               Text="{Binding Monitor.AlarmCodeText}" Foreground="{Binding Monitor.AlarmCodeColor}"
                                               ToolTip="底层 GetCardAxisAlarmState 的原始返回值，原样显示不翻译（各卡族语义不同：有的是报警状态 0/1，有的是错误码）。非 0 时若轴不动，请按卡手册清报警。"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="使能"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.EnabledText}" Foreground="{Binding Monitor.EnabledColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="运动中"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.MovingText}" Foreground="{Binding Monitor.MovingColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="位置"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Monitor.PosText}" Foreground="{Binding Monitor.PosColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="编码器"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center"
                                               Text="{Binding Monitor.EncText}" Foreground="{Binding Monitor.PosColor}"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="状态字"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"
                                               Text="{Binding Monitor.IoWordText}" Foreground="{StaticResource TextMutedBrush}"
                                               ToolTip="{Binding IoWordHint}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ 轴控制（针对左侧当前选中的轴，真实下发） ============ -->
                        <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,8,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴控制"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="点动距离"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"                                             Text="{Binding Monitor.JogStep, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="点动 / Jog 每步距离（单位同该轴「单位」）"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="手动速度"/>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"                                             Text="{Binding Monitor.ManualSpeed, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="点动 / Jog 的速度；自动运行与点位移动仍按该轴「运行速度」"/>
                                </DockPanel>
                                <Rectangle Style="{StaticResource AppleHairline}"/>
                                <DockPanel Style="{StaticResource AppleRow}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="轴权限"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" Text="{Binding Monitor.PermissionText}"/>
                                </DockPanel>

                                <StackPanel Margin="10,8,10,12">
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button Content="使能" Style="{StaticResource TtPillBlueBtn}" Margin="0,0,3,0"
                                                Command="{Binding Monitor.EnableCommand}" ToolTip="给该轴使能（上伺服）。未使能的轴收下指令也不会动。"/>
                                        <Button Content="不使能" Style="{StaticResource TtPillGrayBtn}" Margin="3,0,0,0"
                                                Command="{Binding Monitor.DisableCommand}" ToolTip="撤销该轴使能（下伺服）。总线轴走卡层「轴失能」；脉冲卡由驱动器侧断使能信号，可能不生效。"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="1" Margin="0,0,0,6">
                                        <Button Content="停止" Style="{StaticResource TtPillRedBtn}"
                                                Command="{Binding Monitor.StopCommand}" ToolTip="减速停止该轴（Jog 也用它停）"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button Content="点动 −" Style="{StaticResource TtPillOrangeBtn}" Margin="0,0,3,0"
                                                Command="{Binding Monitor.InchMinusCommand}" ToolTip="按「点动距离」反向走一步"/>
                                        <Button Content="点动 +" Style="{StaticResource TtPillBlueBtn}" Margin="3,0,0,0"
                                                Command="{Binding Monitor.InchPlusCommand}" ToolTip="按「点动距离」正向走一步"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <Button Content="Jog −" Style="{StaticResource TtPillOrangeBtn}" Margin="0,0,3,0"
                                                beh:JogHoldBehavior.StartCommand="{Binding Monitor.JogMinusStartCommand}"
                                                beh:JogHoldBehavior.StopCommand="{Binding Monitor.JogStopCommand}"
                                                ToolTip="按住不放才连续反向运动，松开即停。只点一下只会走一瞬 —— 要按「点动距离」走一步请用「点动 −」。"/>
                                        <Button Content="Jog +" Style="{StaticResource TtPillBlueBtn}" Margin="3,0,0,0"
                                                beh:JogHoldBehavior.StartCommand="{Binding Monitor.JogPlusStartCommand}"
                                                beh:JogHoldBehavior.StopCommand="{Binding Monitor.JogStopCommand}"
                                                ToolTip="按住不放才连续正向运动，松开即停。只点一下只会走一瞬 —— 要按「点动距离」走一步请用「点动 +」。"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <Button Content="回零" Style="{StaticResource TtPillGrayBtn}" Margin="0,0,3,0"
                                                Command="{Binding Monitor.HomeCommand}" ToolTip="按该轴回零参数执行回零（后台执行，完成/超时后提示）"/>
                                        <Button Content="设零点" Style="{StaticResource TtPillGreenBtn}" Margin="3,0,0,0"
                                                Command="{Binding Monitor.SetZeroCommand}" ToolTip="把该轴当前指令位置置为 0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </DockPanel>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
