<Window x:Class="NoCodeMotion.Views.UserManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoCodeMotion.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <StackPanel MinWidth="380" MaxWidth="520">
            <Border Padding="22,18,22,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource OperatorIcon}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="用户管理" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="UserList" Margin="18,14,18,6" Height="220"
                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                     Background="{StaticResource CanvasBrush}"
                     SelectionChanged="UserList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2" CornerRadius="10"
                                    Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 角色设置 + 操作 -->
            <DockPanel Margin="18,4,18,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="角色" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="RoleCombo" DockPanel.Dock="Left" Margin="0,0,8,0" Width="110"
                          SelectedIndex="1" SelectionChanged="RoleCombo_SelectionChanged">
                    <ComboBoxItem Content="管理员"/>
                    <ComboBoxItem Content="操作员"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddButton" Content="新增" Style="{StaticResource TtPillBlueBtn}" Click="AddButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RenameButton" Content="重命名" Style="{StaticResource TtPillBlueBtn}" Click="RenameButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource TtPillRedBtn}" Click="DeleteButton_Click"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="Hint" Margin="18,2,18,4" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="至少保留 1 个用户，且不能删除当前登录用户。"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,16">
                <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource TtBaseBtn}" Click="CloseButton_Click" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
