<UserControl x:Class="NoCodeMotion.Views.CameraPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">

    <!--
        相机页 = EditorPage 宿主：
            左侧列表 240px：增/删/重命名由 EditorPage 默认接管（AddCommand/DeleteCommand/RenameCommand）。
            右侧 Detail：本页自定义的属性编辑卡 + 拍照预览占位。
    -->
    <local:EditorPage>
        <local:EditorPage.Detail>
            <Grid Background="{StaticResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态条 -->
                <Border Grid.Row="0" Margin="14,12,14,8" Padding="10,8"
                        Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- 主体两列：左 属性卡 / 右 拍照预览 -->
                <Grid Grid.Row="1" Margin="14,4,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ 左：属性编辑卡（Apple 风格分组） ============ -->
                    <Border Grid.Column="0" Style="{StaticResource AppleGroupCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="相机参数"/>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="名称"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="品牌"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.Vendor, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="IP 地址"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="端口"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.Port, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="分辨率"/>
                                <Grid DockPanel.Dock="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource AppleTextField}"
                                             Text="{Binding SelectedItem.Width, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding HasSelection}"/>
                                    <TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}"
                                             Text="{Binding SelectedItem.Height, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding HasSelection}"/>
                                </Grid>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="曝光 (ms)"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.ExposureMs, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="增益"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.Gain, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleHairline}"/>

                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" Text="备注"/>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource AppleTextField}"
                                         Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasSelection}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============ 右：拍照预览 / 控制 ============ -->
                    <Border Grid.Column="1" Style="{StaticResource AppleGroupCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 顶部小标题 + 连接状态 -->
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Path Data="{StaticResource CameraIcon}" Width="14" Height="14"
                                          Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="相机预览" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="10"
                                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentDarkBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未连接"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="已连接"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                                        <Setter Property="Text" Value="未选择"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DockPanel>

                            <!-- 预览区（占位：SDK 未接入前显示黑底+提示） -->
                            <Border Grid.Row="1" Margin="0,12,0,12" CornerRadius="10"
                                    Background="#1D1D1F" SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- 中心十字 + 提示文字（SDK 接入后可整体替换为 Image 控件） -->
                                    <Path Width="40" Height="40" Stretch="Uniform"
                                          Stroke="#3F3F46" StrokeThickness="1.5"
                                          Data="M2 2L18 18M18 2L2 18"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="2" ScaleY="2"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="相机预览" Foreground="#71717A" FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="接入相机 SDK 后此处显示实时画面"
                                                   Foreground="#52525B" FontSize="11" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 底部控制：连接 / 拍照 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TtBaseBtn}" Margin="0,0,8,0"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding HasSelection}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PowerIcon}" Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="连接 / 断开" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TtWarnBtn}"
                                        Command="{Binding CaptureCommand}"
                                        IsEnabled="{Binding HasSelection}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource CameraIcon}" Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        <TextBlock Text="拍照" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </local:EditorPage.Detail>
    </local:EditorPage>
</UserControl>
