<UserControl x:Class="NoCodeMotion.Views.OperatorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             xmlns:md="clr-namespace:NoCodeMotion.Models"
             xmlns:vm="clr-namespace:NoCodeMotion.ViewModels"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="980">

    <UserControl.Resources>
        <!-- 异常日志：等级彩色圆点 -->
        <Style x:Key="LogDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Warn}">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Error}">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 异常日志：等级文字标签 -->
        <Style x:Key="LogTagStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="信息"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Warn}">
                    <Setter Property="Text" Value="警告"/>
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Error}">
                    <Setter Property="Text" Value="异常"/>
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 异常日志：正文按等级着色 -->
        <Style x:Key="LogMsgStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Warn}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static md:LogLevel.Error}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- KPI 卡片标题 -->
        <Style x:Key="KpiTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- 模式按钮：非激活态为灰色，激活态高亮为蓝色 -->
        <Style x:Key="ModeManualBtnStyle" TargetType="Button" BasedOn="{StaticResource TtGrayBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:OpMode.Manual}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeAutoBtnStyle" TargetType="Button" BasedOn="{StaticResource TtGrayBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:OpMode.Auto}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 时序偏差监控：状态圆点着色 -->
        <Style x:Key="TimingDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.Normal}">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.Deviation}">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.OverThreshold}">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 时序偏差监控：状态文字着色 -->
        <Style x:Key="TimingStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.Normal}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.Deviation}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TimingStatus.OverThreshold}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3D 仿真：运行态状态圆点（运行时绿色，空闲灰色） -->
        <Style x:Key="SimRunDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3D 仿真：运行态文字（运行时"仿真运行中"，空闲"待机"） -->
        <Style x:Key="SimStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="待机"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Text" Value="仿真运行中"/>
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

        <!-- 操作员页布局：左右各占一半。右列=运行轨迹 3D 仿真（占满整高）；左列上=生产数据/控制/趋势，下(左下角)=时序偏差监控+异常日志。整页无外部滚动条。 -->
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：标题 + 用户切换 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}" Margin="16,16,16,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="{StaticResource OperatorIcon}" Width="20" Height="20" Stretch="Uniform"
                          Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="操作员控制台" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="当前用户" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding CurrentUser, Mode=TwoWay}"
                              Style="{StaticResource CellComboStyle}" MinWidth="120"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体：自适应 2 列 -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：上=生产数据/控制/趋势，下(左下角)=时序偏差监控+异常日志 -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 左列上半：生产数据 + 控制 + 趋势 -->
                <StackPanel Grid.Row="0">

                    <!-- 生产数据 KPI -->
                    <TextBlock Text="生产数据" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,8"/>
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" MinWidth="150" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="累计产量" Style="{StaticResource KpiTitle}"/>
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="件" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" MinWidth="150" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="良率" Style="{StaticResource KpiTitle}"/>
                                <TextBlock Text="{Binding Yield, StringFormat={}{0:F1}%}" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="目标 ≥ 98%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" MinWidth="150" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="节拍" Style="{StaticResource KpiTitle}"/>
                                <TextBlock Text="{Binding CycleTime, StringFormat={}{0:F1}s}" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="秒 / 件" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" MinWidth="150" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="运行时长" Style="{StaticResource KpiTitle}"/>
                                <TextBlock Text="{Binding RunElapsedText}" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="mm:ss" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- 控制按钮 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,8"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Command="{Binding RunCommand}" Style="{StaticResource TtBaseBtn}" Content="{Binding RunButtonText}" ToolTip="启动运行（自动模式连续运行 / 手动模式单步）；运行中暂停后变「继续」。" IsEnabled="{Binding CanStart}"/>
                                <Button Command="{Binding PauseCommand}" Style="{StaticResource TtGrayBtn}" Content="暂停" ToolTip="暂停运行（运动到位后挂起，点「继续」恢复）。" Margin="8,0,0,0" IsEnabled="{Binding CanPause}"/>
                                <Button Command="{Binding StopCommand}" Style="{StaticResource TtGrayBtn}" Content="停止" ToolTip="停止运行。" Margin="8,0,0,0" IsEnabled="{Binding CanStop}"/>
                                <Button Command="{Binding ManualCommand}" Style="{StaticResource ModeManualBtnStyle}" Content="手动" ToolTip="手动模式：每按一次启动前进一个点位。" Margin="8,0,0,0"/>
                                <Button Command="{Binding AutoCommand}" Style="{StaticResource ModeAutoBtnStyle}" Content="自动" ToolTip="自动模式：连续顺序运行。" Margin="8,0,0,0"/>
                                <Button Command="{Binding EStopCommand}" Style="{StaticResource TtDeleteBtn}" Content="急停" ToolTip="紧急切断所有运动。" Margin="8,0,0,0" IsEnabled="{Binding CanEStop}"/>
                                <Button Command="{Binding ResetCommand}" Style="{StaticResource TtWarnBtn}" Content="复位" ToolTip="复位产量/图表并解除急停。" Margin="8,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 折线图 -->
                    <TextBlock Text="生产趋势（良率% / 节拍s）" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,8"/>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas Width="640" Height="220" Background="{StaticResource SurfaceBrush}">
                                <!-- 网格基线 -->
                                <Line X1="30" Y1="190" X2="630" Y2="190" Stroke="{StaticResource LineBrush}" StrokeThickness="1"/>
                                <Line X1="30" Y1="30" X2="630" Y2="30" Stroke="{StaticResource LineBrush}" StrokeThickness="1" StrokeDashArray="3 3"/>
                                <!-- Y 轴刻度 -->
                                <TextBlock Canvas.Left="4" Canvas.Top="26" Text="100%" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Canvas.Left="14" Canvas.Top="186" Text="0" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <!-- 折线 -->
                                <Polyline Points="{Binding YieldPoints}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.5" Fill="Transparent"/>
                                <Polyline Points="{Binding CyclePoints}" Stroke="{StaticResource WarningBrush}" StrokeThickness="2.5" Fill="Transparent"/>
                            </Canvas>
                    </Viewbox>
                            <!-- 图例 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Rectangle Width="14" Height="4" Fill="{StaticResource SuccessBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="良率 %" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <Rectangle Width="14" Height="4" Fill="{StaticResource WarningBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="节拍 s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 左列下半(左下角)：时序偏差监控 + 异常日志 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                <!-- 时序偏差监控 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="时序偏差监控：实际触发时刻与预期时序标记比对，偏差 ≤ ±2ms 正常，≤ ±5ms 偏差，超出报警并写入异常日志；未配置标记显示「未配置」。"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding TimingRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="Transparent" RowHeight="28" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="步骤" Binding="{Binding Step}" Width="56"/>
                                <DataGridTextColumn Header="点位" Binding="{Binding PointName}" Width="120"/>
                                <DataGridTextColumn Header="预期" Binding="{Binding ExpectedText}" Width="90"/>
                                <DataGridTextColumn Header="实际" Binding="{Binding ActualText}" Width="90"/>
                                <DataGridTextColumn Header="偏差" Binding="{Binding DeviationText}" Width="90"/>
                                <DataGridTemplateColumn Header="状态" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Style="{StaticResource TimingDotStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TimingStatusTextStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 异常日志 -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="异常日志" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Ellipse Grid.Column="1" Style="{StaticResource LogDotStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource LogTagStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource LogMsgStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>

            <!-- 右列(占一半)：运行轨迹 3D 仿真，占满整列高度 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="8,0,0,0">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource SimRunDot}" Margin="0,0,8,0"/>
                            <TextBlock Text="3D 运行仿真" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource SimStatusTextStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <local:Sim3DView Points="{Binding OpSimPoints}"
                                     Head="{Binding OpSimHead}"
                                     HeadVisible="{Binding OpSimHeadVisible}"
                                     CurrentIndex="{Binding OpSimIndex}"/>
                </DockPanel>
            </Border>
        </Grid>
        <local:PageHintBar Grid.Row="2" OperationText="点「启动」并发运行全部流程（复位流程除外）；用「停止 / 急停 / 复位」控制；运行状态由定时器刷新。" PrecautionText="急停会切断所有输出；运行前确认现场安全；流程异常需先修正再重新启动。"/>
    </Grid>
</UserControl>