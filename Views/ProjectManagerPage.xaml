<UserControl x:Class="NoCodeMotion.Views.ProjectManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <!--
        项目管理页：左侧工程列表 + 右侧详情（工程信息 / 备注 / 需求 / AI 往返）。
        两条 AI 路线：
          ① JSON 往返：填备注与需求 →【复制需求】→ 粘贴到 AI → AI 返回 JSON →【粘贴生成】→ 自动生成配置与流程。
          ② 文件往返：【复制路径与说明】→ AI 直接改这个 xlsx → 软件检测到文件变化后弹窗问「载入文件 / 还原文件 / 稍后」。
    -->
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：新建 / 打开 / 保存 / 删除 / 重命名 / 刷新 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="新建" VerticalAlignment="Center" ToolTip="建一个新工程：先挑模板（示例机台 / 空白），再起个名字"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="打开" VerticalAlignment="Center" ToolTip="打开列表里选中的工程；也可以直接双击它"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SaveIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="保存" VerticalAlignment="Center" ToolTip="立刻把当前配置写进文件（平时改完会自动存，一般不用点它）"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}" Style="{StaticResource TtDeleteBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource DeleteIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="删除" VerticalAlignment="Center" ToolTip="删掉选中的那个工程文件（删了就找不回来了）"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenameCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RenameIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="重命名" VerticalAlignment="Center" ToolTip="给当前工程换个名字"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RefreshIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center" ToolTip="重新看一遍工程文件夹（在外面新建或删过文件之后用）"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Projects.Count, StringFormat=共 {0} 个工程}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding CurrentProject, StringFormat=当前：{0}}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 左列表 + 右详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：工程列表 ============ -->
            <Border Grid.Column="0" Style="{StaticResource DetailPanelStyle}" Margin="12,12,6,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="工程列表" Style="{StaticResource AppleSectionHeader}"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             Style="{StaticResource ProjectListStyle}"
                             MouseDoubleClick="ProjectList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,6">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat=修改：yyyy-MM-dd HH:mm}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ============ 右：详情（备注 / 需求 / AI 生成） ============ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,12,12,12">
                <StackPanel IsEnabled="{Binding CanEditDetail}">

                    <!-- 备注 -->
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="备注"/>
                            <TextBox Margin="12,4,12,10" MinHeight="60" MaxHeight="120"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding DetailRemark, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- AI 直接改工程文件（文件级往返）：复制路径与说明 → agent 改 xlsx → 软件弹窗确认载入/还原 -->
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="让 AI 直接改配置文件（不用在软件里一项项点）"/>
                            <TextBlock Margin="12,2,12,8" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="第一步：双击左边列表里的工程，把它设成「当前工程」（软件只盯着这一个文件）；&#10;第二步：点【复制路径与说明】，把整段话原样贴给 AI 或 agent —— 里面已经写好这个表格怎么读、哪些地方不能乱改；&#10;第三步：让 AI 直接改这个文件并保存。软件发现文件变了会弹窗问你三件事：&#10;　【载入文件】= 用文件里改好的新配置刷新软件；&#10;　【还原文件】= 不认外面的改动，用软件里现在的配置把文件盖回去；&#10;　【稍后】= 两边都不动，文件再变一次还会再问你；&#10;第四步：这期间别在软件里改配置 —— 软件一改动就自动写进文件，会把 AI 刚改的东西盖掉。"/>
                            <Border Margin="12,0,12,8" Padding="8,6" CornerRadius="6" Background="{StaticResource HoverBrush}">
                                <TextBlock Text="{Binding SelectedFilePath}" FontSize="11.5" FontFamily="Consolas"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                                           ToolTip="要交给 AI 去改的就是这个文件；路径也可以自己选中复制"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="12,0,12,12">
                                <Button Content="复制路径与说明" Style="{StaticResource TtBaseBtn}" MinWidth="130"
                                        Command="{Binding CopyPathCommand}"
                                        ToolTip="复制出去的是一整段「给 AI 的话」：文件在哪、这个表格每列是什么意思、哪些地方不能乱改"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Text="AI 改完存盘就行，不用回软件点保存 —— 软件会自己发现。"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 操作结果（两条 AI 往返路线共用这一条状态） -->
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="操作结果"/>
                            <Border Margin="12,0,12,12" Padding="10,8" CornerRadius="6"
                                    Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="{Binding StatusMessage, TargetNullValue=—}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>