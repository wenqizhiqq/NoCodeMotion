<UserControl x:Class="NoCodeMotion.Views.Sim3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="420">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 3D 视口：裁剪到控件边界，避免几何体画出卡片外 -->
        <Viewport3D Grid.Row="0" Name="Vp" ClipToBounds="True">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Cam" FieldOfView="50"
                                   Position="150,100,150" LookDirection="-150,-100,-150" UpDirection="0,1,0"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#E8E8E8"/>
                        <DirectionalLight Color="#FFFFFF" Direction="-0.4,-1,-0.6"/>
                        <DirectionalLight Color="#B8C4D0" Direction="0.5,-0.4,0.6"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="Root"/>
        </Viewport3D>

        <!-- 智能跟随工具条：自动对准运动轴 / 复位视角 / 打开 STP -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsHitTestVisible="True">
            <CheckBox x:Name="ChkFollow" Content="智能跟随" IsChecked="True" Margin="0,0,8,0"
                      Foreground="#334155" FontSize="11" VerticalAlignment="Center"
                      Checked="ChkFollow_Changed" Unchecked="ChkFollow_Changed"/>
            <Button x:Name="BtnResetView" Content="复位视角" Style="{StaticResource TtPillBlueBtn}"
                    FontSize="11" MinWidth="0" Padding="10,3" Margin="0,0,6,0" Click="BtnResetView_Click"/>
            <Button x:Name="BtnOpenStp" Content="打开STP" Style="{StaticResource TtPillBlueBtn}"
                    FontSize="11" MinWidth="0" Padding="10,3" Margin="0,0,6,0" Click="BtnOpenStp_Click"/>
            <Button x:Name="BtnImportDwg" Content="导入DWG/DXF" Style="{StaticResource TtPillBlueBtn}"
                    FontSize="11" MinWidth="0" Padding="10,3" Margin="0,0,6,0" Click="BtnImportDwg_Click"/>
            <Button x:Name="BtnClearStp" Content="清除" Style="{StaticResource TtPillGrayBtn}"
                    FontSize="11" MinWidth="0" Padding="10,3" Click="BtnClearStp_Click"/>
        </StackPanel>

        <!-- STP 加载状态（打开/解析/三角面数/失败原因） -->
        <TextBlock x:Name="TxtStpStatus" Text="" FontSize="10.5" Foreground="#0F172A"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,22"
                   TextWrapping="Wrap" MaxWidth="320" IsHitTestVisible="False"/>

        <TextBlock x:Name="EmptyHint" Text="该工位暂无点位，无法仿真"
                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock Text="拖拽旋转 · 滚轮缩放 · 可导入 DWG/DXF 显示平面图"
                   FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="6" IsHitTestVisible="False"/>

        <!-- 相机抓拍预览：流程走到「相机」步骤时由 OperatorViewModel 写入 CaptureImage -->
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="4" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="相机抓拍" FontSize="10" Foreground="#475569" Margin="0,0,0,2"/>
                <Image Source="{Binding CaptureImage, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:Sim3DView}}"
                       Width="120" Height="90" Stretch="Uniform"/>
            </StackPanel>
        </Border>

        <!-- 紧凑图例：图标 + 文字，标注参数化机台各部件（由轴配置自动生成） -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="2,6,2,2">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="龙门/导轨" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="滑座/主轴" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#0EA5E9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="旋转转台" FontSize="10.5" Foreground="#0369A1" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#1E293B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="相机" FontSize="10.5" Foreground="#334155" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#9CA3B0" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="气缸" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="工件" FontSize="10.5" Foreground="#1D4ED8" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="3" RadiusX="1" RadiusY="1" Fill="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="轨迹" FontSize="10.5" Foreground="#2563EB" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#60A5FA" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="点位" FontSize="10.5" Foreground="#2563EB" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,3" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="当前位置" FontSize="10.5" Foreground="#DC2626" VerticalAlignment="Center"/>
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
