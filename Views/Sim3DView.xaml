<UserControl x:Class="NoCodeMotion.Views.Sim3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NoCodeMotion.Views"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="420">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 3D 视口：裁剪到控件边界，避免几何体画出卡片外 -->
        <Viewport3D Grid.Row="0" Name="Vp" ClipToBounds="True">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Cam" FieldOfView="50"
                                   Position="150,100,150" LookDirection="-150,-100,-150" UpDirection="0,1,0"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#CCCCCC"/>
                        <DirectionalLight Color="#FFFFFF" Direction="-0.4,-1,-0.6"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="Root"/>
        </Viewport3D>

        <TextBlock x:Name="EmptyHint" Text="该工位暂无点位，无法仿真"
                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock Text="拖拽旋转 · 滚轮缩放"
                   FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="6" IsHitTestVisible="False"/>

        <!-- 紧凑图例：图标 + 文字，标注机台各部件 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="2,6,2,2">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#475569" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="基台" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="龙门架" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#EAB308" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="X轴电机" FontSize="10.5" Foreground="#B45309" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F97316" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Y轴电机" FontSize="10.5" Foreground="#C2410C" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#14B8A6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Z轴电机" FontSize="10.5" Foreground="#0F766E" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#8B5CF6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="工具头" FontSize="10.5" Foreground="#6D28D9" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#EC4899" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="感应器" FontSize="10.5" Foreground="#BE185D" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Rectangle Width="10" Height="3" RadiusX="1" RadiusY="1" Fill="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="轨迹" FontSize="10.5" Foreground="#2563EB" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#60A5FA" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="点位" FontSize="10.5" Foreground="#2563EB" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,3" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="当前位置" FontSize="10.5" Foreground="#DC2626" VerticalAlignment="Center"/>
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
