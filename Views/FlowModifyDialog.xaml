<Window x:Class="NoCodeMotion.Views.FlowModifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- 透明窗口 + 圆角白卡 + 柔和阴影 = Apple 风修改弹窗（名称 + 主流程/复位流程） -->
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <StackPanel MinWidth="360" MaxWidth="480">
            <Border Padding="22,18,22,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource RenameIcon}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DockPanel LastChildFill="True" Margin="24,18,24,8">
                <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="NameBox" VerticalContentAlignment="Center" FontSize="14" Padding="8,6"
                         BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </DockPanel>
            <StackPanel Margin="24,0,24,8">
                <TextBlock Text="流程类型（单选）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <RadioButton x:Name="MainRadio" Content="主流程" GroupName="RoleGroup" FontSize="13" Margin="0,2,0,6"/>
                        <RadioButton x:Name="ResetRadio" Content="复位流程" GroupName="RoleGroup" FontSize="13" Margin="0,2,0,2"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource TtGrayBtn}" Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource TtBaseBtn}" Margin="8,0,0,0" Click="ConfirmButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
