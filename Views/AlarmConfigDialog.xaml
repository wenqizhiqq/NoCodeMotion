<Window x:Class="NoCodeMotion.Views.AlarmConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:NoCodeMotion.Views"
        mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="420"
        Title="报警 / 信号塔 / OEE 配置" Height="460" Width="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="报警 / 信号塔 / OEE 配置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="信号塔（三色灯）输出" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="绿灯（运行）" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="GreenCombo" SelectedItem="{Binding GreenOutput, Mode=TwoWay}" Style="{StaticResource CellComboStyle}" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="黄灯（暂停）" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="YellowCombo" SelectedItem="{Binding YellowOutput, Mode=TwoWay}" Style="{StaticResource CellComboStyle}" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="红灯（报警/急停）" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RedCombo" SelectedItem="{Binding RedOutput, Mode=TwoWay}" Style="{StaticResource CellComboStyle}" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="蜂鸣器" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="BuzzerCombo" SelectedItem="{Binding BuzzerOutput, Mode=TwoWay}" Style="{StaticResource CellComboStyle}" Margin="0,3"/>
                </Grid>
                <TextBlock Text="输出名与 IO 表一致；留空表示该灯/蜂鸣器不接。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,10"/>

                <TextBlock Text="蜂鸣器参数" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="响 ms" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BuzzerOnMs, Mode=TwoWay}" Style="{StaticResource AppleTextField}" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="间隔 ms" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BuzzerOffMs, Mode=TwoWay}" Style="{StaticResource AppleTextField}" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="次数" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BuzzerRepeat, Mode=TwoWay}" Style="{StaticResource AppleTextField}" Margin="0,3"/>
                </Grid>

                <TextBlock Text="OEE 目标" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="目标节拍 秒" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetCycleSec, Mode=TwoWay}" Style="{StaticResource AppleTextField}" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="良率目标 %" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YieldTargetPct, Mode=TwoWay}" Style="{StaticResource AppleTextField}" Margin="0,3"/>
                </Grid>

                <TextBlock Text="安全位" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/>
                <CheckBox Content="急停后自动回安全位（跑复位流程）" IsChecked="{Binding AutoSafeOnEStop, Mode=TwoWay}" Margin="0,3"/>
                <CheckBox Content="流程异常后自动回安全位（跑复位流程）" IsChecked="{Binding AutoSafeOnException, Mode=TwoWay}" Margin="0,3"/>
                <TextBlock Text="需在流程页新增「复位流程」（Role=复位）才会真正执行。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Style="{StaticResource TtBaseBtn}" Width="90" Click="SaveButton_Click"/>
            <Button Content="取消" Style="{StaticResource TtGrayBtn}" Width="90" Margin="8,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
