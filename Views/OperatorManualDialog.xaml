<Window x:Class="NoCodeMotion.Views.OperatorManualDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoCodeMotion.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Width="720" Height="720" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- 透明窗口 + 圆角白卡 + 柔和阴影 = Apple 风格使用说明书（多角色，复用 OperatorManualPage） -->
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（仅关闭按钮；角色切换在页面顶部） -->
            <Border Grid.Row="0" Padding="20,16,16,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Path Data="{StaticResource InfoIcon}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="使用说明书" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource TtGrayBtn}" Width="32" Height="32" Padding="0" Click="CloseButton_Click" IsCancel="True" ToolTip="关闭"/>
                </DockPanel>
            </Border>

            <!-- 正文：复用多角色说明书页 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,8">
                <local:OperatorManualPage Margin="6"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
